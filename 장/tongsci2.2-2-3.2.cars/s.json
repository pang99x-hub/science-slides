{"id":"tongsci2.2-2-3.2.cars","unit":"tongsci2.2-2-3","html":"<!-- 5. 해 보기 · 자동차의 에너지 효율 -->\n<section id=\"tongsci2-2-2-3-2-cars\" data-state=\"cars\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 112쪽 해 보기 · 자동차의 에너지 효율</div>\n        <h2 data-edit=\"h2\">가솔린 차와 전기 차</h2>\n      </div>\n      <div class=\"car-pred\">\n        <p data-edit=\"p\">바퀴를 굴리는 데 에너지를 더 많이 쓰는 차는?</p>\n        <div class=\"share-opts\" role=\"group\" aria-label=\"예측\">\n          <button type=\"button\" id=\"cp-gas\" data-k=\"gas\" aria-pressed=\"false\">가솔린 자동차</button>\n          <button type=\"button\" id=\"cp-ev\" data-k=\"ev\" aria-pressed=\"false\">전기 자동차</button>\n          <button type=\"button\" id=\"cp-same\" data-k=\"same\" aria-pressed=\"false\">같다</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"car-body\" data-prevent-swipe>\n      <div class=\"car-col\" data-car=\"gas\">\n        <div class=\"car-head\"><b>가솔린 자동차</b><span class=\"car-eff\">효율 <em>?</em></span><span class=\"car-hint\">진단기를 끌어 부품에 대 보자</span></div>\n        <svg class=\"car-svg\" viewBox=\"0 0 780 200\" aria-hidden=\"true\">\n          <rect class=\"cr-road\" x=\"0\" y=\"172\" width=\"780\" height=\"28\"/><g class=\"cr-dash\"><path d=\"M0 186 h 40 M 90 186 h 40 M 180 186 h 40 M 270 186 h 40 M 360 186 h 40 M 450 186 h 40 M 540 186 h 40 M 630 186 h 40 M 720 186 h 40 M 810 186 h 40\"/></g>\n          <g class=\"cr-car\">\n            <g class=\"part\" data-p=\"exh\"><path class=\"cr-pipe\" d=\"M150 150 H 110\"/><g class=\"cr-smoke\"><circle cx=\"96\" cy=\"146\" r=\"9\"/><circle cx=\"76\" cy=\"138\" r=\"12\"/><circle cx=\"52\" cy=\"128\" r=\"15\"/></g></g>\n            <path class=\"cr-body\" d=\"M140 156 V 112 a 14 14 0 0 1 14 -14 h 96 l 56 -50 h 160 l 76 50 h 86 a 18 18 0 0 1 18 18 v 40 z\"/>\n            <path class=\"cr-win\" d=\"M318 58 h 70 v 40 h -114 z M 400 58 h 52 l 56 40 h -108 z\"/>\n            <g class=\"part\" data-p=\"tank\"><rect class=\"cr-tank\" x=\"170\" y=\"118\" width=\"80\" height=\"26\" rx=\"6\"/><text class=\"cr-pt\" x=\"210\" y=\"137\">연료</text></g>\n            <g class=\"part\" data-p=\"engine\"><rect class=\"cr-eng\" x=\"560\" y=\"104\" width=\"90\" height=\"44\" rx=\"6\"/><text class=\"cr-pt\" x=\"605\" y=\"132\">엔진</text></g>\n            <g class=\"part\" data-p=\"cool\"><rect class=\"cr-rad\" x=\"666\" y=\"104\" width=\"22\" height=\"44\" rx=\"3\"/><path class=\"cr-radl\" d=\"M670 112 h 14 M 670 122 h 14 M 670 132 h 14 M 670 142 h 14\"/></g>\n            <g class=\"part\" data-p=\"fric\"><g class=\"cr-spark\"><path d=\"M226 186 l -18 -8 M 230 190 l -22 2 M 556 186 l -18 -8 M 560 190 l -22 2\"/></g></g>\n            <g class=\"cr-wheel\" data-c=\"250 158\"><circle cx=\"250\" cy=\"158\" r=\"30\" class=\"cr-tire\"/><circle cx=\"250\" cy=\"158\" r=\"13\" class=\"cr-rim\"/><path d=\"M250 132 v 52 M 224 158 h 52\" class=\"cr-spoke\"/></g>\n            <g class=\"cr-wheel\" data-c=\"580 158\"><circle cx=\"580\" cy=\"158\" r=\"30\" class=\"cr-tire\"/><circle cx=\"580\" cy=\"158\" r=\"13\" class=\"cr-rim\"/><path d=\"M580 132 v 52 M 554 158 h 52\" class=\"cr-spoke\"/></g>\n            <g class=\"part hitw\" data-p=\"wheels\"><rect x=\"214\" y=\"122\" width=\"72\" height=\"72\" rx=\"36\" fill=\"transparent\"/><rect x=\"544\" y=\"122\" width=\"72\" height=\"72\" rx=\"36\" fill=\"transparent\"/></g>\n            <g class=\"part\" data-p=\"wheel\"><path class=\"cr-go\" d=\"M720 60 h 46 M 730 80 h 40 M 720 100 h 46\"/></g>\n          </g>\n          <g class=\"cr-call\"><rect x=\"0\" y=\"0\" width=\"10\" height=\"34\" rx=\"17\"/><text x=\"5\" y=\"23\">.</text></g>\n        </svg>\n        <svg class=\"wf-svg\" viewBox=\"0 0 780 420\" role=\"img\" aria-label=\"가솔린 자동차에 공급한 화학 에너지 100 %에서 엔진 열 68 %, 엔진 냉각 4 %, 마찰 3 %를 빼면 바퀴의 동력 25 %\"></svg>\n      </div>\n      <div class=\"car-col\" data-car=\"ev\">\n        <div class=\"car-head\"><b>전기 자동차</b><span class=\"car-eff\">효율 <em>?</em><small class=\"car-note\"></small></span><button class=\"btn\" type=\"button\" id=\"ev-regen\" aria-pressed=\"true\">회생 제동 켜짐</button><span class=\"car-hint\">진단기를 끌어 부품에 대 보자</span></div>\n        <svg class=\"car-svg\" viewBox=\"0 0 780 200\" aria-hidden=\"true\">\n          <rect class=\"cr-road\" x=\"0\" y=\"172\" width=\"780\" height=\"28\"/><g class=\"cr-dash\"><path d=\"M0 186 h 40 M 90 186 h 40 M 180 186 h 40 M 270 186 h 40 M 360 186 h 40 M 450 186 h 40 M 540 186 h 40 M 630 186 h 40 M 720 186 h 40 M 810 186 h 40\"/></g>\n          <g class=\"part\" data-p=\"charge\"><rect class=\"cr-stn\" x=\"14\" y=\"40\" width=\"54\" height=\"132\" rx=\"8\"/><path class=\"cr-bolt2\" d=\"M44 62 l -12 22 h 10 l -6 20 l 18 -26 h -10 l 8 -16 z\"/><path class=\"cr-cable\" d=\"M68 120 C 110 120, 120 150, 150 140\"/></g>\n          <g class=\"cr-car\">\n            <path class=\"cr-body ev\" d=\"M140 156 V 112 a 14 14 0 0 1 14 -14 h 96 l 56 -50 h 160 l 76 50 h 86 a 18 18 0 0 1 18 18 v 40 z\"/>\n            <path class=\"cr-win\" d=\"M318 58 h 70 v 40 h -114 z M 400 58 h 52 l 56 40 h -108 z\"/>\n            <g class=\"part\" data-p=\"batt\"><rect class=\"cr-batt\" x=\"270\" y=\"134\" width=\"270\" height=\"20\" rx=\"5\"/><text class=\"cr-pt light\" x=\"405\" y=\"149\">전지</text></g>\n            <g class=\"part\" data-p=\"motor\"><rect class=\"cr-mot\" x=\"560\" y=\"108\" width=\"70\" height=\"40\" rx=\"10\"/><text class=\"cr-pt\" x=\"595\" y=\"133\">모터</text></g>\n            <g class=\"part\" data-p=\"cool\"><rect class=\"cr-rad\" x=\"666\" y=\"104\" width=\"22\" height=\"44\" rx=\"3\"/><path class=\"cr-radl\" d=\"M670 112 h 14 M 670 122 h 14 M 670 132 h 14 M 670 142 h 14\"/></g>\n            <g class=\"part\" data-p=\"aux\"><circle class=\"cr-lamp\" cx=\"720\" cy=\"112\" r=\"9\"/><path class=\"cr-beam\" d=\"M732 106 l 40 -10 M 732 116 l 44 4\"/></g>\n            <g class=\"cr-wheel\" data-c=\"250 158\"><circle cx=\"250\" cy=\"158\" r=\"30\" class=\"cr-tire\"/><circle cx=\"250\" cy=\"158\" r=\"13\" class=\"cr-rim\"/><path d=\"M250 132 v 52 M 224 158 h 52\" class=\"cr-spoke\"/></g>\n            <g class=\"cr-wheel\" data-c=\"580 158\"><circle cx=\"580\" cy=\"158\" r=\"30\" class=\"cr-tire\"/><circle cx=\"580\" cy=\"158\" r=\"13\" class=\"cr-rim\"/><path d=\"M580 132 v 52 M 554 158 h 52\" class=\"cr-spoke\"/></g>\n            <g class=\"part hitw\" data-p=\"wheels\"><rect x=\"214\" y=\"122\" width=\"72\" height=\"72\" rx=\"36\" fill=\"transparent\"/><rect x=\"544\" y=\"122\" width=\"72\" height=\"72\" rx=\"36\" fill=\"transparent\"/></g>\n            <g class=\"part\" data-p=\"regen\"><path class=\"cr-regen\" d=\"M250 118 C 300 96, 340 120, 340 140 M 580 118 C 530 96, 480 120, 480 140\"/></g>\n            <g class=\"part\" data-p=\"wheel\"><path class=\"cr-go\" d=\"M720 60 h 46 M 730 80 h 40 M 720 100 h 46\"/></g>\n          </g>\n          <g class=\"cr-call\"><rect x=\"0\" y=\"0\" width=\"10\" height=\"34\" rx=\"17\"/><text x=\"5\" y=\"23\">.</text></g>\n        </svg>\n        <svg class=\"wf-svg\" viewBox=\"0 0 780 420\" role=\"img\" aria-label=\"전기 자동차에 공급한 전기 에너지 100 %에서 충전 손실 10 %, 구동 손실 18 %, 냉각 손실 3 %, 보조 부품 4 %를 빼고 회생 제동으로 22 %를 되찾아 바퀴의 동력 87 %\"></svg>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 112쪽 해 보기</b><span>값은 교과서 해 보기 1·2의 예시</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-2-3.2.cars */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const NS = 'http://www.w3.org/2000/svg';\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const J = (...p) => window.RxT.join(...p);\n  const dock = (root, cfg) => window.UDock.mount(root, cfg);\n  const stopKeys = (i) => i.addEventListener('keydown', (e) => e.stopPropagation());   // ←→로 장이 넘어가지 않게\n\n  // 1. 표지: 켜 둔 시간을 늘리면 열화상 속 세 기구가 달아오른다\n  part('tongsci2-2-2-3-2-cars', (root) => J(window.CarEfficiency.mount(root), dock(root, {\n    steps: ['차 예측하기', '진단기 대기', '회생 제동 끄고 켜기'],\n    on: ['#cp-gas, #cp-ev, #cp-same', '.cr-probe, .cr-pt, [data-p]', '#ev-regen'],\n    learn: '가솔린 자동차는 <b>25 %</b>, 전기 자동차는 <b>87 %</b>. 모터는 열 손실이 적고 회생 제동으로 에너지를 되찾는다.',\n  })));\n})();\n","needs":["cars"],"media":{}}