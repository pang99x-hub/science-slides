{"id":"tongsci2.2-2-3.3.regen","unit":"tongsci2.2-2-3","html":"<!-- 2. 효율 높이기 ① 회생 제동 -->\n<section id=\"tongsci2-2-2-3-3-regen\" data-state=\"regen\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 113쪽 그림 Ⅱ-29 · 효율 높이기 ①</div>\n        <h2 data-edit=\"h2\">브레이크를 밟을 때 에너지를 되찾는다</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">가속하고, 멈춰 보자</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"stage rg-stage\" data-prevent-swipe>\n        <svg class=\"rg-svg\" viewBox=\"0 0 1056 652\" role=\"img\" aria-label=\"전기 자동차가 감속할 때 바퀴의 운동 에너지를 모터로 전기 에너지로 바꿔 전지에 저장하는 회생 제동과, 마찰로 열이 되는 일반 브레이크를 비교하는 그림\">\n          <defs><linearGradient id=\"rg-skyg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#8ec5ea\"/><stop offset=\"1\" stop-color=\"#e2f1f8\"/></linearGradient></defs>\n          <rect width=\"1056\" height=\"520\" fill=\"url(#rg-skyg)\"/>\n          <g class=\"rg-far\"><path d=\"M-40 420 Q 120 330 280 400 T 600 390 T 920 380 T 1240 400 V 520 H -40 Z\"/></g>\n          <g class=\"rg-near\"></g>\n          <rect class=\"rg-road\" y=\"520\" width=\"1056\" height=\"132\"/>\n          <g class=\"rg-dash\"></g>\n          <!-- 자동차 -->\n          <g class=\"rg-car\">\n            <path class=\"rg-body\" d=\"M230 500 V 436 a 22 22 0 0 1 22 -22 h 150 l 88 -78 h 250 l 118 78 h 130 a 28 28 0 0 1 28 28 v 58 z\"/>\n            <path class=\"rg-win\" d=\"M500 350 h 110 v 62 h -178 z M 624 350 h 82 l 88 62 h -170 z\"/>\n            <rect class=\"rg-batt\" x=\"420\" y=\"470\" width=\"300\" height=\"26\" rx=\"6\"/><text class=\"rg-pt\" x=\"570\" y=\"489\">전지</text>\n            <rect class=\"rg-mot\" x=\"790\" y=\"440\" width=\"70\" height=\"44\" rx=\"10\"/><text class=\"rg-pt\" x=\"825\" y=\"467\">모터</text>\n            <path class=\"rg-flow\" d=\"M842 520 C 842 500, 830 486, 820 484 M 790 470 C 760 470, 740 484, 722 484\"/>\n            <g class=\"rg-wheel\" data-c=\"380 520\"><circle class=\"rg-tire\" cx=\"380\" cy=\"520\" r=\"54\"/><circle class=\"rg-disc\" cx=\"380\" cy=\"520\" r=\"30\"/><path class=\"rg-spoke\" d=\"M380 474 v 92 M 334 520 h 92\"/></g>\n            <g class=\"rg-wheel\" data-c=\"842 520\"><circle class=\"rg-tire\" cx=\"842\" cy=\"520\" r=\"54\"/><circle class=\"rg-disc\" cx=\"842\" cy=\"520\" r=\"30\"/><path class=\"rg-spoke\" d=\"M842 474 v 92 M 796 520 h 92\"/></g>\n            <g class=\"rg-heat\"><path d=\"M360 450 c -10 -14 10 -22 0 -36 s 10 -22 0 -36\"/><path d=\"M400 450 c -10 -14 10 -22 0 -36 s 10 -22 0 -36\"/><path d=\"M822 450 c -10 -14 10 -22 0 -36 s 10 -22 0 -36\"/><path d=\"M862 450 c -10 -14 10 -22 0 -36 s 10 -22 0 -36\"/></g>\n          </g>\n          <!-- 계기판 -->\n          <g class=\"rg-speed\" transform=\"translate(30 24)\"><rect width=\"250\" height=\"150\" rx=\"14\"/><path class=\"rg-arc\" d=\"M40 120 A 85 85 0 0 1 210 120\"/><line class=\"rg-needle\" x1=\"125\" y1=\"120\" x2=\"125\" y2=\"48\"/><circle cx=\"125\" cy=\"120\" r=\"8\" class=\"rg-pv\"/><text class=\"rg-mt\" x=\"125\" y=\"144\">속도</text></g>\n          <g class=\"rg-bat\" transform=\"translate(776 24)\"><rect width=\"250\" height=\"150\" rx=\"14\"/><rect class=\"rg-bo\" x=\"34\" y=\"34\" width=\"168\" height=\"62\" rx=\"10\"/><rect class=\"rg-bn\" x=\"202\" y=\"52\" width=\"12\" height=\"26\" rx=\"3\"/><rect class=\"rg-bf\" x=\"40\" y=\"40\" width=\"156\" height=\"50\" rx=\"6\"/><text class=\"rg-bt\" x=\"118\" y=\"76\">60%</text><text class=\"rg-mt\" x=\"125\" y=\"130\">전지</text></g>\n          <g class=\"rg-say\"><rect x=\"330\" y=\"30\" width=\"400\" height=\"56\" rx=\"28\"/><text x=\"530\" y=\"66\">가속하거나 브레이크를 눌러 보자</text></g>\n        </svg>\n        <div class=\"tools\"><div class=\"seg seg2 small\" role=\"group\" aria-label=\"브레이크 방식\"><button type=\"button\" id=\"rg-normal\" aria-pressed=\"false\">일반 브레이크</button><button type=\"button\" id=\"rg-regen\" aria-pressed=\"true\">회생 제동</button></div></div>\n        <div class=\"rg-pedals\"><button class=\"btn rg-gas\" type=\"button\" id=\"rg-gas\">가속 ▶ (누르고 있기)</button><button class=\"btn rg-brk\" type=\"button\" id=\"rg-brake\">■ 브레이크 (누르고 있기)</button><button class=\"btn\" type=\"button\" id=\"rg-stop\">신호등 앞에서 멈추기</button></div>\n      </div>\n      <div class=\"panel rg-panel\">\n        <div class=\"fig-q\">\n          <p data-edit=\"p\">브레이크를 밟아 느려질 때, 줄어든 <b>운동 에너지</b>는 어디로 갈까?</p>\n          <div class=\"share-opts rg-share\" role=\"group\" aria-label=\"예측\">\n            <button type=\"button\" id=\"rp-gone\" data-k=\"gone\" aria-pressed=\"false\">그냥 사라진다</button>\n            <button type=\"button\" id=\"rp-heat\" data-k=\"heat\" aria-pressed=\"false\">마찰열로 바뀐다</button>\n            <button type=\"button\" id=\"rp-batt\" data-k=\"batt\" aria-pressed=\"false\">전기로 모을 수 있다</button>\n          </div>\n        </div>\n        <div class=\"rg-bars\">\n          <div class=\"bl-legend\"><span>멈출 때까지 모인 에너지(비교)</span><button class=\"btn small-btn\" type=\"button\" id=\"rg-reset\">비우기</button></div>\n          <div class=\"rg-row\"><span>열로 버림</span><b><i class=\"rg-h\"></i></b></div>\n          <div class=\"rg-row\"><span>전지로 되찾음</span><b><i class=\"rg-r\"></i></b></div>\n        </div>\n        <ol class=\"sp-steps\">\n          <li data-edit=\"fragment-1\" class=\"fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\"><b>일반 브레이크</b>: 마찰로 운동 에너지가 <b>열</b>이 되어 버려진다.</li>\n          <li data-edit=\"fragment-2\" class=\"fragment custom\" data-anim=\"mrow\" data-fragment-index=\"1\"><b>회생 제동</b>: 모터가 발전기처럼 돌며 운동 에너지 → <b>전기 에너지</b> → 전지에 저장.</li>\n          <li data-edit=\"fragment-3\" class=\"fragment custom\" data-anim=\"mrow\" data-fragment-index=\"2\">되찾은 전기로 다시 달린다 → 전기·하이브리드 자동차는 <b>에너지 효율</b>이 높다.</li>\n        </ol>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 113쪽</b><span>전기·하이브리드 자동차는 느려질 때 운동 에너지를 전기로 바꿔 모은다</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-2-3.3.regen */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (...p) => window.RxT.join(...p);\n  const dock = (root, cfg) => window.UDock.mount(root, cfg);\n  const pick = (sel) => (root) => { const rows = [...root.querySelectorAll(sel)]; root.querySelector('.gv').addEventListener('gv-pick', (e) => rows.forEach((x) => x.classList.toggle('on', x.dataset.k === e.detail.b.dataset.row))); return window.RxT.gallery(root); };\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));\n  const mix = (a, b, f) => { const A = hex(a), B = hex(b); return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * f)).join(',')})`; };\n\n  // 1. 표지: 시간이 흐르면 화석 연료가 줄고 이산화 탄소가 쌓인다. 신재생 에너지로 바꾸면 천천히 준다(정성적 그림)\n  part('tongsci2-2-2-3-3-regen', (root) => J(window.RegenBrake.mount(root), dock(root, {\n    steps: ['가속하기', '브레이크로 멈추기', '일반 브레이크와 견주기'],\n    on: ['#rg-gas', '#rg-brake, #rg-stop', '#rg-normal'],\n    learn: '회생 제동은 느려질 때 <b>운동 에너지 → 전기 에너지</b>로 바꿔 전지에 모은다. 일반 브레이크는 열로 버린다.',\n  })));\n})();\n","needs":["regen"],"media":{}}