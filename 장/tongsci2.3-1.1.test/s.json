{"id":"tongsci2.3-1.1.test","unit":"tongsci2.3-1","html":"<!-- 3. 이론: 두 가지 진단 검사(Manim + 먼저 보고 놀라기) -->\n<section id=\"tongsci2-3-1-1-test\" data-state=\"test\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 130쪽 · 132~133쪽 · 단백질과 핵산으로 진단하기</div>\n        <h2 data-edit=\"h2\">단백질로 찾기, 핵산으로 찾기</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">빠른 검사와 정확한 검사</p>\n      <button type=\"button\" class=\"pk-open\" aria-expanded=\"false\">▶ 실제 영상</button>\n    </div>\n    <div class=\"t-body t-theo t-thm t-test\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def tt-def ag\"><span data-edit=\"t-tag-1\" class=\"t-tag\">신속 항원 검사</span><p data-edit=\"p-1\">바이러스 <b>단백질</b>(항원)을 <b>항원-항체 반응</b>으로 찾는다</p><p data-edit=\"t-sub-1\" class=\"t-sub\">면역 진단 · 집에서도 <b>간편하고 빠르다</b> · 병원체가 적으면 놓칠 수 있다</p></div>\n        <div class=\"tcard th-def tt-def pcr\"><span data-edit=\"t-tag-2\" class=\"t-tag\">PCR 검사</span><p data-edit=\"p-2\">바이러스 <b>핵산</b>을 여러 번 <b>복제(증폭)</b>해 찾는다</p><p data-edit=\"t-sub-2\" class=\"t-sub\">분자 진단 · 아주 적어도 <b>정확</b> · <b>시간</b>이 더 든다</p></div>\n        <div class=\"tcard th-def tt-def abd\"><span data-edit=\"t-tag-3\" class=\"t-tag\">항체</span><p data-edit=\"p-3\">몸이 만드는 단백질. 짝이 맞는 <b>항원</b>에만 달라붙는다</p></div>\n      </div>\n      <div class=\"st-fig\" data-prevent-swipe>\n        <div class=\"st-stage\">\n          <button type=\"button\" class=\"btn st-again\">다시 보기</button>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@TS1@@\" src=\"@@TS1_V@@\" aria-label=\"검사 띠의 검체 넣는 곳에서 바이러스 알갱이들이 흘러가 T 줄의 항체에 붙잡히고 T 줄과 C 줄이 붉어진다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@TS2@@\" src=\"@@TS2_V@@\" aria-label=\"바이러스 알갱이가 하나뿐이라 T 줄이 거의 보이지 않고 C 줄만 뚜렷하다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@TS3@@\" src=\"@@TS3_V@@\" aria-label=\"관 속 핵산 가운데 병원체의 핵산 한 가닥이 복제되어 2, 4, 8 가닥으로 늘어난다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@TS4@@\" src=\"@@TS4_V@@\" aria-label=\"증폭 횟수가 30회까지 오르며 병원체 핵산이 있는 검체의 그래프만 검출선을 넘어 약 10억 배가 된다\"></video>\n        </div>\n        <div class=\"st-ctl\"><span>①</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0\" aria-label=\"단계 막대: 두 진단 검사를 네 단계로 본다\"><span>④</span></div>\n        <div class=\"st-pills\" style=\"--n:4\" role=\"group\" aria-label=\"단계 고르기\"><button type=\"button\">① 단백질</button><button type=\"button\">② 적으면?</button><button type=\"button\">③ 핵산 복제</button><button type=\"button\">④ 30번</button></div>\n        <div class=\"tcard st-now st-cap\" aria-live=\"polite\"><span data-edit=\"t-tag-4\" class=\"t-tag st-tag\">1단계 / 4</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n      </div>\n      <ol class=\"st-text\" hidden>\n        <li><h4 data-edit=\"h4-1\">항체가 단백질을 붙잡는다</h4><p data-edit=\"p-4\">T 줄의 항체가 짝이 맞는 바이러스 <b>단백질</b>만 붙잡아 줄이 붉어진다 → 몇 분이면 끝.</p></li>\n        <li><h4 data-edit=\"h4-2\">적으면 놓칠 수 있다</h4><p data-edit=\"p-5\">붙잡힌 단백질이 적으면 T 줄이 흐려 <b>음성처럼</b> 보인다. 신속 항원 검사의 약점.</p></li>\n        <li><h4 data-edit=\"h4-3\">핵산을 복제해 늘린다</h4><p data-edit=\"p-6\">병원체의 <b>핵산</b>만 골라 복제한다. 한 번 되풀이할 때마다 <b>2배</b>(1 → 2 → 4 → 8).</p></li>\n        <li><h4 data-edit=\"h4-4\">30번이면 약 10억 배</h4><p data-edit=\"p-7\">아주 적어도 늘려서 찾으니 <b>정확</b>하다. 대신 되풀이하는 <b>시간</b>이 걸린다.</p></li>\n      </ol>\n    </div>\n    <div class=\"pk\" data-ans=\"one\" hidden>\n      <div class=\"pk-side\">\n        <span class=\"pk-kick\">먼저 보고 놀라기 · 예측 걸기</span>\n        <p data-edit=\"pk-q\" class=\"pk-q\">이 사람의 검사 띠에는 붉은 줄이 몇 개 나타날까?</p>\n        <div class=\"share-opts\" role=\"group\" aria-label=\"예측\"><button type=\"button\" data-k=\"none\" aria-pressed=\"false\">하나도 안 생긴다</button><button type=\"button\" data-k=\"one\" aria-pressed=\"false\" data-why=\"C 줄은 검사가 제대로 됐다는 표시. T 줄이 없으니 음성이다.\">C 줄 하나만</button><button type=\"button\" data-k=\"two\" aria-pressed=\"false\">C·T 두 줄</button></div>\n        <p class=\"pk-say\" aria-live=\"polite\"></p>\n        <div class=\"pk-row\"><button type=\"button\" class=\"btn pk-close\">이론 설명 보기 →</button><small class=\"cr\">영상: Norbert L. Rühl · CC0 · 4배 빠르게</small></div>\n      </div>\n      <div class=\"pk-vid\"><video muted playsinline preload=\"auto\" poster=\"@@TEST_P@@\" src=\"@@TEST_V@@\" aria-label=\"검체를 떨어뜨린 신속 항원 검사 도구의 창에 액체가 번지고, C 줄 하나만 붉게 나타나는 빠른 영상\"></video><button type=\"button\" class=\"pk-play\">▶ 영상 보기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 130쪽 · 132~133쪽</b><span>그림: Manim으로 그린 모형 · 알갱이 수는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.1.test */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 3D 병원체 모형 + 예측(네 번째 단계에서 답 표시) · 사건 파일 1은 확인 장에서 푼다\n  part('tongsci2-3-1-1-test', (root) => {\n    const defs = [...root.querySelectorAll('.tt-def')];\n    root.addEventListener('st-step', (e) => {\n      const k = e.detail, on = k <= 1 ? ['ag', 'abd'] : ['pcr'];\n      defs.forEach((d) => d.classList.toggle('on', on.some((c) => d.classList.contains(c))));\n    });\n    return window.RxT.join(window.RxT.stepper(root), window.RxPeek.mount(root));\n  });\n\n  // 4. 체험: 탐구 1 — ① 포획 항체 ② 진단 시료 ③ 검출 시약·진단 반응물\n})();\n","needs":[],"media":{"TS1":"ts1.webp","TS1_V":"ts1.mp4","TS2":"ts2.webp","TS2_V":"ts2.mp4","TS3":"ts3.webp","TS3_V":"ts3.mp4","TS4":"ts4.webp","TS4_V":"ts4.mp4","TEST_P":"test.webp","TEST_V":"test.mp4"}}