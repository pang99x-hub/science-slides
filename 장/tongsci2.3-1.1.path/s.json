{"id":"tongsci2.3-1.1.path","unit":"tongsci2.3-1","html":"<!-- 2. 이론: 감염병과 병원체(사진) -->\n<section id=\"tongsci2-3-1-1-path\" data-state=\"path\" class=\"std l1t\" data-word=\"내가 걸려 본 감염병 하나\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 130쪽 · 감염병과 병원체</div>\n        <h2 data-edit=\"h2\">감염병은 무엇이 일으킬까</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">검사는 몸속 무엇을 찾을까?</p>\n    </div>\n    <div class=\"t-body t-hist t-lvl t-path\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def lv-row\" data-k=\"inf\"><span data-edit=\"t-tag-1\" class=\"t-tag\">감염병</span><p data-edit=\"p-1\"><b>병원체</b>가 몸에 들어와 생기는 병</p><p data-edit=\"t-sub-1\" class=\"t-sub\">감기·독감·결핵·무좀 — 숨, 물과 음식, 피부, 피, 곤충을 타고 옮는다</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"path\"><span data-edit=\"t-tag-2\" class=\"t-tag\">병원체</span><p data-edit=\"p-2\">병을 일으키는 <b>바이러스</b>·세균·곰팡이</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"spec\"><span data-edit=\"t-tag-3\" class=\"t-tag\">검체</span><p data-edit=\"p-3\">병원체가 있는지 보려고 몸에서 받은 <b>침·콧물·피·소변</b></p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"vir\"><span data-edit=\"t-tag-4\" class=\"t-tag\">바이러스</span><p data-edit=\"p-4\">겉은 <b>단백질</b>, 속은 <b>핵산</b>(DNA·RNA 같은 유전 물질)</p><p data-edit=\"t-sub-2\" class=\"t-sub\">진단 검사는 이 둘 가운데 하나를 찾아낸다</p></div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs g5\" role=\"group\" aria-label=\"사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"vir\" data-name=\"독감 바이러스(전자 현미경)\" data-chip=\"바이러스\" data-kind=\"k-vir\" data-d=\"둥근 알갱이 하나하나가 바이러스. 겉껍질의 <b>단백질</b> 돌기와 속의 <b>핵산</b>이 검사의 단서가 된다.\" data-cr=\"Cynthia Goldsmith·미국 질병통제예방센터 · 퍼블릭 도메인\"><img src=\"@@P_FLU@@\" alt=\"전자 현미경으로 본 둥근 독감 바이러스 알갱이들\"><span>독감</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"path\" data-name=\"결핵균(전자 현미경)\" data-chip=\"세균\" data-kind=\"k-bac\" data-d=\"막대 모양의 세균. 결핵은 이 세균이 숨을 타고 폐로 들어와 생기는 <b>감염병</b>이다.\" data-cr=\"Janice Carr·미국 질병통제예방센터 · 퍼블릭 도메인\"><img src=\"@@P_TB@@\" alt=\"전자 현미경으로 본 막대 모양의 결핵균 무리\"><span>결핵균</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"path\" data-name=\"무좀을 일으키는 곰팡이\" data-chip=\"곰팡이\" data-kind=\"k-fun\" data-d=\"가는 실과 작은 포자가 보이는 곰팡이. 피부에 닿아 옮으며 발에 무좀을 일으킨다.\" data-cr=\"Libero Ajello·미국 질병통제예방센터 · 퍼블릭 도메인\"><img src=\"@@P_FUNGUS@@\" alt=\"현미경으로 본 실 모양 곰팡이와 포자\"><span>곰팡이</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"spec\" data-name=\"콧속 검체 받기\" data-chip=\"검체\" data-kind=\"k-spec\" data-d=\"긴 면봉으로 콧속 깊은 곳을 훑어 <b>검체</b>를 받는다. 이 검체 속에서 병원체를 찾는다.\" data-cr=\"미 해군 의무대 · 퍼블릭 도메인\"><img src=\"@@P_SWAB@@\" alt=\"장갑 낀 손이 면봉으로 남자의 콧속 검체를 받는 모습\"><span>콧속 검체</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"spec\" data-name=\"피를 담은 검체 관\" data-chip=\"검체\" data-kind=\"k-spec\" data-d=\"피도 검체가 된다. 관마다 이름표를 붙여 누구의 것인지 헷갈리지 않게 한다.\" data-cr=\"Dotodot · CC BY-SA 4.0\"><img src=\"@@P_BLOOD@@\" alt=\"받침대에 꽂힌 피가 담긴 검체 관 하나\"><span>혈액 검체</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 130쪽</b><span>사진: 위키미디어 공용(사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.1.path */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 3D 병원체 모형 + 예측(네 번째 단계에서 답 표시) · 사건 파일 1은 확인 장에서 푼다\n  part('tongsci2-3-1-1-path', (root) => { rows(root, '.lv-row'); return window.RxT.gallery(root); });\n\n  // 3. 이론: 두 진단 검사 — Manim 단계 영상 + 먼저 보고 놀라기(실제 검사 영상)\n})();\n","needs":[],"media":{"P_FLU":"p-flu.webp","P_TB":"p-tb.webp","P_FUNGUS":"p-fungus.webp","P_SWAB":"p-swab.webp","P_BLOOD":"p-blood.webp"}}