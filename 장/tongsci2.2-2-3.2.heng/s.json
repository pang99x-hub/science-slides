{"id":"tongsci2.2-2-3.2.heng","unit":"tongsci2.2-2-3","html":"<!-- 4. 심화 · 열기관의 열효율 -->\n<section id=\"tongsci2-2-2-3-2-heng\" data-state=\"heng\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div class=\"eyebrow\">체험 · <span class=\"deep\">심화</span> 화력 발전소 · 열기관</div>\n        <h2 data-edit=\"h2\">열기관의 열효율</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">넣은 열 = 한 일 + 내보낸 열</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"stage he-stage\" data-prevent-swipe>\n        <svg class=\"he-svg\" viewBox=\"0 0 1056 652\" role=\"img\" aria-label=\"화력 발전소의 열기관: 보일러에서 열을 받아 수증기가 터빈을 돌리고, 냉각기에서 남은 열을 바다로 내보낸 뒤 물이 펌프로 다시 보일러로 돌아가는 순환\">\n          <!-- 바다(저열원 쪽) -->\n          <rect class=\"he-sea\" x=\"700\" y=\"560\" width=\"356\" height=\"92\"/>\n          <ellipse class=\"he-plume\" cx=\"860\" cy=\"590\" rx=\"110\" ry=\"28\"/>\n          <text class=\"he-sname\" x=\"980\" y=\"636\">바다</text>\n          <!-- 관: 보일러 → 터빈 → 냉각기 → 펌프 → 보일러 -->\n          <path class=\"he-pipe\" d=\"M200 300 V 140 H 484\"/>\n          <path class=\"he-pipe\" d=\"M560 216 V 386\"/>\n          <path class=\"he-pipe he-water\" d=\"M540 520 V 588 H 236 V 520\"/>\n          <g class=\"he-dots\"></g>\n          <!-- 냉각수 관 -->\n          <path class=\"he-cool\" d=\"M620 430 H 760 V 560\"/><path class=\"he-cool warm\" d=\"M620 480 H 700 V 560\"/>\n          <!-- 보일러 -->\n          <rect class=\"he-boiler\" x=\"100\" y=\"300\" width=\"200\" height=\"220\" rx=\"26\"/>\n          <rect class=\"he-wlevel\" x=\"112\" y=\"400\" width=\"176\" height=\"108\" rx=\"12\"/>\n          <text class=\"he-name\" x=\"200\" y=\"350\">보일러</text><text class=\"he-sub\" x=\"200\" y=\"376\">고열원</text>\n          <g class=\"he-fire\"></g>\n          <g class=\"he-coal\"><path d=\"M110 612 l 14 -18 l 26 -6 l 18 14 l -6 14 z\"/><path d=\"M168 616 l 10 -20 l 28 -4 l 14 18 l -8 10 z\"/><path d=\"M226 612 l 14 -16 l 24 0 l 12 14 l -6 8 z\"/></g>\n          <text class=\"he-sub\" x=\"120\" y=\"644\" text-anchor=\"start\">석탄 더미 · 삽으로 불에 퍼 넣기</text>\n          <g class=\"he-shovel\" tabindex=\"0\" role=\"button\" aria-label=\"삽으로 석탄 한 삽 넣기(끌어서 불에 놓기)\"><path class=\"he-sh-h\" d=\"M10 -8 L 64 -84\"/><path class=\"he-sh-g\" d=\"M58 -92 h 18\"/><path class=\"he-sh-b\" d=\"M-20 4 Q -22 -14 0 -16 L 22 -12 Q 26 6 4 10 Z\"/><path class=\"he-sh-c\" d=\"M-12 -6 l 8 -8 l 10 4 l 4 8 l -12 4 z\"/></g>\n          <g class=\"he-valve\" tabindex=\"0\" role=\"slider\" aria-label=\"보일러 압력 밸브(돌려서 수증기 온도 바꾸기)\"><circle class=\"he-vw\" cx=\"200\" cy=\"262\" r=\"30\"/><g class=\"he-vs\"><path d=\"M200 232 V 292 M 170 262 H 230 M 179 241 L 221 283 M 221 241 L 179 283\"/></g><circle class=\"he-vh\" cx=\"200\" cy=\"262\" r=\"8\"/></g>\n          <text class=\"he-sub\" x=\"319\" y=\"252\">보일러 밸브</text>\n          <g class=\"he-temp\" transform=\"translate(244 262)\"><rect class=\"he-tbg\" width=\"150\" height=\"18\" rx=\"9\"/><rect class=\"he-tf\" width=\"60\" height=\"18\" rx=\"9\"/><text x=\"75\" y=\"40\" class=\"he-tl\">수증기 온도</text></g>\n          <!-- 터빈·발전기 -->\n          <g class=\"he-turb\"><circle class=\"he-tcase\" cx=\"560\" cy=\"140\" r=\"76\"/><g class=\"he-blades\"><path d=\"M560 140 L 560 74 M 560 140 L 617 107 M 560 140 L 617 173 M 560 140 L 560 206 M 560 140 L 503 173 M 560 140 L 503 107\"/></g><circle class=\"he-hub\" cx=\"560\" cy=\"140\" r=\"14\"/></g>\n          <text class=\"he-name\" x=\"560\" y=\"252\" text-anchor=\"start\" dx=\"30\">터빈</text>\n          <rect class=\"he-shaft\" x=\"636\" y=\"132\" width=\"90\" height=\"16\" rx=\"4\"/>\n          <rect class=\"he-gen\" x=\"720\" y=\"86\" width=\"150\" height=\"108\" rx=\"16\"/><text class=\"he-name\" x=\"795\" y=\"148\">발전기</text>\n          <path class=\"he-wire\" d=\"M870 120 H 940 V 96\"/>\n          <g class=\"he-town\"><circle class=\"he-lglow\" cx=\"960\" cy=\"80\" r=\"56\"/><circle class=\"he-lamp\" cx=\"960\" cy=\"74\" r=\"20\"/><rect class=\"he-lb\" x=\"951\" y=\"92\" width=\"18\" height=\"12\" rx=\"2\"/></g>\n          <!-- 냉각기·펌프 -->\n          <rect class=\"he-cond\" x=\"470\" y=\"386\" width=\"180\" height=\"134\" rx=\"20\"/>\n          <path class=\"he-coil\" d=\"M490 430 h 140 M 490 450 h 140 M 490 470 h 140 M 490 490 h 140\"/>\n          <text class=\"he-name\" x=\"456\" y=\"420\" text-anchor=\"end\">냉각기</text><text class=\"he-sub\" x=\"456\" y=\"446\" text-anchor=\"end\">저열원</text>\n          <circle class=\"he-pump\" cx=\"315\" cy=\"588\" r=\"26\"/><text class=\"he-sub\" x=\"315\" y=\"636\">펌프</text>\n          <!-- 에너지 화살표: Q1 · W · Q2 -->\n          <path class=\"he-q1\" d=\"M200 590 V 528\"/><polygon class=\"he-q1h\" points=\"0,0\"/>\n          <path class=\"he-w\" d=\"M640 60 H 730\"/><polygon class=\"he-wh\" points=\"0,0\"/>\n          <path class=\"he-q2\" d=\"M650 520 L 760 600\"/><polygon class=\"he-q2h\" points=\"0,0\"/>\n          <g class=\"he-tag he-tq1\" transform=\"translate(14 160)\"><rect width=\"172\" height=\"58\" rx=\"12\"/><text x=\"86\" y=\"25\">흡수한 열 Q₁</text><text class=\"he-tv\" x=\"86\" y=\"49\">100 J</text></g>\n          <g class=\"he-tag he-tw\" transform=\"translate(600 2)\"><rect width=\"172\" height=\"44\" rx=\"12\"/><text x=\"62\" y=\"30\">한 일 W</text><text class=\"he-tv\" x=\"140\" y=\"30\">30 J</text></g>\n          <g class=\"he-tag he-tq2\" transform=\"translate(780 470)\"><rect width=\"200\" height=\"58\" rx=\"12\"/><text x=\"100\" y=\"25\">방출한 열 Q₂</text><text class=\"he-tv\" x=\"100\" y=\"49\">70 J</text></g>\n        </svg>\n      </div>\n      <div class=\"panel he-panel\">\n        <div class=\"he-read\">\n          <div class=\"he-r\" style=\"--c: var(--e-heat)\"><span>석탄 <b class=\"he-n\">4</b>삽 → 흡수한 열 Q₁</span><em class=\"he-o1\">100 J</em><button class=\"btn small-btn\" type=\"button\" id=\"he-less\">한 삽 빼기</button></div>\n          <div class=\"he-r\" style=\"--c: var(--e-pot)\"><span>보일러 밸브 → 수증기 온도</span><em class=\"he-o2\">보통</em></div>\n        </div>\n        <div class=\"he-eq\">\n          <p class=\"he-law\"><b>Q₁ = W + Q₂</b><span>에너지 보존</span></p>\n          <p class=\"he-law\"><b>e = W ÷ Q₁ = 1 − Q₂ ÷ Q₁</b><span>열효율</span></p>\n          <p class=\"he-now\" aria-live=\"polite\"></p>\n        </div>\n        <p class=\"he-msg pen\" aria-live=\"polite\"></p>\n        <div class=\"def he-prob\"><p data-edit=\"p\">문제: Q₁ = 100 J, W = 30 J이면 Q₂와 e는?</p><span class=\"blank fragment custom\" data-anim=\"blank\" data-fragment-index=\"0\"><span class=\"bk\">Q₂ = 70 J, e = 0.3 (30 %)</span></span></div>\n        <p data-edit=\"he-tip\" class=\"he-tip fragment custom\" data-anim=\"mrow\" data-fragment-index=\"1\">같은 열을 넣을 때 <b>내보내는 열 Q₂가 작을수록</b> 일을 더 많이 해 효율이 높다. Q₂는 0이 될 수 없다.</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>심화 · 열기관</b><span>열을 일로 바꾸는 장치: 열을 받아 일을 하고 남은 열을 내보낸 뒤 처음 상태로 돌아간다</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-2-3.2.heng */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const NS = 'http://www.w3.org/2000/svg';\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const J = (...p) => window.RxT.join(...p);\n  const dock = (root, cfg) => window.UDock.mount(root, cfg);\n  const stopKeys = (i) => i.addEventListener('keydown', (e) => e.stopPropagation());   // ←→로 장이 넘어가지 않게\n\n  // 1. 표지: 켜 둔 시간을 늘리면 열화상 속 세 기구가 달아오른다\n  part('tongsci2-2-2-3-2-heng', (root) => J(window.HeatEngine.mount(root), dock(root, {\n    steps: ['석탄 삽 수 바꾸기', '밸브 돌리기', '문제 답 열기'],\n    on: ['#he-less, .he-coal, .he-shovel', '.he-valve', (r) => r.querySelector('.he-prob .fragment.visible')],\n    learn: '열기관도 에너지 보존(<b>Q₁ = W + Q₂</b>). 내보내는 열 Q₂가 있어 열효율 e는 1보다 작다.',\n  })));\n})();\n","needs":["heng"],"media":{}}