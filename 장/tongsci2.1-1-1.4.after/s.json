{"id":"tongsci2.1-1-1.4.after","unit":"tongsci2.1-1-1","html":"<!-- 5. 설명: 대멸종 뒤 빈자리 -->\n<section id=\"tongsci2-1-1-1-4-after\" data-state=\"after\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 19쪽 · 생물 대멸종 이후의 변화</div>\n        <h2 data-edit=\"h2\">대멸종 뒤, 빈자리를 채운 생물</h2>\n      </div>\n      <button type=\"button\" class=\"u-vbtn t-vbtn\" aria-expanded=\"false\">영상으로 한 번에 보기</button>\n    </div>\n    <div class=\"t-body t-steps\">\n      <div class=\"st-fig\" data-prevent-swipe>\n        <div class=\"st-stage\">\n          <img class=\"st-im\" src=\"@@RAD_1@@\" alt=\"중생대: 공룡 가지 여러 개가 뻗어 있고 작은 포유류는 가는 줄기 하나뿐인 가지 그림\">\n          <img class=\"st-im\" src=\"@@RAD_2@@\" alt=\"중생대 말 대멸종 선에서 공룡 가지가 모두 끊기고 새 가지와 작은 포유류 줄기만 이어지는 그림\">\n          <img class=\"st-im\" src=\"@@RAD_3@@\" alt=\"살아남은 포유류 줄기가 신생대에 몇 갈래로 나뉘기 시작하는 그림\">\n          <img class=\"st-im\" src=\"@@RAD_4@@\" alt=\"포유류가 박쥐·고래·말·매머드·원숭이로 갈라져 하늘·바다·초원·추운 들판·숲을 채운 그림\">\n        </div>\n        <div class=\"fm-ctl st-ctl\"><span>시간</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0\" aria-label=\"시간 막대: 오른쪽으로 끌면 중생대에서 대멸종을 지나 신생대로 넘어간다\"><span>→</span></div>\n        <div class=\"fm-pills st-pills af-pills\" role=\"group\" aria-label=\"단계 고르기\">\n          <button type=\"button\" data-n=\"공룡이 뭍을 차지\" data-d=\"중생대에는 <b>공룡</b>이 뭍의 큰 동물 자리를 모두 차지했다. 포유류는 작은 몸으로 숨어 살았다.\">① 중생대</button>\n          <button type=\"button\" data-n=\"대멸종으로 빈자리\" data-d=\"중생대 말 환경이 급격히 바뀌어 공룡이 사라졌다. 그러나 작은 포유류·새·속씨식물처럼 <b>견딘 생물</b>도 있었다.\">② 대멸종</button>\n          <button type=\"button\" data-n=\"빈자리로 퍼진다\" data-d=\"살아남은 포유류가 경쟁자가 사라진 <b>빈자리</b>로 퍼져 나간다.\">③ 퍼짐</button>\n          <button type=\"button\" data-n=\"여러 종으로 갈라져 번성\" data-d=\"새 환경에 <b>적응</b>한 무리가 하늘·바다·초원·숲으로 갈라져 <b>다양한 종</b>이 되었다. 신생대 = 포유류의 시대.\">④ 번성</button>\n        </div>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"tcard fm-now st-now\" aria-live=\"polite\"><span data-edit=\"t-tag-1\" class=\"t-tag st-tag\">1단계 / 4</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n        <div class=\"tcard af-key\"><span data-edit=\"t-tag-2\" class=\"t-tag\">그래프와 잇기</span><p data-edit=\"p\">그림 I-11의 곡선: 대멸종 때 <b>뚝 떨어졌다가</b> 다시 오르고, 결국 그 전보다 <b>높아졌다</b>.</p></div>\n        <div class=\"tcard af-sum fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\">\n          <span data-edit=\"t-tag-3\" class=\"t-tag\">대멸종 이후의 변화</span>\n          <p class=\"s-chain\"><span>급격한 환경 변화</span>→<span>대멸종</span>→<span><b>적응</b>한 생물이 빈자리를 채움</span>→<span>여러 종으로 진화</span></p>\n          <p data-edit=\"t-sub\" class=\"t-sub\">그래서 지질 시대 동안 <b>생물다양성</b>은 대체로 <b>늘어</b> 왔다.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"u-vid\" hidden>\n      <video muted playsinline preload=\"auto\" src=\"@@RAD_VIDEO@@\" aria-label=\"공룡 가지가 중생대 말 대멸종 선에서 끊기고, 살아남은 포유류 줄기가 신생대에 여러 갈래로 갈라져 퍼지는 가지 그림 영상\"></video>\n      <div class=\"u-vbar\"><button type=\"button\" class=\"u-vagain\">처음부터</button><button type=\"button\" class=\"u-vclose\">닫기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 19쪽</b><span>가지의 수·갈라진 때는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.4.after */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  part('tongsci2-1-1-1-4-after', (root) => window.T2.steps(root));\n  part('tongsci2-1-1-1-4-after', (root) => window.L1.frame(root));\n  // 6. 체험: 새총 → ①쏘기 ②끝까지 ③다른 세기로 한 번 더\n})();\n","needs":["teach2","eralens"],"media":{"RAD_1":"rad-1.webp","RAD_2":"rad-2.webp","RAD_3":"rad-3.webp","RAD_4":"rad-4.webp","RAD_VIDEO":"RadFlow.mp4"}}