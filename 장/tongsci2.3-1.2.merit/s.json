{"id":"tongsci2.3-1.2.merit","unit":"tongsci2.3-1","html":"<!-- 7. 장점과 문제점 -->\n<section id=\"tongsci2-3-1-2-merit\" data-state=\"merit\" class=\"std evx\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 135쪽 해 보기 · 빅데이터의 좋은 점과 걱정되는 점</div>\n        <h2 data-edit=\"h2\">자세히 볼수록 좋기만 할까</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">막대를 밀어 자세히 보자</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"stage mr-stage\" data-prevent-swipe>\n        <svg class=\"mr-svg\" viewBox=\"0 0 1056 520\" role=\"img\" aria-label=\"가상 도시의 휴대 전화 위치 기록: 자세히 볼수록 버스 노선은 잘 정해지지만 한 사람의 동선이 드러난다\"></svg>\n        <div class=\"mr-ctl\"><label class=\"pl-ctl\"><span>자료를 얼마나 자세히</span><input type=\"range\" id=\"mr-zoom\" min=\"0\" max=\"3\" step=\"1\" value=\"0\" aria-label=\"통화 기록 자료를 얼마나 자세히 볼까\"><em class=\"mr-zv\">구역별 합계</em></label></div>\n      </div>\n      <div class=\"panel mr-panel\" data-prevent-swipe>\n        <ol class=\"u-steps\"><li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 막대를 밀어 거리 단위까지 자세히 본다</li><li data-edit=\"li-2\" data-s=\"2\"><b>②</b> 한 사람 단위까지 밀어 무엇이 드러나는지 본다</li><li data-edit=\"li-3\" data-s=\"3\"><b>③</b> 카드 여섯을 장점·문제점 칸에 넣는다</li></ol>\n        <div class=\"mr-read\">\n          <div class=\"mr-r\"><span>버스 노선 정하기</span><b><i class=\"use\"></i></b></div>\n          <div class=\"mr-r\"><span>사생활 침해 위험</span><b><i class=\"risk\"></i></b></div>\n          <p class=\"mr-say\" aria-live=\"polite\"></p>\n        </div>\n        <div class=\"mr-pool tray\" aria-label=\"장점·문제점 카드(끌어다 아래 칸에 넣기)\">\n          <span class=\"tray-tag\">카드</span>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"good\">앞으로 일어날 일을 예측한다</button>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"bad\">개인 정보가 새어 나갈 수 있다</button>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"good\">개인 성향에 맞게 추천한다</button>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"bad\">정확하지 않은 정보가 섞일 수 있다</button>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"good\">얽힌 문제를 재빨리 분석한다</button>\n          <button type=\"button\" class=\"mr-card tray-item\" data-k=\"bad\">예측이 틀릴 수 있다</button>\n        </div>\n        <div class=\"mr-bins\">\n          <div class=\"mr-bin\" data-k=\"good\" tabindex=\"0\" role=\"button\" aria-label=\"장점 칸\"><h3 data-edit=\"h3-1\">장점</h3><div class=\"mr-in\"></div></div>\n          <div class=\"mr-bin\" data-k=\"bad\" tabindex=\"0\" role=\"button\" aria-label=\"문제점 칸\"><h3 data-edit=\"h3-2\">문제점</h3><div class=\"mr-in\"></div></div>\n        </div>\n        <p data-edit=\"mr-msg\" class=\"mr-msg\" aria-live=\"polite\">카드를 장점·문제점 칸에 끌어 넣어 보자</p>\n        <div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p\">자세할수록 쓸모는 커지지만 <b>사생활 침해</b> 위험도 커진다 → 목적에 필요한 만큼만 쓴다.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 135쪽 해 보기</b><span>지도와 사람은 모두 가상 · 막대는 비교를 위한 그림</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.2.merit */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 가상 태풍의 예보 범위 + 예측(네 번째 단계에서 답 표시) · 사건 파일 2는 확인 장에서 푼다\n  part('tongsci2-3-1-2-merit', (root) => {\n    const m = window.MeritMap.mount(root);\n    const z = root.querySelector('#mr-zoom');\n    track(root, () => {\n      const v = Number(z.value), p = root.querySelectorAll('.mr-card.placed').length;\n      return v < 2 ? 1 : v < 3 ? 2 : p < 6 ? 3 : 0;\n    });\n    return m;\n  });\n\n  // 8. 미니 게임: 빅데이터 판정단(빠른 퀴즈)\n})();\n","needs":["merit"],"media":{}}