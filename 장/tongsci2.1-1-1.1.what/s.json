{"id":"tongsci2.1-1-1.1.what","unit":"tongsci2.1-1-1","html":"<!-- 2. 설명: 지질 시대와 화석 -->\n<section id=\"tongsci2-1-1-1-1-what\" data-state=\"what\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 14쪽</div>\n        <h2 data-edit=\"h2\">지질 시대와 화석</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">화석은 뼈만 말하는 걸까?</p>\n    </div>\n    <div class=\"t-body t-what\">\n      <div class=\"t-col\">\n        <div class=\"tcard\">\n          <span data-edit=\"t-tag-1\" class=\"t-tag\">지질 시대</span>\n          <p data-edit=\"p-1\">지구가 생겨난 <b>약 46억 년 전</b>부터 <b>지금</b>까지의 긴 시간</p>\n          <svg class=\"t-tl\" viewBox=\"0 0 660 84\" role=\"img\" aria-label=\"왼쪽 끝 약 46억 년 전 지구 탄생에서 오른쪽 끝 현재까지 이어진 시간의 선\">\n            <line x1=\"20\" y1=\"28\" x2=\"626\" y2=\"28\" class=\"tl-line\"/><path d=\"M622 16 L644 28 L622 40 Z\" class=\"tl-head\"/>\n            <circle cx=\"20\" cy=\"28\" r=\"10\" class=\"tl-a\"/><circle cx=\"626\" cy=\"28\" r=\"10\" class=\"tl-b\"/>\n            <text x=\"6\" y=\"74\">약 46억 년 전 · 지구 탄생</text><text x=\"654\" y=\"74\" text-anchor=\"end\">현재</text>\n          </svg>\n        </div>\n        <div class=\"tcard\">\n          <span data-edit=\"t-tag-2\" class=\"t-tag\">화석</span>\n          <p data-edit=\"p-2\">지질 시대 생물의 <b>유해</b>(몸)나 <b>흔적</b>이 <b>지층</b> 속에 남은 것</p>\n          <p data-edit=\"t-sub\" class=\"t-sub\">대부분 <b>퇴적암</b>에서 나온다. 진흙·모래가 쌓여 굳은 돌이라 생물이 묻혀 남기 좋다.</p>\n        </div>\n        <div class=\"tcard t-sort\">\n          <p><span class=\"chip body\">몸(유해)</span> 뼈 · 껍데기 · 이빨 · 나무줄기</p>\n          <p><span class=\"chip trace\">흔적</span> 발자국 · 기어간 자국 · 파 놓은 구멍</p>\n          <p><span class=\"chip etc\">그 밖에</span> 알 · 배설물도 화석이 된다</p>\n        </div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs\" role=\"group\" aria-label=\"화석 사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"뼈\" data-kind=\"body\" data-d=\"동물의 뼈가 묻혀 돌처럼 바뀐 것. 단단해서 썩지 않고 남았다.\" data-cr=\"James St. John · CC BY 2.0\"><img src=\"@@FS_BONE@@\" alt=\"암석에서 꺼낸 길쭉한 동물 뼈 화석\"><span>뼈</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"껍데기\" data-kind=\"body\" data-d=\"조개껍데기가 한꺼번에 묻혀 바위 한 판에 가득 남았다.\" data-cr=\"Yinan Chen · 퍼블릭 도메인\"><img src=\"@@FS_SHELL@@\" alt=\"바위 판에 빽빽하게 박힌 조개껍데기 화석\"><span>껍데기</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"발자국\" data-kind=\"trace\" data-d=\"공룡이 진흙을 밟고 지나간 자국이 굳었다. 몸은 없어도 화석이다(우리나라 수각류 발자국).\" data-cr=\"국가유산청 · 공공누리 제1유형\"><img src=\"@@FS_FOOT@@\" alt=\"바위 위에 찍힌 세 발가락 공룡 발자국 화석과 눈금자\"><span>발자국</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"기어간 자국\" data-kind=\"trace\" data-d=\"바다 밑을 기어 다니던 벌레가 남긴 길. 그곳에 생물이 살았다는 증거다.\" data-cr=\"그랜드캐니언 국립공원 · CC BY 2.0\"><img src=\"@@FS_TRAIL@@\" alt=\"암석 면에 구불구불 얽힌 벌레가 기어간 자국 화석\"><span>기어간 자국</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"알\" data-kind=\"etc\" data-d=\"공룡 알이 둥지에 놓인 모양 그대로 남았다.\" data-cr=\"Gary Todd · CC0\"><img src=\"@@FS_EGG@@\" alt=\"돌 덩이 위에 여러 개 모여 있는 공룡 알 화석\"><span>알</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"규화목\" data-kind=\"body\" data-d=\"나무줄기가 돌로 바뀐 것. 나무의 결과 나이테가 그대로 보인다.\" data-cr=\"Jon Sullivan · 퍼블릭 도메인\"><img src=\"@@FS_WOOD@@\" alt=\"나뭇결과 나이테가 그대로 남은 채 돌로 바뀐 나무줄기 화석\"><span>규화목</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 14쪽</b><span>사진: 위키미디어 공용·국가유산청 공개 자료(각 사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.1.what */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 손전등으로 발자국 찾기(①) + 예측(②, 한 번 넘기면 답과 풀이)\n  part('tongsci2-1-1-1-1-what', (root) => window.T1.gallery(root));\n})();\n","needs":[],"media":{"FS_BONE":"fs-bone.webp","FS_SHELL":"fs-shell.webp","FS_FOOT":"fs-foot.webp","FS_TRAIL":"fs-trail.webp","FS_EGG":"fs-egg.webp","FS_WOOD":"fs-wood.webp"}}