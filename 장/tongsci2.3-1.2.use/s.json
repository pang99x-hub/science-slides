{"id":"tongsci2.3-1.2.use","unit":"tongsci2.3-1","html":"<!-- 6. 이론: 빅데이터의 활용과 장점·문제점(사진 + 표) -->\n<section id=\"tongsci2-3-1-2-use\" data-state=\"use\" class=\"std l1t\" data-word=\"내가 쓰는 빅데이터 서비스 하나\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 134~135쪽 그림 Ⅲ-2 · 빅데이터의 활용과 장점·문제점</div>\n        <h2 data-edit=\"h2\">어디에 쓰고, 무엇을 조심할까</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">좋은 점만 있을까?</p>\n    </div>\n    <div class=\"t-body t-hist t-use\">\n      <div class=\"t-col\">\n        <table class=\"mini use-tab nd-tab\" aria-label=\"빅데이터를 쓰는 분야와 예\">\n          <colgroup><col style=\"width: 30%\"><col></colgroup>\n          <thead><tr><th data-edit=\"th-1\">분야</th><th data-edit=\"th-2\">무엇을 분석해 무엇을 하나</th></tr></thead>\n          <tbody>\n            <tr data-k=\"weather\"><th data-edit=\"th-3\">일기 예보</th><td data-edit=\"td-1\">위성·관측소 자료 → 날씨의 <b>패턴</b>, 태풍 길</td></tr>\n            <tr data-k=\"lab\"><th data-edit=\"th-4\">과학 실험</th><td data-edit=\"td-2\">쌓인 실험 결과 → 혼자 못 할 연구</td></tr>\n            <tr data-k=\"gene\"><th data-edit=\"th-5\">유전체 분석</th><td data-edit=\"td-3\">유전체 자료 → <b>질병</b> 예측, 맞춤 치료</td></tr>\n            <tr data-k=\"drug\"><th data-edit=\"th-6\">신약 개발</th><td data-edit=\"td-4\">약물·화학 물질 자료 → <b>후보 물질</b>을 빨리</td></tr>\n            <tr data-k=\"life\"><th data-edit=\"th-7\">일상생활</th><td data-edit=\"td-5\">구매·이동·언어 기록 → 추천, 길 안내, <b>번역</b></td></tr>\n          </tbody>\n        </table>\n        <div class=\"tcard pm-card\">\n          <div class=\"pm good\"><span data-edit=\"t-tag-1\" class=\"t-tag\">장점</span><p data-edit=\"p-1\">더 빨리 이해하고 <b>정확하게 예측</b> · 얽힌 문제를 빠르게 분석</p></div>\n          <div class=\"pm bad\"><span data-edit=\"t-tag-2\" class=\"t-tag\">문제점</span><p data-edit=\"p-2\"><b>개인 정보</b> 유출 · 틀린 자료 · <b>편향</b>된 결과 · 지나친 의존</p></div>\n        </div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs g5\" role=\"group\" aria-label=\"사진 고르기: 누르면 위에 크게 보이고 왼쪽 표의 줄이 밝아진다\">\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"weather\" data-name=\"위성이 찍은 태풍\" data-chip=\"일기 예보\" data-kind=\"k-use\" data-d=\"위성 사진은 짧은 간격으로 쉬지 않고 쌓인다. 관측소 기록과 함께 분석해 태풍이 갈 길을 내다본다.\" data-cr=\"CSU/CIRA & JMA/JAXA · 퍼블릭 도메인\"><img src=\"@@STORM_P@@\" alt=\"위성 적외선 사진 속 붉은 소용돌이 태풍\"><span>일기 예보</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"lab\" data-name=\"연구소의 슈퍼컴퓨터\" data-chip=\"과학 실험\" data-kind=\"k-db\" data-d=\"줄지어 선 슈퍼컴퓨터가 쌓인 실험·관측 결과를 한꺼번에 계산한다. 연구자 혼자서는 할 수 없던 일.\" data-cr=\"Oleg Alexandrov · CC BY-SA 4.0\"><img src=\"@@U_SUPER@@\" alt=\"연구소 복도에 줄지어 선 슈퍼컴퓨터 장비\"><span>슈퍼컴퓨터</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"gene\" data-name=\"유전체 분석실\" data-chip=\"유전체 분석\" data-kind=\"k-use\" data-d=\"여러 대의 분석 장치가 쉬지 않고 유전체를 읽는다. 쌓인 자료로 걸리기 쉬운 <b>질병</b>을 내다본다.\" data-cr=\"Scotted400 · CC BY 3.0\"><img src=\"@@U_GENE@@\" alt=\"복도 양쪽에 늘어선 유전체 분석 장치\"><span>유전체 분석</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"drug\" data-name=\"자동 실험 장치\" data-chip=\"신약 개발\" data-kind=\"k-use\" data-d=\"수많은 물질을 한꺼번에 시험하는 자동 장치. 그 결과를 분석해 신약 <b>후보 물질</b>을 빨리 고른다.\" data-cr=\"미국 국립 알레르기·감염병 연구소 · 퍼블릭 도메인\"><img src=\"@@U_DRUG@@\" alt=\"여러 개의 피펫 끝이 한 줄로 내려오는 자동 실험 장치\"><span>신약 개발</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"life\" data-name=\"버스 교통 카드 단말기\" data-chip=\"일상생활\" data-kind=\"k-db\" data-d=\"카드를 찍을 때마다 언제·어디서 탔는지 기록이 쌓인다. 노선을 정하는 데 쓰이지만 한 사람의 동선이 드러날 수도 있다.\" data-cr=\"An Errant Knight · CC BY-SA 4.0\"><img src=\"@@U_BUS@@\" alt=\"버스 안에 달린 교통 카드 단말기\"><span>교통 카드</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 134~135쪽 그림 Ⅲ-2</b><span>사진: 위키미디어 공용(사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.2.use */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 가상 태풍의 예보 범위 + 예측(네 번째 단계에서 답 표시) · 사건 파일 2는 확인 장에서 푼다\n  part('tongsci2-3-1-2-use', (root) => { rows(root, '.use-tab tbody tr'); return window.RxT.gallery(root); });\n\n  // 7. 체험: 자세히 볼수록 — ① 거리 단위 ② 한 사람 ③ 카드 나누기\n})();\n","needs":[],"media":{"STORM_P":"storm.webp","U_SUPER":"u-super.webp","U_GENE":"u-gene.webp","U_DRUG":"u-drug.webp","U_BUS":"u-bus.webp"}}