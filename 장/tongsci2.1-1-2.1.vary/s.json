{"id":"tongsci2.1-1-2.1.vary","unit":"tongsci2.1-1-2","html":"<!-- 2. 설명: 변이 -->\n<section id=\"tongsci2-1-1-2-1-vary\" data-state=\"vary\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 20쪽</div>\n        <h2 data-edit=\"h2\">변이: 같은 종 안의 차이</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">같은 무당벌레인데 왜 무늬가 다를까?</p>\n    </div>\n    <div class=\"t-body t-vary\">\n      <div class=\"t-col\">\n        <div class=\"tcard\">\n          <span data-edit=\"t-tag-1\" class=\"t-tag\">변이</span>\n          <p data-edit=\"p-1\"><b>같은 종</b>의 개체끼리 나타나는 <b>형질</b>의 차이</p>\n          <p data-edit=\"t-sub\" class=\"t-sub\">개체마다 지닌 <b>유전정보</b>가 조금씩 달라서 생긴다. 유전되므로 자손에게 전해져 <b>진화</b>의 바탕이 된다.</p>\n        </div>\n        <div class=\"tcard\">\n          <span data-edit=\"t-tag-2\" class=\"t-tag\">차이가 겉으로 드러나는 길</span>\n          <ol class=\"va-chain\">\n            <li><svg viewBox=\"0 0 60 60\" aria-hidden=\"true\"><path d=\"M18 6 C 42 18, 18 42, 42 54 M42 6 C 18 18, 42 42, 18 54\" class=\"vc-dna\"/><path d=\"M22 14 H38 M20 30 H40 M22 46 H38\" class=\"vc-rung\"/></svg><span><b>유전자</b>가 다르다</span></li>\n            <li><svg viewBox=\"0 0 60 60\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"22\" r=\"9\" class=\"vc-pro\"/><circle cx=\"36\" cy=\"18\" r=\"7\" class=\"vc-pro\"/><circle cx=\"32\" cy=\"36\" r=\"10\" class=\"vc-pro\"/><circle cx=\"16\" cy=\"42\" r=\"6\" class=\"vc-pro\"/></svg><span>만들어지는 <b>단백질</b>의 종류·양이 다르다</span></li>\n            <li><svg viewBox=\"0 0 60 60\" aria-hidden=\"true\"><ellipse cx=\"30\" cy=\"32\" rx=\"20\" ry=\"16\" class=\"vc-bug\"/><path d=\"M30 16 V48\" class=\"vc-line\"/><circle cx=\"22\" cy=\"28\" r=\"4\" class=\"vc-dot\"/><circle cx=\"38\" cy=\"36\" r=\"4\" class=\"vc-dot\"/><circle cx=\"24\" cy=\"40\" r=\"3\" class=\"vc-dot\"/></svg><span>무늬·색 같은 <b>형질</b>이 다르다</span></li>\n          </ol>\n        </div>\n        <div class=\"tcard t-not\">\n          <span data-edit=\"t-tag-3\" class=\"t-tag\">변이가 아닌 것</span>\n          <p data-edit=\"p-2\">기린과 얼룩말의 무늬 차이 → <b>서로 다른 종</b>끼리의 차이라서 변이라고 하지 않는다.</p>\n        </div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs g4\" role=\"group\" aria-label=\"변이의 예 사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"무당벌레\" data-chip=\"같은 종\" data-kind=\"same\" data-d=\"모두 같은 종(아시아무당벌레)이다. 그런데 딱지날개의 검은 점은 개수와 크기가 저마다 다르다.\" data-cr=\"Celli 외(2021) · CC BY 4.0\"><img src=\"@@VA_LADY@@\" alt=\"같은 종 무당벌레 세 마리를 위에서 본 표본 사진. 주황 딱지날개의 검은 점 개수와 크기가 서로 다르다\"><span>무당벌레</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"사랑앵무\" data-chip=\"같은 종\" data-kind=\"same\" data-d=\"한 종의 새인데 한 마리는 초록과 노랑, 다른 한 마리는 파랑과 흰색 깃털을 지녔다.\" data-cr=\"Eric Kilby · CC BY-SA 2.0\"><img src=\"@@VA_BUDGIE@@\" alt=\"나뭇가지에 앉은 초록 사랑앵무와 파랑 사랑앵무\"><span>사랑앵무</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"바지락\" data-chip=\"같은 종\" data-kind=\"same\" data-d=\"한 바다에서 거둔 바지락 열여섯 개. 껍데기의 무늬와 색이 하나도 같지 않다.\" data-cr=\"위키미디어 공용 · 퍼블릭 도메인\"><img src=\"@@VA_CLAM@@\" alt=\"무늬와 색이 저마다 다른 바지락 껍데기 열여섯 개\"><span>바지락</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-name=\"한배 새끼 고양이\" data-chip=\"같은 부모\" data-kind=\"same\" data-d=\"한 어미가 한꺼번에 낳은 새끼들인데 털 색과 무늬가 저마다 다르다.\" data-cr=\"Brocken Inaglory · CC BY-SA 4.0\"><img src=\"@@VA_KITTEN@@\" alt=\"이불 위에 모여 앉은 털 색이 서로 다른 새끼 고양이 다섯 마리\"><span>새끼 고양이</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 20쪽</b><span>사진: 위키미디어 공용(각 사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-2.1.vary */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const K = window.EvKit;\n\n  // 1. 표지: ① 쥐 옮기기(매의 눈) → ② 예측 고르기. 한 번 넘기면 맞는 예측에 테\n  part('tongsci2-1-1-2-1-vary', (root) => window.EvT.gallery(root));\n})();\n","needs":["stage"],"media":{"VA_LADY":"va-lady.webp","VA_BUDGIE":"va-budgie.webp","VA_CLAM":"va-clam.webp","VA_KITTEN":"va-kitten.webp"}}