{"id":"tongsci2.2-2-3.3.future","unit":"tongsci2.2-2-3","html":"<!-- 6. 장단점과 미래 기술 -->\n<section id=\"tongsci2-2-2-3-3-future\" data-state=\"future\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 심화 · 신재생 에너지의 장단점과 미래 기술</div>\n        <h2 data-edit=\"h2\">좋은 점, 어려운 점, 그리고 미래 기술</h2>\n      </div>\n    </div>\n    <div class=\"fx-top\">\n      <div class=\"fx-pc good\"><span data-edit=\"tag-1\" class=\"tag\">장점</span><p data-edit=\"p-1\">쓸수록 바닥날 걱정이 적어 오래 쓸 수 있다 · 온실 기체와 오염 물질을 거의 내지 않는다</p></div>\n      <div class=\"fx-pc bad\"><span data-edit=\"tag-2\" class=\"tag\">단점</span><p data-edit=\"p-2\">처음 짓는 데 돈이 많이 들고, 들인 것에 비해 얻는 전기가 적다 · 날씨에 따라 만드는 양이 들쭉날쭉하다</p></div>\n    </div>\n    <div class=\"fx-row\" data-prevent-swipe>\n      <div class=\"fx-col\">\n        <div class=\"fx-head\"><b>수소 연료 전지</b><span>수소 + 산소 → 물 + 전기</span></div>\n        <div class=\"stage fc-stage\">\n          <svg class=\"fc-svg\" viewBox=\"0 0 780 400\" role=\"img\" aria-label=\"수소 연료 전지: (−)극에 수소, (+)극에 산소를 넣으면 전자가 바깥 전선을 따라 흘러 전구가 켜지고 물이 생긴다\">\n            <path class=\"fc-wire\" d=\"M275 120 V 50 H 505 V 120\"/>\n            <g class=\"fc-bulb\"><circle class=\"fc-glow\" cx=\"390\" cy=\"50\" r=\"46\"/><circle class=\"fc-bc\" cx=\"390\" cy=\"46\" r=\"20\"/><rect class=\"fc-bb\" x=\"381\" y=\"62\" width=\"18\" height=\"12\" rx=\"2\"/></g>\n            <path class=\"fc-in h\" d=\"M40 220 H 260\"/><path class=\"fc-in o\" d=\"M740 220 H 520\"/><path class=\"fc-out\" d=\"M505 360 V 392\"/>\n            <rect class=\"fc-box\" x=\"230\" y=\"120\" width=\"320\" height=\"240\" rx=\"18\"/>\n            <rect class=\"fc-ely\" x=\"290\" y=\"132\" width=\"200\" height=\"216\"/>\n            <rect class=\"fc-el neg\" x=\"260\" y=\"132\" width=\"30\" height=\"216\"/><rect class=\"fc-el pos\" x=\"490\" y=\"132\" width=\"30\" height=\"216\"/>\n            <text class=\"fc-t\" x=\"275\" y=\"112\">(−)극</text><text class=\"fc-t\" x=\"505\" y=\"112\">(+)극</text>\n            <text class=\"fc-s\" x=\"390\" y=\"340\">전해질</text>\n            <text class=\"fc-s\" x=\"140\" y=\"284\">수소 H₂</text><text class=\"fc-s\" x=\"640\" y=\"284\">산소 O₂</text><text class=\"fc-s\" x=\"560\" y=\"390\">물</text>\n            <g class=\"fc-valve\" data-g=\"h\" tabindex=\"0\" role=\"slider\" aria-label=\"수소 밸브: 바퀴를 돌려 연다(좌우 화살표 키)\"><rect class=\"fc-vbody\" x=\"116\" y=\"190\" width=\"48\" height=\"60\" rx=\"8\"/><rect class=\"fc-stem\" x=\"135\" y=\"150\" width=\"10\" height=\"42\"/><g class=\"dl-spin\"><circle class=\"fc-wheel\" cx=\"140\" cy=\"140\" r=\"38\"/><path class=\"fc-spoke\" d=\"M102 140 H 178 M140 102 V 178\"/><circle class=\"fc-knob\" cx=\"140\" cy=\"102\" r=\"7\"/></g><circle class=\"fc-hub\" cx=\"140\" cy=\"140\" r=\"9\"/></g>\n            <g class=\"fc-valve\" data-g=\"o\" tabindex=\"0\" role=\"slider\" aria-label=\"산소 밸브: 바퀴를 돌려 연다(좌우 화살표 키)\"><rect class=\"fc-vbody\" x=\"616\" y=\"190\" width=\"48\" height=\"60\" rx=\"8\"/><rect class=\"fc-stem\" x=\"635\" y=\"150\" width=\"10\" height=\"42\"/><g class=\"dl-spin\"><circle class=\"fc-wheel\" cx=\"640\" cy=\"140\" r=\"38\"/><path class=\"fc-spoke\" d=\"M602 140 H 678 M640 102 V 178\"/><circle class=\"fc-knob\" cx=\"640\" cy=\"102\" r=\"7\"/></g><circle class=\"fc-hub\" cx=\"640\" cy=\"140\" r=\"9\"/></g>\n            <text class=\"fc-vt\" data-g=\"h\" x=\"140\" y=\"88\">닫힘</text><text class=\"fc-vt\" data-g=\"o\" x=\"640\" y=\"88\">닫힘</text>\n            <g class=\"fc-parts\"></g>\n          </svg>\n        </div>\n      </div>\n      <div class=\"fx-col\">\n        <div class=\"fx-head\"><b>핵융합 연구 · KSTAR</b><span>도넛 모양 공간에 자기장으로 플라스마를 가둔다</span></div>\n        <div class=\"stage tk-stage\" data-prevent-swipe>\n          <canvas aria-label=\"토카막 3D: 1/4을 잘라 낸 도넛 모양 진공 용기 안에 플라스마 고리가 있고, 바깥 코일과 중심 코일이 자기장을 만든다. 끌어서 둘러본다\"></canvas>\n          <span class=\"g3-label tk-lab\" data-k=\"vessel\">진공 용기</span>\n          <span class=\"g3-label tk-lab\" data-k=\"plasma\">플라스마</span>\n          <span class=\"g3-label tk-lab\" data-k=\"coil\">자기장 코일</span>\n          <span class=\"g3-label tk-lab\" data-k=\"cs\">중심 코일</span>\n          <p data-edit=\"no3d-msg\" class=\"no3d-msg\">이 컴퓨터에서는 3D 그림을 그릴 수 없어요.</p>\n          <p data-edit=\"tk-say\" class=\"tk-say\" aria-live=\"polite\">자기장을 세게 해 보자</p>\n          <div class=\"tk-knob\">\n            <svg viewBox=\"0 0 200 150\" aria-hidden=\"false\">\n              <g class=\"tk-ticks\"><path d=\"M44.4 135.6 A 78 78 0 1 1 155.6 135.6\"/></g>\n              <text class=\"tk-kt\" x=\"34\" y=\"146\">약</text><text class=\"tk-kt\" x=\"166\" y=\"146\">강</text>\n              <g class=\"tk-dial\" tabindex=\"0\" role=\"slider\" aria-label=\"자기장 세기 손잡이(좌우 화살표 키)\"><circle class=\"tk-cap\" cx=\"100\" cy=\"80\" r=\"50\"/><g class=\"dl-spin\"><path class=\"tk-ptr\" d=\"M100 80 L 72 108\"/><circle class=\"tk-dot\" cx=\"72\" cy=\"108\" r=\"7\"/></g><circle class=\"tk-hub\" cx=\"100\" cy=\"80\" r=\"10\"/></g>\n            </svg>\n            <span>자기장 세기</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>에너지 문제를 풀기 위한 노력</b><span>핵융합: 가벼운 원자핵끼리 합쳐질 때 사라진 질량만큼 에너지가 나온다(2-2-1)</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-2-3.3.future */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (...p) => window.RxT.join(...p);\n  const dock = (root, cfg) => window.UDock.mount(root, cfg);\n  const pick = (sel) => (root) => { const rows = [...root.querySelectorAll(sel)]; root.querySelector('.gv').addEventListener('gv-pick', (e) => rows.forEach((x) => x.classList.toggle('on', x.dataset.k === e.detail.b.dataset.row))); return window.RxT.gallery(root); };\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));\n  const mix = (a, b, f) => { const A = hex(a), B = hex(b); return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * f)).join(',')})`; };\n\n  // 1. 표지: 시간이 흐르면 화석 연료가 줄고 이산화 탄소가 쌓인다. 신재생 에너지로 바꾸면 천천히 준다(정성적 그림)\n  part('tongsci2-2-2-3-3-future', (root) => J(window.FutureTech.mount(root), dock(root, {\n    steps: ['수소 밸브 열기', '산소 밸브 열기', 'KSTAR 자기장 세게'],\n    on: ['.fc-valve[data-g=\"h\"]', '.fc-valve[data-g=\"o\"]', '.tk-knob, .tk-dial'],\n    learn: '연료 전지는 수소 + 산소로 <b>전기</b>와 물을 만든다. 핵융합은 가벼운 원자핵이 합쳐질 때의 에너지를 쓰려는 연구다.',\n  })));\n})();\n","needs":["three","scene3d","future"],"media":{}}