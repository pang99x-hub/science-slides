{"id":"tongsci2.1-1-1.2.spec","unit":"tongsci2.1-1-1","html":"<!-- 5. 설명: 대표 화석 돌려 보기(3D) -->\n<section id=\"tongsci2-1-1-1-2-spec\" data-state=\"spec\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 16~17쪽 그림 I-3·I-5·I-7·I-9 · 시대의 대표 화석</div>\n        <h2 data-edit=\"h2\">대표 화석 돌려 보기</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">화석의 어디를 보면 알아볼까?</p>\n    </div>\n    <div class=\"t-body t-spec\">\n      <div class=\"sp-fig\" data-prevent-swipe>\n        <div class=\"stage sp-stage\">\n          <canvas tabindex=\"0\" aria-label=\"3D 화석 표본. 끌면 돌아가고, 바퀴나 두 손가락으로 크게 볼 수 있다. 이름표나 표본의 부분을 누르면 그 부분이 빛나고 오른쪽에 풀이가 나온다. 캔버스에 초점을 두고 화살표로 돌리고 +−로 키운다\"></canvas>\n          <div class=\"sp-labs\"></div>\n          <p data-edit=\"sp-hint\" class=\"sp-hint\">끌어서 돌리기 · 바퀴·두 손가락으로 크게 · 이름표 누르기</p>\n          <div class=\"sp-btns\"><button type=\"button\" class=\"btn sp-tog\" aria-pressed=\"false\" hidden></button><button type=\"button\" class=\"btn sp-home\">처음 시점</button></div>\n          <p data-edit=\"no3d-msg\" class=\"no3d-msg\">이 컴퓨터에서는 3D 그림을 그릴 수 없어요. 오른쪽 사진으로 살펴보세요.</p>\n        </div>\n        <div class=\"sp-pick\" role=\"group\" aria-label=\"표본 고르기\">\n          <button type=\"button\" data-k=\"strom\" aria-pressed=\"false\"><small>선캄브리아시대</small>스트로마톨라이트</button>\n          <button type=\"button\" data-k=\"trilo\" aria-pressed=\"false\"><small>고생대</small>삼엽충</button>\n          <button type=\"button\" data-k=\"ammo\" aria-pressed=\"false\"><small>중생대</small>암모나이트</button>\n          <button type=\"button\" data-k=\"nummu\" aria-pressed=\"false\"><small>신생대</small>화폐석</button>\n        </div>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"tcard sp-info\">\n          <span data-edit=\"t-tag-1\" class=\"t-tag sp-era\">고생대</span>\n          <h3 data-edit=\"sp-name\" class=\"sp-name\">삼엽충</h3>\n          <p class=\"sp-where-l\">살던 곳: <span class=\"sp-where\"></span></p>\n          <p class=\"sp-d\"></p>\n        </div>\n        <div class=\"tcard sp-part\" aria-live=\"polite\"><span data-edit=\"t-tag-2\" class=\"t-tag\">누른 부분</span><h3 class=\"sp-pn\"></h3><p class=\"sp-pd\"></p></div>\n        <figure class=\"sp-photo\"><img alt=\"\"><small class=\"cr\"></small></figure>\n      </div>\n    </div>\n    <div class=\"sp-store\" hidden>\n      <img data-k=\"strom\" src=\"@@ERA_STROM_FOS@@\" alt=\"얇은 층이 겹겹이 쌓인 스트로마톨라이트 화석 단면\" data-cr=\"James St. John · CC BY 2.0\">\n      <img data-k=\"trilo\" src=\"@@FS_TRI@@\" alt=\"몸이 세 갈래로 나뉜 삼엽충 화석\" data-cr=\"Wilson44691 · 퍼블릭 도메인\">\n      <img data-k=\"ammo\" src=\"@@FS_AMM@@\" alt=\"나선 모양 껍데기에 주름이 있는 암모나이트 화석\" data-cr=\"Becks · CC BY 2.0\">\n      <img data-k=\"nummu\" src=\"@@FS_NUM@@\" alt=\"동전처럼 납작한 화폐석 화석 여러 개\" data-cr=\"Wilson44691 · 퍼블릭 도메인\">\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 16~17쪽</b><span>3D 표본은 특징을 살려 만든 모형(크기·비율은 이해를 돕기 위한 예) · 실제 화석 사진: 위키미디어 공용</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.2.spec */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 시대 풍경 순서 맞추기 + 예측(한 번 넘기면 답 표시)\n  const EVID = ['fold', 'coal', 'ash', 'glac'];\n  part('tongsci2-1-1-1-2-spec', (root) => window.Fossil3D.mount(root));\n\n  // 6. 체험: 시간 돋보기 → ①생물 화석 ②땅속 증거 ③세 시대 이상\n})();\n","needs":["scene3d","three","fossil3d"],"media":{"ERA_STROM_FOS":"era-strom-fos.webp","FS_TRI":"fs-tri.webp","FS_AMM":"fs-amm.webp","FS_NUM":"fs-num.webp"}}