{"id":"tongsci2.2-2-1.2.convert","unit":"tongsci2.2-2-1","html":"<!-- 2. 에너지 전환 -->\n<section id=\"tongsci2-2-2-1-2-convert\" data-state=\"convert\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 100쪽 · 에너지 전환</div>\n        <h2 data-edit=\"h2\">에너지는 모습을 바꾼다</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">알맞은 에너지를 고르면 기구가 움직인다</p>\n    </div>\n    <div class=\"body two\" style=\"--left: 1000px\">\n      <div class=\"conv-left\">\n        <div class=\"def soft fragment custom\" data-anim=\"mark\" data-fragment-index=\"0\"><p>한 가지 모습의 에너지가 다른 모습으로 바뀌는 것 → <span data-edit=\"mark\" class=\"mark\"><b>에너지 전환</b></span></p></div>\n        <div class=\"stage conv-stage\" data-prevent-swipe>\n          <svg class=\"cv-svg\" viewBox=\"0 0 1000 680\" role=\"img\" aria-label=\"고른 기구로 에너지가 들어가 다른 에너지로 나오는 실험대\">\n            <defs>\n              <radialGradient id=\"cv-bulb\"><stop offset=\"0\" stop-color=\"#fffbe0\"/><stop offset=\".45\" stop-color=\"#ffe682\"/><stop offset=\"1\" stop-color=\"#f5cf3a\" stop-opacity=\"0\"/></radialGradient>\n              <radialGradient id=\"cv-warm\"><stop offset=\"0\" stop-color=\"#ffc3a3\"/><stop offset=\".5\" stop-color=\"#ef8a63\" stop-opacity=\".7\"/><stop offset=\"1\" stop-color=\"#d9482b\" stop-opacity=\"0\"/></radialGradient>\n              <symbol id=\"ic-fan\" viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"17\" r=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"/><path d=\"M20 17c-2-7 3-10 6-6s-3 6-6 6zm0 0c7 1 7 7 2 8s-4-6-2-8zm0 0c-5 5-11 2-9-2s8-1 9 2z\" fill=\"currentColor\"/><path d=\"M20 30v6M13 37h14\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></symbol>\n              <symbol id=\"ic-lamp\" viewBox=\"0 0 40 40\"><path d=\"M20 4a11 11 0 0 0-6 20v5h12v-5A11 11 0 0 0 20 4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"/><path d=\"M15 32h10M16 36h8\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></symbol>\n              <symbol id=\"ic-phone\" viewBox=\"0 0 40 40\"><rect x=\"11\" y=\"3\" width=\"18\" height=\"34\" rx=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"/><rect x=\"16\" y=\"12\" width=\"8\" height=\"14\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"17.5\" y=\"18\" width=\"5\" height=\"6.5\" fill=\"currentColor\"/></symbol>\n              <symbol id=\"ic-car\" viewBox=\"0 0 40 40\"><path d=\"M5 26v-6l5-7h16l7 7h3v6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"27\" r=\"4\" fill=\"currentColor\"/><circle cx=\"29\" cy=\"27\" r=\"4\" fill=\"currentColor\"/></symbol>\n              <symbol id=\"ic-warm\" viewBox=\"0 0 40 40\"><rect x=\"10\" y=\"10\" width=\"20\" height=\"24\" rx=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"/><path d=\"M15 7c0-3 3-3 3-6M22 7c0-3 3-3 3-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n            </defs>\n            <!-- 작업대 -->\n            <rect class=\"cv-bench\" x=\"16\" y=\"560\" width=\"968\" height=\"22\" rx=\"11\"/>\n            <text class=\"cv-zone\" x=\"130\" y=\"610\">들어가는 에너지</text>\n            <text class=\"cv-zone\" x=\"500\" y=\"610\">기구</text>\n            <text class=\"cv-zone\" x=\"868\" y=\"610\">나오는 에너지</text>\n            <!-- 에너지 관: 바깥(테두리)·안(종이)·흐름(색 점) -->\n            <g class=\"pipe pipe-a\"><path class=\"p-wall\" d=\"M220 470 C 270 470, 280 400, 330 400\"/><path class=\"p-in\" d=\"M220 470 C 270 470, 280 400, 330 400\"/><path class=\"p-flow\" d=\"M220 470 C 270 470, 280 400, 330 400\"/></g>\n            <g class=\"pipe pipe-b\"><path class=\"p-wall\" d=\"M670 330 L 772 330\"/><path class=\"p-in\" d=\"M670 330 L 772 330\"/><path class=\"p-flow\" d=\"M670 330 L 772 330\"/></g>\n\n            <!-- 들어가는 쪽 -->\n            <g class=\"inp\" data-in=\"elec\">\n              <rect x=\"56\" y=\"380\" width=\"128\" height=\"170\" rx=\"16\" class=\"cv-wall\"/>\n              <rect x=\"86\" y=\"420\" width=\"16\" height=\"34\" rx=\"5\" class=\"cv-dark\"/><rect x=\"138\" y=\"420\" width=\"16\" height=\"34\" rx=\"5\" class=\"cv-dark\"/>\n              <circle cx=\"120\" cy=\"498\" r=\"11\" class=\"cv-dark\"/>\n              <rect x=\"150\" y=\"440\" width=\"60\" height=\"58\" rx=\"10\" class=\"cv-plug\"/>\n              <path d=\"M210 469h14\" class=\"cv-cord\"/>\n              <path class=\"cv-bolt\" d=\"M108 302 L 86 346 h 26 l -14 40 l 44 -56 h -26 l 16 -30 z\"/>\n            </g>\n            <g class=\"inp\" data-in=\"fuel\">\n              <path d=\"M70 410 h 96 a 10 10 0 0 1 10 10 v 120 a 10 10 0 0 1 -10 10 h -96 a 10 10 0 0 1 -10 -10 v -120 a 10 10 0 0 1 10 -10 z\" class=\"cv-can\"/>\n              <path d=\"M140 410 v -24 h 26 l 14 18\" class=\"cv-can-neck\"/>\n              <path d=\"M84 440 l 60 60 M144 440 l -60 60\" class=\"cv-can-x\"/>\n              <text class=\"cv-small\" x=\"118\" y=\"532\">휘발유</text>\n              <path d=\"M178 470 h 46\" class=\"cv-cord\"/>\n              <g class=\"cv-mol\"><circle cx=\"96\" cy=\"330\" r=\"16\"/><circle cx=\"126\" cy=\"318\" r=\"12\"/><circle cx=\"148\" cy=\"344\" r=\"14\"/><path d=\"M110 326 l 6 -4 M138 330 l 4 6\"/></g>\n            </g>\n            <g class=\"inp\" data-in=\"pack\">\n              <g class=\"cv-mol\"><circle cx=\"90\" cy=\"440\" r=\"22\"/><circle cx=\"130\" cy=\"422\" r=\"16\"/><circle cx=\"150\" cy=\"466\" r=\"20\"/><circle cx=\"106\" cy=\"486\" r=\"14\"/><path d=\"M110 432 l 8 -4 M140 440 l 4 8 M124 482 l 10 -6\"/></g>\n              <text class=\"cv-small\" x=\"120\" y=\"530\">철가루 + 산소</text>\n            </g>\n\n            <!-- 기구 -->\n            <g class=\"dev\" data-dev=\"fan\">\n              <path class=\"wind-line\" d=\"M650 220 q 40 -20 80 0\"/><path class=\"wind-line\" d=\"M660 270 q 40 -20 80 0\"/><path class=\"wind-line\" d=\"M650 320 q 40 -20 80 0\"/>\n              <ellipse cx=\"500\" cy=\"548\" rx=\"120\" ry=\"16\" class=\"cv-wall\"/>\n              <rect x=\"489\" y=\"392\" width=\"22\" height=\"156\" class=\"cv-wall\"/>\n              <rect x=\"462\" y=\"376\" width=\"76\" height=\"40\" rx=\"12\" class=\"cv-wall\"/>\n              <circle cx=\"500\" cy=\"250\" r=\"138\" class=\"cv-cage\"/>\n              <path class=\"cv-cage-sp\" d=\"M500 112v276M362 250h276M402 152l196 196M598 152L402 348\"/>\n              <g class=\"blades\">\n                <path d=\"M500 250 C 470 190, 490 130, 528 150 C 560 168, 530 230, 500 250 Z\"/>\n                <path d=\"M500 250 C 470 190, 490 130, 528 150 C 560 168, 530 230, 500 250 Z\" transform=\"rotate(120 500 250)\"/>\n                <path d=\"M500 250 C 470 190, 490 130, 528 150 C 560 168, 530 230, 500 250 Z\" transform=\"rotate(240 500 250)\"/>\n                <circle cx=\"500\" cy=\"250\" r=\"22\" class=\"cv-hub\"/>\n              </g>\n            </g>\n            <g class=\"dev\" data-dev=\"lamp\">\n              <circle cx=\"500\" cy=\"240\" r=\"230\" fill=\"url(#cv-bulb)\" class=\"glow\"/>\n              <g class=\"rays\"><path d=\"M500 30v-22M500 470v22M290 240h-22M710 240h22M352 92l-16-16M648 92l16-16M352 388l-16 16M648 388l16 16\"/></g>\n              <path d=\"M500 96 a 128 128 0 0 0 -74 232 c 18 16 24 34 24 52 h 100 c 0 -18 6 -36 24 -52 A 128 128 0 0 0 500 96 z\" class=\"cv-glass\"/>\n              <path d=\"M466 380 v -70 l 14 -50 l 10 30 l 10 -30 l 10 30 l 10 -30 l 14 50 v 70\" class=\"cv-fil\"/>\n              <rect x=\"446\" y=\"380\" width=\"108\" height=\"26\" rx=\"6\" class=\"cv-wall\"/><rect x=\"452\" y=\"406\" width=\"96\" height=\"22\" rx=\"6\" class=\"cv-wall\"/><rect x=\"458\" y=\"428\" width=\"84\" height=\"22\" rx=\"6\" class=\"cv-wall\"/>\n              <path d=\"M484 450 h 32 l -6 22 h -20 z\" class=\"cv-dark\"/>\n            </g>\n            <g class=\"dev\" data-dev=\"phone\">\n              <rect x=\"400\" y=\"96\" width=\"200\" height=\"380\" rx=\"32\" class=\"cv-phone\"/>\n              <rect x=\"416\" y=\"128\" width=\"168\" height=\"316\" rx=\"12\" class=\"cv-screen\"/>\n              <rect x=\"458\" y=\"196\" width=\"84\" height=\"170\" rx=\"12\" class=\"cv-batt\"/>\n              <rect x=\"482\" y=\"182\" width=\"36\" height=\"14\" rx=\"4\" class=\"cv-dark\"/>\n              <rect x=\"466\" y=\"204\" width=\"68\" height=\"154\" rx=\"6\" class=\"batt-bg\"/>\n              <rect x=\"466\" y=\"204\" width=\"68\" height=\"154\" rx=\"6\" class=\"batt-fill\"/>\n              <text class=\"batt-pct\" x=\"500\" y=\"410\">20%</text>\n              <path d=\"M500 476 v 40 q 0 30 -40 30 h -60\" class=\"cv-cord\"/>\n            </g>\n            <g class=\"dev\" data-dev=\"car\">\n              <rect x=\"300\" y=\"500\" width=\"420\" height=\"44\" rx=\"6\" class=\"cv-road\"/>\n              <clipPath id=\"cv-road-clip\"><rect x=\"300\" y=\"500\" width=\"420\" height=\"44\"/></clipPath><g clip-path=\"url(#cv-road-clip)\"><g class=\"road-dash\"><path d=\"M300 522 h 50 M390 522 h 50 M480 522 h 50 M570 522 h 50 M660 522 h 50 M750 522 h 50\"/></g></g>\n              <g class=\"car-body\">\n                <path d=\"M330 470 v -64 a 14 14 0 0 1 14 -14 h 70 l 52 -64 h 112 l 70 64 h 52 a 14 14 0 0 1 14 14 v 64 z\" class=\"cv-car\"/>\n                <path d=\"M486 336 h 88 l 48 50 h -168 z\" class=\"cv-win\"/>\n                <path d=\"M572 336 v 50\" class=\"cv-cord\" style=\"stroke-width:4\"/>\n                <rect x=\"346\" y=\"410\" width=\"60\" height=\"22\" rx=\"6\" class=\"cv-dark\"/>\n                <text class=\"cv-small\" x=\"376\" y=\"384\">엔진</text>\n              </g>\n              <g class=\"wheel\" data-c=\"410 474\"><circle cx=\"410\" cy=\"474\" r=\"44\" class=\"cv-tire\"/><circle cx=\"410\" cy=\"474\" r=\"20\" class=\"cv-rim\"/><path d=\"M410 438v72M374 474h72\" class=\"cv-spoke\"/></g>\n              <g class=\"wheel\" data-c=\"618 474\"><circle cx=\"618\" cy=\"474\" r=\"44\" class=\"cv-tire\"/><circle cx=\"618\" cy=\"474\" r=\"20\" class=\"cv-rim\"/><path d=\"M618 438v72M582 474h72\" class=\"cv-spoke\"/></g>\n              <g class=\"motion\"><path d=\"M286 410h-40M296 440h-56M286 470h-40\"/></g>\n            </g>\n            <g class=\"dev\" data-dev=\"warmer\">\n              <circle cx=\"500\" cy=\"300\" r=\"220\" fill=\"url(#cv-warm)\" class=\"glow\"/>\n              <g class=\"heat-waves\"><path d=\"M450 196 c -14 -20 14 -30 0 -50 s 14 -30 0 -50\"/><path d=\"M500 186 c -14 -20 14 -30 0 -50 s 14 -30 0 -50\"/><path d=\"M550 196 c -14 -20 14 -30 0 -50 s 14 -30 0 -50\"/></g>\n              <path d=\"M300 420 c -20 -60 -10 -150 40 -170 c 20 -8 30 10 26 30 l -10 70 c 40 -10 60 10 60 40 v 60 c 0 30 -30 50 -60 50 h -40 c -10 0 -14 -40 -16 -80 z\" class=\"cv-hand\"/>\n              <path d=\"M700 420 c 20 -60 10 -150 -40 -170 c -20 -8 -30 10 -26 30 l 10 70 c -40 -10 -60 10 -60 40 v 60 c 0 30 30 50 60 50 h 40 c 10 0 14 -40 16 -80 z\" class=\"cv-hand\"/>\n              <rect x=\"418\" y=\"214\" width=\"164\" height=\"224\" rx=\"30\" class=\"cv-pack\"/>\n              <g class=\"cv-dots\"><circle cx=\"450\" cy=\"260\" r=\"4\"/><circle cx=\"490\" cy=\"250\" r=\"4\"/><circle cx=\"530\" cy=\"266\" r=\"4\"/><circle cx=\"470\" cy=\"300\" r=\"4\"/><circle cx=\"520\" cy=\"310\" r=\"4\"/><circle cx=\"550\" cy=\"296\" r=\"4\"/><circle cx=\"452\" cy=\"350\" r=\"4\"/><circle cx=\"500\" cy=\"356\" r=\"4\"/><circle cx=\"546\" cy=\"380\" r=\"4\"/></g>\n              <text class=\"cv-small\" x=\"500\" y=\"414\">손난로</text>\n            </g>\n\n            <!-- 나오는 쪽: 고른 에너지 -->\n            <g class=\"out\" data-out=\"light\"><circle cx=\"868\" cy=\"330\" r=\"44\" class=\"o-light\"/><g class=\"o-rays\"><path d=\"M868 262v-26M868 398v26M800 330h-26M936 330h26M820 282l-18-18M916 378l18 18M916 282l18-18M820 378l-18 18\"/></g></g>\n            <g class=\"out\" data-out=\"heat\"><circle cx=\"868\" cy=\"360\" r=\"40\" class=\"o-heat\"/><g class=\"o-waves\"><path d=\"M840 300 c -12 -18 12 -28 0 -46 s 12 -28 0 -46\"/><path d=\"M868 292 c -12 -18 12 -28 0 -46 s 12 -28 0 -46\"/><path d=\"M896 300 c -12 -18 12 -28 0 -46 s 12 -28 0 -46\"/></g></g>\n            <g class=\"out\" data-out=\"chem\"><rect x=\"830\" y=\"262\" width=\"76\" height=\"136\" rx=\"12\" class=\"o-batt\"/><rect x=\"852\" y=\"248\" width=\"32\" height=\"14\" rx=\"4\" class=\"cv-dark\"/><rect x=\"838\" y=\"270\" width=\"60\" height=\"120\" rx=\"6\" class=\"o-batt-fill\"/><path d=\"M876 300 l -16 30 h 14 l -6 26 l 20 -34 h -14 l 8 -22 z\" class=\"o-bolt\"/></g>\n            <g class=\"out\" data-out=\"elec\"><path d=\"M880 236 L 840 330 h 34 l -18 88 l 56 -110 h -34 l 26 -72 z\" class=\"o-elec\"/></g>\n            <g class=\"out\" data-out=\"kin\"><path d=\"M868 262 a 68 68 0 1 1 -66 52\" class=\"o-spin\"/><path d=\"M790 300 l 12 18 l 18 -12\" class=\"o-spin\"/><circle cx=\"868\" cy=\"330\" r=\"16\" class=\"o-kin\"/></g>\n            <g class=\"out\" data-out=\"pot\"><path d=\"M868 420 v -150\" class=\"o-up\"/><path d=\"M846 292 l 22 -26 l 22 26\" class=\"o-up\"/><rect x=\"836\" y=\"380\" width=\"64\" height=\"44\" rx=\"6\" class=\"o-box\"/></g>\n            <g class=\"out-x\"><path d=\"M836 298 l 64 64 M900 298 l -64 64\"/></g>\n\n            <!-- 알림줄 -->\n            <g class=\"cv-msg\"><rect x=\"40\" y=\"18\" width=\"920\" height=\"58\" rx=\"29\"/><text x=\"500\" y=\"57\">오른쪽에서 나오는 에너지를 골라 보세요</text></g>\n            <text class=\"cv-tag cv-tag-in\" x=\"130\" y=\"648\">전기 에너지</text>\n            <text class=\"cv-tag cv-tag-out\" x=\"868\" y=\"648\">?</text>\n          </svg>\n        </div>\n      </div>\n      <div class=\"sort conv-sort\">\n        <ol class=\"u-steps\"><li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 기구 줄을 하나 고른다</li><li data-edit=\"li-2\" data-s=\"2\"><b>②</b> 나오는 에너지를 골라 기구를 움직인다</li><li data-edit=\"li-3\" data-s=\"3\"><b>③</b> 다섯 기구를 모두 움직인다</li></ol>\n        <div class=\"quiz-head\"><div class=\"panel-label\">기구를 고르고, 나오는 에너지를 골라요</div><button class=\"btn\" type=\"button\" id=\"conv-show\">정답 보기</button></div>\n        <div class=\"sort-rows\">\n          <div class=\"pred\" data-row=\"1\" data-a=\"kin\" data-from=\"elec\" data-in=\"elec\" data-dev=\"fan\" data-name=\"선풍기\" data-hint=\"날개가 돌아야 바람이 와요. 도는 것은 어떤 에너지?\"><span class=\"it\"><svg class=\"ic\"><use href=\"#ic-fan\"/></svg>선풍기 <small>전기 →</small></span><div class=\"seg seg6\" role=\"group\" aria-label=\"선풍기\"><button type=\"button\" data-v=\"light\">빛</button><button type=\"button\" data-v=\"heat\">열</button><button type=\"button\" data-v=\"chem\">화학</button><button type=\"button\" data-v=\"elec\">전기</button><button type=\"button\" data-v=\"kin\">운동</button><button type=\"button\" data-v=\"pot\">위치</button></div></div>\n          <div class=\"pred\" data-row=\"2\" data-a=\"light\" data-from=\"elec\" data-in=\"elec\" data-dev=\"lamp\" data-name=\"전등\" data-hint=\"전등을 켜는 까닭은 무엇을 얻으려고일까요?\"><span class=\"it\"><svg class=\"ic\"><use href=\"#ic-lamp\"/></svg>전등 <small>전기 →</small></span><div class=\"seg seg6\" role=\"group\" aria-label=\"전등\"><button type=\"button\" data-v=\"light\">빛</button><button type=\"button\" data-v=\"heat\">열</button><button type=\"button\" data-v=\"chem\">화학</button><button type=\"button\" data-v=\"elec\">전기</button><button type=\"button\" data-v=\"kin\">운동</button><button type=\"button\" data-v=\"pot\">위치</button></div></div>\n          <div class=\"pred\" data-row=\"3\" data-a=\"chem\" data-from=\"elec\" data-in=\"elec\" data-dev=\"phone\" data-name=\"휴대폰 충전\" data-hint=\"충전한 에너지는 배터리 속 물질에 저장돼요.\"><span class=\"it\"><svg class=\"ic\"><use href=\"#ic-phone\"/></svg>휴대폰 충전 <small>전기 →</small></span><div class=\"seg seg6\" role=\"group\" aria-label=\"휴대폰 충전\"><button type=\"button\" data-v=\"light\">빛</button><button type=\"button\" data-v=\"heat\">열</button><button type=\"button\" data-v=\"chem\">화학</button><button type=\"button\" data-v=\"elec\">전기</button><button type=\"button\" data-v=\"kin\">운동</button><button type=\"button\" data-v=\"pot\">위치</button></div></div>\n          <div class=\"pred\" data-row=\"4\" data-a=\"kin\" data-from=\"chem\" data-in=\"fuel\" data-dev=\"car\" data-name=\"자동차 엔진\" data-hint=\"엔진이 하는 일은 바퀴를 굴리는 것이에요.\"><span class=\"it\"><svg class=\"ic\"><use href=\"#ic-car\"/></svg>자동차 엔진 <small>화학 →</small></span><div class=\"seg seg6\" role=\"group\" aria-label=\"자동차 엔진\"><button type=\"button\" data-v=\"light\">빛</button><button type=\"button\" data-v=\"heat\">열</button><button type=\"button\" data-v=\"chem\">화학</button><button type=\"button\" data-v=\"elec\">전기</button><button type=\"button\" data-v=\"kin\">운동</button><button type=\"button\" data-v=\"pot\">위치</button></div></div>\n          <div class=\"pred\" data-row=\"5\" data-a=\"heat\" data-from=\"chem\" data-in=\"pack\" data-dev=\"warmer\" data-name=\"손난로\" data-hint=\"손난로를 쥐면 손이 어떻게 되나요?\"><span class=\"it\"><svg class=\"ic\"><use href=\"#ic-warm\"/></svg>손난로 <small>화학 →</small></span><div class=\"seg seg6\" role=\"group\" aria-label=\"손난로\"><button type=\"button\" data-v=\"light\">빛</button><button type=\"button\" data-v=\"heat\">열</button><button type=\"button\" data-v=\"chem\">화학</button><button type=\"button\" data-v=\"elec\">전기</button><button type=\"button\" data-v=\"kin\">운동</button><button type=\"button\" data-v=\"pot\">위치</button></div></div>\n        </div>\n        <p class=\"sort-score pen\" aria-live=\"polite\"></p>\n        <p data-edit=\"conv-note\" class=\"conv-note\">실제 기구에서는 여러 에너지가 함께 나와요(전등도 뜨거워진다). 여기서는 <b>쓰려고 하는 에너지</b>를 골라요.</p>\n        <div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p\">기구는 들어온 에너지를 <b>다른 형태</b>로 바꿔 내보낸다 → <b>에너지 전환</b>.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 100쪽</b><span>에너지 전환</span></div>\n  <aside class=\"notes\">\n체험 «에너지는 모습을 바꾼다» (6분) — 해 볼 일 ①②③, 다섯 기구를 모두 움직이면 «알게 된 것»\n- → 한 번: 에너지 전환의 뜻에 형광펜.\n- 오른쪽에서 기구 줄을 누르면 왼쪽 실험대에 그 기구가 놓인다(콘센트·휘발유·철가루에서 에너지가 관을 따라 들어간다).\n- 나오는 에너지를 고르면 바로 확인된다: 맞으면 기구가 움직이고(선풍기 날개, 전등 빛, 배터리 충전, 자동차 바퀴, 손난로 열) 나오는 관에 그 에너지 색이 흐른다. 틀리면 기구가 멈춘 채 힌트가 뜬다.\n- 수업방이 열려 있으면 줄마다 학생이 고른 수가 모인다. «정답 보기»로 모든 줄의 답을 표시.\n- 답: 선풍기 운동, 전등 빛, 휴대폰 충전 화학(배터리에 저장), 자동차 엔진 운동, 손난로 열.\n  </aside>\n</section>","css":"\n","js":"/* tongsci2.2-2-1.2.convert */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { tok } = window.Stage;\n  const L1 = window.L1;\n  // 체험 장 해 볼 일 ①②③(2-1-1 frame.js 방식): 지금 단계 번호(0 = 끝). 기존 조작 모듈은 고치지 않고 상태를 읽어 맞춘다\n  const mark = (root, n, max = 3) => { const ok = []; for (let k = 1; k <= max; k++) if (n === 0 || k < n) ok.push(k); L1.steps(root, n, ok); L1.done(root, n === 0); };\n  const watch = (root, fn) => { let id = 0; const run = () => mark(root, fn()); run(); return { setActive(on) { clearInterval(id); if (on) id = setInterval(run, 250); run(); } }; };\n  const join = (...ps) => window.RxT.join(...ps);\n  const NAME = { light: '빛에너지', heat: '열에너지', chem: '화학 에너지', elec: '전기 에너지', kin: '운동 에너지', pot: '위치 에너지' };\n  // 한 묶음에서 하나만 누르게(다시 누르면 풀림)\n  const single = (btns, after) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n    if (after) after(b);\n  }));\n\n  // 1. 표지: 예측 하나 · 거슬러 올라가기(→ 한 번에 한 칸: 길이 거꾸로 그려지고 더 먼 출처가 나타난다).\n  //    태양까지 닿으면 태양 → 식물 → 석탄 → 발전소 → 휴대폰으로 에너지가 흐른다\n  part('tongsci2-2-2-1-2-convert', (root) => {\n    const rows = [...root.querySelectorAll('.sort-rows .pred')];\n    const score = root.querySelector('.sort-score');\n    const svg = root.querySelector('.cv-svg'), all = (s) => svg.querySelectorAll(s);\n    const msg = svg.querySelector('.cv-msg'), msgT = msg.querySelector('text');\n    const tagIn = svg.querySelector('.cv-tag-in'), tagOut = svg.querySelector('.cv-tag-out');\n    const pct = svg.querySelector('.batt-pct');\n    const pipeA = svg.querySelector('.pipe-a'), pipeB = svg.querySelector('.pipe-b'), outX = svg.querySelector('.out-x');\n    let shown = false, cur = rows[0];\n    const pick = (r) => { const b = r.querySelector('button[aria-pressed=\"true\"]'); return b ? b.dataset.v : null; };\n    function show(shake) {\n      rows.forEach((r) => r.classList.toggle('cur', r === cur));\n      const d = cur.dataset, to = shown ? d.a : pick(cur), right = to === d.a;\n      all('.inp').forEach((g) => g.classList.toggle('on', g.dataset.in === d.in));\n      all('.dev').forEach((g) => { const on = g.dataset.dev === d.dev; g.classList.toggle('on', on); g.classList.toggle('go', on && right); });\n      all('.out').forEach((g) => { const on = g.dataset.out === to; g.classList.toggle('on', on); g.classList.toggle('go', on && right); g.classList.toggle('dim', on && !right); });\n      outX.classList.toggle('on', !!to && !right);\n      pipeA.style.setProperty('--fc', `var(--e-${d.from})`); pipeA.classList.add('run');\n      pipeB.style.setProperty('--fc', right ? `var(--e-${to})` : 'var(--rule)'); pipeB.classList.toggle('run', right);\n      tagIn.textContent = NAME[d.from]; tagOut.textContent = to ? NAME[to] : '?';\n      pct.textContent = d.dev === 'phone' && right ? '충전 중' : '20%';\n      msg.classList.toggle('ok', right); msg.classList.toggle('no', !!to && !right);\n      msgT.textContent = !to ? `${d.name}: 나오는 에너지를 골라 보세요` : right ? `✓ ${d.name} — ${NAME[d.from]} → ${NAME[to]}` : `✕ 멈췄어요. ${d.hint}`;\n      if (shake && to && !right) { const dev = svg.querySelector('.dev.on'); dev.classList.remove('no'); dev.getBoundingClientRect(); dev.classList.add('no'); }\n    }\n    const grade = () => {\n      if (!shown) return;\n      let ok = 0;\n      rows.forEach((r) => {\n        const p = pick(r), right = p === r.dataset.a; if (right) ok++;\n        r.classList.toggle('ok', right); r.classList.toggle('no', !!p && !right);\n        r.querySelectorAll('button').forEach((b) => b.classList.toggle('answer', b.dataset.v === r.dataset.a));\n      });\n      score.textContent = `맞힌 줄 ${ok} / ${rows.length}`;\n    };\n    rows.forEach((r) => {\n      const btns = [...r.querySelectorAll('.seg button')];\n      btns.forEach((b) => b.setAttribute('aria-pressed', 'false'));\n      single(btns, () => { cur = r; grade(); show(true); });\n      r.addEventListener('click', (e) => { if (!e.target.closest('button')) { cur = r; show(); } });\n    });\n    root.querySelector('#conv-show').addEventListener('click', () => { shown = true; grade(); show(); });\n    show();\n    // 해 볼 일: ① 줄 고르기 ② 맞는 에너지로 기구 움직이기 ③ 다섯 모두\n    let touched = false;\n    root.querySelector('.sort-rows').addEventListener('click', () => { touched = true; });\n    return watch(root, () => {\n      const ok = rows.filter((r) => pick(r) === r.dataset.a).length;\n      return ok === rows.length || shown ? 0 : ok > 0 ? 3 : touched ? 2 : 1;\n    });\n  });\n\n  // 3. 설명: 햇빛을 모아 두는 방법(사진) — 누른 사진에 맞는 왼쪽 상자가 밝아진다\n})();\n","needs":[],"media":{}}