{"id":"tongsci2.2-1-1.2.a2b","unit":"tongsci2.2-1-1","html":"<!-- 2. 이론: 환경이 생물에 주는 영향(사진) -->\n<section id=\"tongsci2-2-1-1-2-a2b\" data-state=\"a2b\" class=\"std l1t\" data-word=\"환경에 맞춰 생김새가 바뀐 생물 하나\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 74쪽 그림 Ⅱ-3 · 환경이 생물에 주는 영향</div>\n        <h2 data-edit=\"h2\">환경이 생물을 바꾼다</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">국화는 왜 가을에, 여우 귀는 왜 클까?</p>\n    </div>\n    <div class=\"t-body t-hist t-a2b\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def\"><span data-edit=\"t-tag-1\" class=\"t-tag\">비생물요소 → 생물요소</span><p data-edit=\"p-1\">빛·공기·온도·물·토양은 생물의 <b>생활 방식</b>·<b>번식</b>·<b>사는 곳</b>에 영향을 준다</p></div>\n        <div class=\"tcard th-def\"><span data-edit=\"t-tag-2\" class=\"t-tag\">적응</span><p data-edit=\"p-2\">생물이 오랜 세월 그 <b>환경에 맞는</b> 생김새·생활을 갖추는 것</p></div>\n        <div class=\"tcard ab-tab\">\n          <div class=\"ab-row hs-row\" data-k=\"light\"><span class=\"chip f-light\">빛</span><p data-edit=\"p-3\">국화는 <b>낮이 짧아질</b> 때 꽃이 핀다</p></div>\n          <div class=\"ab-row hs-row\" data-k=\"temp\"><span class=\"chip f-temp\">온도</span><p data-edit=\"p-4\">사막여우: 작은 몸, <b>큰 귀</b></p></div>\n          <div class=\"ab-row hs-row\" data-k=\"water\"><span class=\"chip f-water\">물</span><p data-edit=\"p-5\">선인장의 잎은 <b>가시</b>로 바뀌었다</p></div>\n          <div class=\"ab-row hs-row\" data-k=\"soil\"><span class=\"chip f-soil\">토양</span><p data-edit=\"p-6\">함초는 짠 땅에서도 <b>물을 빨아들인다</b></p></div>\n        </div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs g6\" role=\"group\" aria-label=\"사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"light\" data-name=\"국화\" data-chip=\"빛\" data-kind=\"f-light\" data-d=\"여름에는 잎만 자라다가 <b>낮이 짧아지는</b> 가을에 꽃을 피운다.\" data-cr=\"Sridhar Rao · CC BY-SA 4.0\"><img src=\"@@AD_MUM@@\" alt=\"노랗게 활짝 핀 국화꽃\"><span>국화</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"temp\" data-name=\"사막여우\" data-chip=\"온도\" data-kind=\"f-temp\" data-d=\"더운 사막에 산다. 몸집이 작고 <b>귀가 커서</b> 몸의 열을 잘 내보낸다.\" data-cr=\"Drew Avery · CC BY 2.0\"><img src=\"@@AD_FENNEC@@\" alt=\"귀가 아주 큰 사막여우\"><span>사막여우</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"temp\" data-name=\"북극여우\" data-chip=\"온도\" data-kind=\"f-temp\" data-d=\"추운 곳에 산다. 사막여우보다 몸집이 크고 <b>귀가 작아</b> 열을 덜 잃는다.\" data-cr=\"Jonatan Pie · CC0\"><img src=\"@@AD_ARCTIC@@\" alt=\"흰 털로 덮인 북극여우\"><span>북극여우</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"water\" data-name=\"선인장\" data-chip=\"물\" data-kind=\"f-water\" data-d=\"비가 드문 곳에 산다. 잎이 <b>가시</b>로 바뀌어 물을 덜 잃고, 줄기에 물을 모아 둔다.\" data-cr=\"dconvertini · CC BY-SA 2.0\"><img src=\"@@AD_CACTUS@@\" alt=\"메마른 덤불 땅에 우뚝 선 기둥 선인장\"><span>선인장</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"soil\" data-name=\"함초\" data-chip=\"토양\" data-kind=\"f-soil\" data-d=\"소금기 많은 갯가 흙에 산다. 몸속에 <b>염분</b>을 모아 두는 조직이 있어 물을 잘 빨아들인다.\" data-cr=\"JBdeHeer · CC BY-SA 4.0\"><img src=\"@@AD_HAMCHO@@\" alt=\"갯가를 붉고 푸르게 덮은 함초 무리\"><span>함초</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"temp\" data-name=\"펭귄\" data-chip=\"온도\" data-kind=\"f-temp\" data-d=\"추운 곳에 산다. 피부 밑 <b>지방층</b>이 두꺼워 체온을 지키기 좋다(해 보기 (나)).\" data-cr=\"John Hardin · CC BY 4.0\"><img src=\"@@AD_PENGUIN@@\" alt=\"얼음 위에 모여 선 펭귄들\"><span>펭귄</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 74~75쪽 그림 Ⅱ-3</b><span>사진: 위키미디어 공용(사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-1-1.2.a2b */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const L1 = window.L1;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const mark = (root, n, max = 3) => { const ok = []; for (let k = 1; k <= max; k++) if (n === 0 || k < n) ok.push(k); L1.steps(root, n, ok); L1.done(root, n === 0); };\n  // 상태를 0.3초마다 읽는 체험 장(장에 있을 때만)\n  const poll = (fn) => { let t = 0; return { setActive(on) { clearInterval(t); if (on) { fn(); t = setInterval(fn, 300); } } }; };\n  const join = (...ps) => window.RxT.join(...ps);\n\n  // 1. 표지: 비버 댐 쌓기 + 예측(답은 확인 장의 «사건 파일 2 풀기»에서). 댐이 완성되는 순간 흔들림·진동\n  part('tongsci2-2-1-1-2-a2b', (root) => {\n    const rows = [...root.querySelectorAll('.ab-row')];\n    root.querySelector('.gv').addEventListener('gv-pick', (e) => rows.forEach((x) => x.classList.toggle('on', x.dataset.k === e.detail.b.dataset.row)));\n    return window.RxT.gallery(root);\n  });\n\n  // 3. 체험: 빛 — ① 시금치 꽃대 ② 낮을 짧게 ③ 국화 꽃\n})();\n","needs":[],"media":{"AD_MUM":"ad-mum.webp","AD_FENNEC":"ad-fennec.webp","AD_ARCTIC":"ad-arctic.webp","AD_CACTUS":"ad-cactus.webp","AD_HAMCHO":"ad-hamcho.webp","AD_PENGUIN":"ad-penguin.webp"}}