{"id":"tongsci2.2-2-2.3.rotor","unit":"tongsci2.2-2-2","html":"<!-- 3. 자석 사이에서 도는 코일 -->\n<section id=\"tongsci2-2-2-2-3-rotor\" data-state=\"rotor\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 발전기의 원리 · 회전하는 코일</div>\n        <h2 data-edit=\"h2\">자석 사이에서 코일이 돌면</h2>\n      </div>\n      <p class=\"pen\">0° · 45° · 90° · 135°</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"stage\" data-prevent-swipe>\n        <canvas role=\"img\" aria-label=\"N극과 S극 사이에서 회전축에 달린 사각 코일이 돈다. 코일 면을 통과하는 자기력선은 진하게 보인다.\"></canvas>\n      </div>\n      <div class=\"panel\">\n        <div class=\"deg-steps\" role=\"group\" aria-label=\"각도\">\n          <button type=\"button\" id=\"deg-0\" data-deg=\"0\" aria-pressed=\"false\">0°</button>\n          <button type=\"button\" id=\"deg-45\" data-deg=\"45\" aria-pressed=\"false\">45°</button>\n          <button type=\"button\" id=\"deg-90\" data-deg=\"90\" aria-pressed=\"false\">90°</button>\n          <button type=\"button\" id=\"deg-135\" data-deg=\"135\" aria-pressed=\"false\">135°</button>\n          <button class=\"auto\" type=\"button\" id=\"rot-auto\" aria-pressed=\"false\">▶ <span>계속 돌리기</span></button>\n        </div>\n        <p data-edit=\"rot-cap\" class=\"rot-cap\" aria-live=\"polite\">각도 단추를 누르거나 손잡이를 좌우로 끌어 코일을 돌려 보세요.</p>\n        <div class=\"readout\">\n          <div class=\"count\"><b>0</b><small>개</small></div>\n          <div class=\"what\">코일 면을 통과하는 자기력선</div>\n          <div class=\"trend\"><span class=\"chip\">―</span>변하지 않음</div>\n          <div class=\"verdict\"><b>바늘이 멈춰 있다</b> → 전류가 없다</div>\n        </div>\n        <div class=\"chart\">\n          <div class=\"ct\"><b>코일 면을 통과하는 자기력선 수</b><span>한 바퀴(0°→360°)</span></div>\n          <canvas data-chart=\"flux\" role=\"img\" aria-label=\"코일이 한 바퀴 도는 동안 코일 면을 통과하는 자기력선 수: 90°와 270°에서 가장 많다\"></canvas>\n        </div>\n        <div class=\"chart\">\n          <div class=\"ct\"><b>유도 전류</b><span>같은 빠르기로 돌릴 때 · 점선 90°·270°</span></div>\n          <canvas data-chart=\"i\" role=\"img\" aria-label=\"같은 빠르기로 돌릴 때의 유도 전류: 90°와 270°에서 방향이 바뀐다\"></canvas>\n        </div>\n      </div>\n    </div>\n    <span class=\"fragment custom\" data-anim=\"deg\" data-deg=\"0\" data-fragment-index=\"0\"></span>\n    <span class=\"fragment custom\" data-anim=\"deg\" data-deg=\"45\" data-fragment-index=\"1\"></span>\n    <span class=\"fragment custom\" data-anim=\"deg\" data-deg=\"90\" data-fragment-index=\"2\"></span>\n    <span class=\"fragment custom\" data-anim=\"deg\" data-deg=\"135\" data-fragment-index=\"3\"></span>\n  </div>\n  <div class=\"footer\"><b>발전기의 원리</b><span>자석 사이에서 회전하는 코일</span></div>\n</section>","css":"#tongsci2-2-2-2-3-rotor .chart canvas { height: 104px; }\n#tongsci2-2-2-2-3-rotor .readout .count { font-size: 80px; }\n","js":"/* tongsci2.2-2-2.3.rotor */\n(function () {\n  'use strict';\n  const { part, reduce } = window.Deck;\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n  const press = (btns, on) => btns.forEach((b) => b.setAttribute('aria-pressed', String(b === on)));\n  part('tongsci2-2-2-2-3-rotor', (root) => {\n    const g = window.MiniGen.mountRot(root);\n    return {\n      setActive: g.setActive, fit: g.fit,\n      fragment(f, on) {\n        if (f.dataset.anim !== 'deg') return;\n        if (on) g.goDeg(Number(f.dataset.deg));\n        else { const prev = f.previousElementSibling; if (prev && prev.dataset.anim === 'deg') g.goDeg(Number(prev.dataset.deg)); }\n      },\n    };\n  });\n\n  // 교류와 직류: 지난 2초 동안의 그래프가 흘러간다\n})();\n","needs":["minigen"],"media":{}}