{"id":"tongsci2.1-1-1.1.timetape","unit":"tongsci2.1-1-1","html":"<!-- 9. 체험: 46억 년 줄자 -->\n<section id=\"tongsci2-1-1-1-1-timetape\" data-state=\"timetape\" class=\"std l1\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 15쪽 그림 I-2 · 지질 시대의 상대적 길이</div>\n        <h2 data-edit=\"h2\">46억 년 줄자에 깃발 꽂기</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">세 시대가 시작한 때를 줄자 위에서 찾아보자</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"sim-col\" data-prevent-swipe>\n        <div class=\"stage tp-stage\">\n          <svg class=\"tp-svg u-svg\" viewBox=\"0 0 1000 560\" role=\"img\" aria-label=\"왼쪽 끝이 46억 년 전, 오른쪽 끝이 현재인 줄자. 아래의 깃발 셋(고생대·중생대·신생대 시작)을 끌어 줄자 위에 꽂는다. 맞춰 보면 실제 시대가 색 띠로 칠해지고 마지막 6억 년이 아래에 크게 보인다\"></svg>\n          <p class=\"now-chip tp-now\"></p>\n        </div>\n        <div class=\"tray tp-tray\">\n          <span class=\"tray-tag\">시대 경계 깃발 셋</span>\n          <div class=\"tray-end\"><button type=\"button\" class=\"btn tp-check\" disabled>맞춰 보기</button><button type=\"button\" class=\"btn tp-reset\">다시</button></div>\n        </div>\n      </div>\n      <div class=\"panel tp-panel\" data-prevent-swipe>\n        <ol class=\"u-steps\">\n          <li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 세 깃발을 짐작한 자리에 꽂는다 <em class=\"tp-n\">0/3</em></li>\n          <li data-edit=\"li-2\" data-s=\"2\"><b>②</b> «맞춰 보기»로 실제 자리와 견준다</li>\n        </ol>\n        <div class=\"u-msg tp-msg\" aria-live=\"polite\"></div>\n        <div class=\"u-card tp-daycard\">\n          <svg class=\"tp-clock\" viewBox=\"0 0 260 260\" role=\"img\" aria-label=\"46억 년을 24시간으로 줄인 시계. 맞춰 보면 네 시대가 색으로 칠해진다\"></svg>\n          <div class=\"tp-dayside\">\n            <span data-edit=\"tag\" class=\"tag\">46억 년 = 하루 24시간</span>\n            <ol class=\"tp-day\"></ol>\n          </div>\n        </div>\n        <div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p\">지구 역사의 거의 전부가 <b>선캄브리아시대</b>다. 공룡이 살던 중생대는 하루로 치면 한 시간 남짓이다.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 14~15쪽</b><span>5억 3900만·2억 5200만·6600만 년 전, 88.2·6.3·4.1·1.4 %는 교과서 값 · 하루 시각은 그 비율로 계산</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.1.timetape */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 손전등으로 발자국 찾기(①) + 예측(②, 한 번 넘기면 답과 풀이)\n  part('tongsci2-1-1-1-1-timetape', (root) => window.TpTape.mount(root));\n})();\n","needs":["timetape"],"media":{}}