{"id":"tongsci2.2-2-2.1.zoom","unit":"tongsci2.2-2-2","html":"<!-- 2. 줌인: 콘센트 뒤를 따라가기 -->\n<section id=\"tongsci2-2-2-2-1-zoom\" data-state=\"zoom\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 102쪽 도입 · 전기는 어디서 올까?</div>\n        <h2 data-edit=\"h2\">콘센트 뒤를 따라가 보자</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">→ 를 누를 때마다 한 걸음씩</p>\n    </div>\n    <div class=\"journey\">\n      <svg class=\"zs\" viewBox=\"0 55 1000 420\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"휴대폰 충전기에서 콘센트, 송전탑, 발전소, 터빈, 발전기로 거슬러 올라가는 그림\">\n        <line class=\"ln thin\" x1=\"-1200\" y1=\"470\" x2=\"6200\" y2=\"470\"/>\n        <!-- 전기가 지나는 길: 발전기에서 왼쪽으로 -->\n        <path class=\"cable\" d=\"M4500 90 L4500 66 L2600 66 L2600 300\"/>\n        <path class=\"cable\" d=\"M2250 340 C2150 340 2080 210 2000 150 Q1880 190 1765 150 Q1525 215 1285 150 Q1140 190 1000 160 Q900 165 880 230 L880 315 L760 315\"/>\n        <path class=\"cable thin\" d=\"M2000 210 Q1880 250 1765 210 Q1525 275 1285 210 Q1140 250 1000 225\"/>\n        <path class=\"flow\" d=\"M4500 90 L4500 66 L2600 66 L2600 300\"/>\n        <path class=\"flow\" d=\"M2250 340 C2150 340 2080 210 2000 150 Q1880 190 1765 150 Q1525 215 1285 150 Q1140 190 1000 160 Q900 165 880 230 L880 315 L760 315\"/>\n        <path class=\"flow\" d=\"M604 318 C520 330 470 452 320 446\"/>\n        <!-- ① 콘센트와 휴대폰 -->\n        <rect class=\"wall\" x=\"560\" y=\"40\" width=\"460\" height=\"430\"/>\n        <rect class=\"plate\" x=\"640\" y=\"225\" width=\"120\" height=\"180\" rx=\"18\"/>\n        <circle class=\"ln\" cx=\"700\" cy=\"315\" r=\"42\"/>\n        <circle class=\"hole\" cx=\"684\" cy=\"315\" r=\"7\"/><circle class=\"hole\" cx=\"716\" cy=\"315\" r=\"7\"/>\n        <rect class=\"table\" x=\"150\" y=\"446\" width=\"420\" height=\"16\" rx=\"4\"/>\n        <path class=\"ln\" d=\"M604 318 C520 330 470 452 320 446\"/>\n        <rect class=\"plug\" x=\"604\" y=\"295\" width=\"56\" height=\"46\" rx=\"10\"/>\n        <rect class=\"phone\" x=\"250\" y=\"190\" width=\"140\" height=\"256\" rx=\"22\"/>\n        <rect class=\"screen\" x=\"266\" y=\"214\" width=\"108\" height=\"200\" rx=\"10\"/>\n        <rect class=\"ln\" x=\"296\" y=\"268\" width=\"48\" height=\"88\" rx=\"8\"/>\n        <rect class=\"charge\" x=\"302\" y=\"274\" width=\"36\" height=\"76\" rx=\"4\"/>\n        <path class=\"bolt\" d=\"M326 286 L308 318 H322 L314 344 L338 308 H324 Z\"/>\n        <!-- ② 송전탑 -->\n        <g class=\"tower\">\n          <path class=\"ln\" d=\"M1235 470 L1272 110 M1335 470 L1298 110 M1272 110 L1285 88 L1298 110 M1225 150 H1345 M1233 210 H1337\"/>\n          <path class=\"ln thin\" d=\"M1240 430 L1330 380 M1330 430 L1240 380 M1247 362 L1323 312 M1323 362 L1247 312 M1254 294 L1316 244 M1316 294 L1254 244 M1262 224 L1308 176 M1308 224 L1262 176\"/>\n        </g>\n        <g class=\"tower\" transform=\"translate(480 0)\">\n          <path class=\"ln\" d=\"M1235 470 L1272 110 M1335 470 L1298 110 M1272 110 L1285 88 L1298 110 M1225 150 H1345 M1233 210 H1337\"/>\n          <path class=\"ln thin\" d=\"M1240 430 L1330 380 M1330 430 L1240 380 M1247 362 L1323 312 M1323 362 L1247 312 M1254 294 L1316 244 M1316 294 L1254 244 M1262 224 L1308 176 M1308 224 L1262 176\"/>\n        </g>\n        <!-- ③ 발전소 -->\n        <rect class=\"building\" x=\"2250\" y=\"300\" width=\"420\" height=\"170\"/>\n        <rect class=\"building\" x=\"2300\" y=\"140\" width=\"44\" height=\"160\"/>\n        <rect class=\"building\" x=\"2390\" y=\"180\" width=\"44\" height=\"120\"/>\n        <path class=\"building\" d=\"M2730 470 C2765 380 2765 300 2748 232 L2882 232 C2866 300 2866 380 2902 470 Z\"/>\n        <g class=\"steam\"><circle cx=\"2322\" cy=\"112\" r=\"24\"/><circle cx=\"2350\" cy=\"82\" r=\"18\"/><circle cx=\"2412\" cy=\"150\" r=\"20\"/><circle cx=\"2815\" cy=\"200\" r=\"30\"/><circle cx=\"2850\" cy=\"160\" r=\"22\"/></g>\n        <g class=\"windows\"><rect x=\"2290\" y=\"340\" width=\"40\" height=\"30\"/><rect x=\"2350\" y=\"340\" width=\"40\" height=\"30\"/><rect x=\"2410\" y=\"340\" width=\"40\" height=\"30\"/><rect x=\"2470\" y=\"340\" width=\"40\" height=\"30\"/><rect x=\"2530\" y=\"340\" width=\"40\" height=\"30\"/></g>\n        <text class=\"svg-label\" x=\"2460\" y=\"430\" text-anchor=\"middle\">발전소</text>\n        <!-- ④ 터빈 -->\n        <path class=\"pipe\" d=\"M2670 420 C2860 420 2960 280 3290 280\"/>\n        <path class=\"steamline\" d=\"M3090 220 L3290 230 M3090 280 L3300 280 M3090 340 L3290 330\"/>\n        <text class=\"svg-pen\" x=\"3110\" y=\"190\">증기</text>\n        <rect class=\"shaft\" x=\"3500\" y=\"270\" width=\"800\" height=\"22\"/>\n        <circle class=\"housing\" cx=\"3500\" cy=\"280\" r=\"190\"/>\n        <g id=\"turbine-rotor\"></g>\n        <circle class=\"hub\" cx=\"3500\" cy=\"280\" r=\"36\"/>\n        <text class=\"svg-pen\" x=\"3500\" y=\"530\" text-anchor=\"middle\">터빈</text>\n        <!-- ⑤ 발전기 -->\n        <circle class=\"stator\" cx=\"4500\" cy=\"300\" r=\"210\"/>\n        <g id=\"gen-coils\"></g>\n        <circle class=\"ln\" cx=\"4500\" cy=\"300\" r=\"140\"/>\n        <g id=\"gen-rotor\"></g>\n        <path class=\"ln thin\" d=\"M4660 170 L4760 110 M4600 400 L4760 500\"/>\n        <text class=\"svg-pen\" x=\"4770\" y=\"105\">고정된 코일</text>\n        <text class=\"svg-pen\" x=\"4770\" y=\"520\">회전하는 자석</text>\n      </svg>\n      <ol class=\"stops\" aria-label=\"지나온 곳\">\n        <li data-edit=\"on\" class=\"on\">콘센트</li><li data-edit=\"li-1\">송전탑</li><li data-edit=\"li-2\">발전소</li><li data-edit=\"li-3\">터빈</li><li data-edit=\"li-4\">발전기</li>\n      </ol>\n      <div class=\"zcap\" aria-live=\"polite\"><span class=\"no\">①</span><p data-edit=\"p\">휴대폰 충전기는 콘센트에서 전기 에너지를 받는다. 이 전기는 벽 뒤 전선을 따라 어디에서 올까?</p></div>\n    </div>\n    <span class=\"fragment custom\" data-anim=\"zoom\" data-step=\"1\" data-fragment-index=\"0\"></span>\n    <span class=\"fragment custom\" data-anim=\"zoom\" data-step=\"2\" data-fragment-index=\"1\"></span>\n    <span class=\"fragment custom\" data-anim=\"zoom\" data-step=\"3\" data-fragment-index=\"2\"></span>\n    <span class=\"fragment custom\" data-anim=\"zoom\" data-step=\"4\" data-fragment-index=\"3\"></span>\n  </div>\n  <div class=\"footer\"><b>교과서 102쪽 도입</b><span>전기 에너지는 어디서 만들어질까</span></div>\n</section>","css":"#tongsci2-2-2-2-1-zoom .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }\n#tongsci2-2-2-2-1-zoom .head .titles { display: flex; flex-direction: column; gap: 6px; }\n#tongsci2-2-2-2-1-zoom .head .pen { font-size: 44px; transform: rotate(-1.5deg); padding-bottom: 6px; white-space: nowrap; }\n#tongsci2-2-2-2-1-zoom .frame { gap: 20px; }\n","js":"/* tongsci2.2-2-2.1.zoom */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  \n  part('tongsci2-2-2-2-1-zoom', (root) => {\n    const z = window.ZoomJourney.mount(root);\n    return {\n      setActive: z.setActive,\n      fragment(f, on) { if (f.dataset.anim === 'zoom') { const k = Number(f.dataset.step); z.go(on ? k : k - 1); } },\n      sync(slide) {\n        const shown = [...slide.querySelectorAll('[data-anim=\"zoom\"].visible')].map((f) => Number(f.dataset.step));\n        z.go(shown.length ? Math.max(...shown) : 0, true);\n      },\n    };\n  });\n})();\n","needs":["zoom"],"media":{}}