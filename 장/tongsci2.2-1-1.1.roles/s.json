{"id":"tongsci2.2-1-1.1.roles","unit":"tongsci2.2-1-1","html":"<!-- 5. 이론: 생산자·소비자·분해자(Manim + 먼저 보고 놀라기) -->\n<section id=\"tongsci2-2-1-1-1-roles\" data-state=\"roles\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 73쪽 그림 Ⅱ-2 · 생물요소</div>\n        <h2 data-edit=\"h2\">생산자·소비자·분해자</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">양분을 어떻게 얻을까?</p>\n      <button type=\"button\" class=\"pk-open\" aria-expanded=\"false\">▶ 실제 영상</button>\n    </div>\n    <div class=\"t-body t-theo t-thm\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def rl-def prod\"><span data-edit=\"t-tag-1\" class=\"t-tag\">생산자</span><p data-edit=\"p-1\">빛에너지로 양분을 <b>스스로 만든다</b></p><p data-edit=\"t-sub-1\" class=\"t-sub\">식물, 물속의 식물 플랑크톤</p></div>\n        <div class=\"tcard th-def rl-def cons\"><span data-edit=\"t-tag-2\" class=\"t-tag\">소비자</span><p data-edit=\"p-2\">다른 생물을 <b>먹어서</b> 양분을 얻는다</p><p data-edit=\"t-sub-2\" class=\"t-sub\">먹는 차례에 따라 1차·2차·3차 소비자</p></div>\n        <div class=\"tcard th-def rl-def dec\"><span data-edit=\"t-tag-3\" class=\"t-tag\">분해자</span><p data-edit=\"p-3\">사체·배설물을 <b>분해해</b> 양분을 얻는다</p><p data-edit=\"t-sub-3\" class=\"t-sub\">버섯, 곰팡이, 세균</p></div>\n      </div>\n      <div class=\"st-fig\" data-prevent-swipe>\n        <div class=\"st-stage\">\n          <button type=\"button\" class=\"btn st-again\">다시 보기</button>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@FL1@@\" src=\"@@FL1_V@@\" aria-label=\"햇빛이 수련 잎에 닿고, 잎 안에 노란 양분 알갱이가 생긴다. 이름표: 생산자, 빛에너지로 양분을 만든다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@FL2@@\" src=\"@@FL2_V@@\" aria-label=\"양분 알갱이가 수련에서 다슬기로, 다시 붕어로 화살표를 따라 옮겨 간다. 이름표: 1차 소비자 다슬기, 2차 소비자 붕어\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@FL3@@\" src=\"@@FL3_V@@\" aria-label=\"떨어진 잎과 배설물에서 양분 알갱이가 버섯으로 옮겨 간다. 이름표: 분해자, 사체와 배설물을 분해한다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@FL4@@\" src=\"@@FL4_V@@\" aria-label=\"버섯에서 나온 물질이 흙과 물로 돌아가고, 그 물질을 다시 수련이 빨아들인다. 넷이 고리 화살표로 이어진다\"></video>\n        </div>\n        <div class=\"st-ctl\"><span>①</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0\" aria-label=\"단계 막대: 양분이 옮겨 가는 네 단계를 차례로 본다\"><span>④</span></div>\n        <div class=\"st-pills\" style=\"--n:4\" role=\"group\" aria-label=\"단계 고르기\"><button type=\"button\">① 만든다</button><button type=\"button\">② 먹는다</button><button type=\"button\">③ 분해한다</button><button type=\"button\">④ 돌아간다</button></div>\n        <div class=\"tcard st-now st-cap\" aria-live=\"polite\"><span data-edit=\"t-tag-4\" class=\"t-tag st-tag\">1단계 / 4</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n      </div>\n      <ol class=\"st-text\" hidden>\n        <li><h4 data-edit=\"h4-1\">생산자가 양분을 만든다</h4><p data-edit=\"p-4\">수련은 햇빛을 받아 광합성으로 양분을 만든다 → <b>생산자</b>.</p></li>\n        <li><h4 data-edit=\"h4-2\">소비자가 먹어서 얻는다</h4><p data-edit=\"p-5\">수련을 갉는 다슬기는 <b>1차 소비자</b>, 다슬기를 먹는 붕어는 <b>2차 소비자</b>.</p></li>\n        <li><h4 data-edit=\"h4-3\">분해자가 사체를 분해한다</h4><p data-edit=\"p-6\">떨어진 잎·죽은 몸·배설물은 버섯·세균이 분해해 양분을 얻는다 → <b>분해자</b>.</p></li>\n        <li><h4 data-edit=\"h4-4\">물질은 다시 돌아간다</h4><p data-edit=\"p-7\">분해된 물질이 흙·물로 돌아가 생산자가 다시 쓴다 → 구성요소는 서로 <b>이어져</b> 있다.</p></li>\n      </ol>\n    </div>\n    <div class=\"pk\" data-ans=\"mold\" hidden>\n      <div class=\"pk-side\">\n        <span class=\"pk-kick\">먼저 보고 놀라기 · 예측 걸기</span>\n        <p data-edit=\"pk-q\" class=\"pk-q\">딸기를 그릇에 담아 며칠 그대로 두면 어떻게 될까?</p>\n        <div class=\"share-opts\" role=\"group\" aria-label=\"예측\"><button type=\"button\" data-k=\"same\" aria-pressed=\"false\">그대로 남는다</button><button type=\"button\" data-k=\"mold\" aria-pressed=\"false\" data-why=\"곰팡이가 딸기를 분해해 양분을 얻는다 → 곰팡이는 분해자.\">곰팡이가 덮고 무너진다</button><button type=\"button\" data-k=\"hard\" aria-pressed=\"false\">말라서 단단해진다</button></div>\n        <p class=\"pk-say\" aria-live=\"polite\"></p>\n        <div class=\"pk-row\"><button type=\"button\" class=\"btn pk-close\">이론 설명 보기 →</button><small class=\"cr\">영상: Mark Rigler · CC BY 2.0 · 2배 빠르게</small></div>\n      </div>\n      <div class=\"pk-vid\"><video muted playsinline preload=\"auto\" poster=\"@@V_MOLD_P@@\" src=\"@@V_MOLD@@\" aria-label=\"싱싱한 딸기 위로 곰팡이가 퍼지며 딸기가 물러지고 무너지는 빠른 영상(며칠을 몇 초로)\"></video><button type=\"button\" class=\"pk-play\">▶ 영상 보기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 73쪽 그림 Ⅱ-2</b><span>그림: Manim으로 그림(사진 조각: 위키미디어 공용) · 먹이 관계의 예는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-1-1.1.roles */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const L1 = window.L1;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  // 체험 장 해 볼 일: 지금 단계 번호(0 = 끝)\n  const mark = (root, n, max = 3) => { const ok = []; for (let k = 1; k <= max; k++) if (n === 0 || k < n) ok.push(k); L1.steps(root, n, ok); L1.done(root, n === 0); };\n  window.EcoMark = mark;\n  // 1. 표지: 두 밭 타임랩스 + 예측(답은 확인 장의 «사건 파일 1 풀기»에서)\n  part('tongsci2-2-1-1-1-roles', (root) => {\n    const defs = ['prod', 'cons', 'dec'];\n    root.addEventListener('st-step', (e) => root.querySelectorAll('.rl-def').forEach((d) => d.classList.toggle('on', e.detail === 3 || d.classList.contains(defs[e.detail]))));\n    return window.RxT.join(window.RxT.stepper(root), window.RxPeek.mount(root));\n  });\n\n  // 6. 체험: 해 보기 연못 나누기\n})();\n","needs":[],"media":{"FL1":"fl1.webp","FL1_V":"fl1.mp4","FL2":"fl2.webp","FL2_V":"fl2.mp4","FL3":"fl3.webp","FL3_V":"fl3.mp4","FL4":"fl4.webp","FL4_V":"fl4.mp4","V_MOLD_P":"v-mold.webp","V_MOLD":"v-mold.mp4"}}