{"id":"tongsci1.3-3-3.2.sum7","unit":"tongsci1.3-3-3","html":"<!-- 6. 정리 -->\n<section id=\"tongsci1-3-3-3-2-sum7\" data-state=\"sum7\" class=\"std l1t t-sumsec\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">정리 · 교과서 156~158쪽</div>\n        <h2 data-edit=\"h2\">전사와 번역 한눈에 보기</h2>\n      </div>\n    </div>\n    <div class=\"t-body t-sum\">\n      <div class=\"sbox\"><h3><span class=\"sn\">1</span>정보의 흐름</h3><p data-edit=\"p-1\">DNA → <b>RNA</b> → 단백질</p><p data-edit=\"sx-1\" class=\"sx\">전사와 번역</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">2</span>전사</h3><p data-edit=\"p-2\">DNA의 정보를 <b>RNA</b>에 옮겨 적는다</p><p data-edit=\"sx-2\" class=\"sx\">핵 안에서</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">3</span>번역</h3><p data-edit=\"p-3\">RNA의 정보로 <b>단백질</b>을 만든다</p><p data-edit=\"sx-3\" class=\"sx\">세포질의 라이보솜에서</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">4</span>염기 짝</h3><p>A→U · T→A · G→C · C→G</p><p data-edit=\"sx-4\" class=\"sx\">RNA에는 T 대신 <b>U</b></p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">5</span>3염기조합</h3><p data-edit=\"p-4\">DNA에서 아미노산 하나를 정하는 <b>염기 3개</b></p><p data-edit=\"sx-5\" class=\"sx\">4 × 4 × 4 = 64가지</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">6</span>코돈</h3><p data-edit=\"p-5\">RNA에서 아미노산 하나를 정하는 <b>염기 3개</b></p><p data-edit=\"sx-6\" class=\"sx\">모두 64가지</p></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 156~158쪽</b><span>카드를 누르면 뒤집힌다</span></div>\n</section>","css":"\n","js":"/* tongsci1.3-3-3.2.sum7 */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (m, root) => window.EthTrack.join(m, window.L1.frame(root));\n  part('tongsci1-3-3-3-2-sum7', (root) => window.RxT.sum(root));\n})();\n","needs":[],"media":{}}