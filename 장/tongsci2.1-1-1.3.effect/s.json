{"id":"tongsci2.1-1-1.3.effect","unit":"tongsci2.1-1-1","html":"<!-- 5. 설명: 대륙이 움직이면 생물도 -->\n<section id=\"tongsci2-1-1-1-3-effect\" data-state=\"effect\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 16~19쪽 · 수륙 분포의 변화와 생물</div>\n        <h2 data-edit=\"h2\">대륙이 움직이면 생물도 달라진다</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">대륙이 모이면 바다 생물은 어떻게 될까?</p>\n    </div>\n    <div class=\"t-body t-effect\">\n      <div class=\"ef-fig\" data-prevent-swipe>\n        <svg class=\"ef-svg\" viewBox=\"0 0 800 520\" role=\"img\" aria-label=\"위에서 내려다본 바다와 대륙 조각 다섯. 막대를 오른쪽으로 끌면 대륙이 모여 하나가 되면서 둘레의 하늘색 얕은 바다가 줄고, 안쪽에 메마른 땅이 생기며, 여러 개였던 해류 고리가 큰 고리 하나로 바뀐다\"></svg>\n        <div class=\"ef-ctl\">\n          <label class=\"pl-ctl\"><span>흩어짐</span><input type=\"range\" class=\"ef-range\" min=\"0\" max=\"100\" value=\"0\" aria-label=\"대륙이 모인 정도: 왼쪽 흩어짐, 오른쪽 하나로 모임\"><span>하나로 모임</span></label>\n          <div class=\"ef-gos\"><button type=\"button\" class=\"btn ef-go\" data-t=\"0\">흩어진 대륙</button><button type=\"button\" class=\"btn ef-go\" data-t=\"1\">초대륙(판게아)</button></div>\n        </div>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"tcard ef-now\" aria-live=\"polite\"><span data-edit=\"t-tag-1\" class=\"t-tag\">지금 지구는</span><p class=\"ef-say\"></p></div>\n        <div class=\"tcard ef-bars\">\n          <div><span>해안선 길이</span><b><i></i></b></div>\n          <div><span>얕은 바다(대륙붕) 넓이</span><b><i></i></b></div>\n          <div><span>해류·기후의 다양함</span><b><i></i></b></div>\n          <div><span>바다 생물이 살 곳</span><b><i></i></b></div>\n          <small>막대 길이는 이해를 돕기 위한 예</small>\n        </div>\n        <div class=\"tcard ef-sum fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\">\n          <span data-edit=\"t-tag-2\" class=\"t-tag\">수륙 분포 → 환경 → 생물</span>\n          <p class=\"s-chain\"><span><b>수륙 분포</b> 변화</span>→<span>해안선·얕은 바다·<b>해류</b>·<b>기후</b>·해수면</span>→<span><b>서식지</b> 변화</span>→<span>멸종 또는 번성</span></p>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 16~19쪽</b><span>대륙 조각 모양·자리와 막대 길이는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.3.effect */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 산꼭대기 확대 + 예측(한 번 넘기면 답 표시)\n  part('tongsci2-1-1-1-3-effect', (root) => window.T3.effect(root));\n  // 6. 체험: 지구 그림을 시대 칸에 → ①놓기 ②셋 다 맞음 ③대서양 물음\n})();\n","needs":["teach3"],"media":{}}