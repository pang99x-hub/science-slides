{"id":"tongsci1.3-2-1.1.sum1","unit":"tongsci1.3-2-1","html":"<!-- 11. 정리 -->\n<section id=\"tongsci1-3-2-1-1-sum1\" data-state=\"sum1\" class=\"std l1t t-sumsec\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">정리 · 교과서 124~125쪽</div>\n        <h2 data-edit=\"h2\">중력과 자유 낙하 한눈에 보기</h2>\n      </div>\n    </div>\n    <div class=\"t-body t-sum\">\n      <div class=\"sbox\"><h3><span class=\"sn\">1</span>중력</h3><p data-edit=\"p-1\">질량 있는 물체끼리 <b>서로 당긴다</b></p><p data-edit=\"sx-1\" class=\"sx\">지구에서는 늘 지구 중심 쪽</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">2</span>무게와 질량</h3><p data-edit=\"p-2\">무게 = <b>중력의 크기</b>(N)</p><p data-edit=\"sx-2\" class=\"sx\">달에서 무게는 약 1/6, 질량은 그대로</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">3</span>속도</h3><p data-edit=\"p-3\">빠르기 + <b>방향</b>(m/s)</p><p data-edit=\"sx-3\" class=\"sx\">방향만 바뀌어도 속도가 바뀐다</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">4</span>가속도</h3><p data-edit=\"p-4\">속도 변화량 ÷ 걸린 시간(<b>m/s²</b>)</p><p data-edit=\"sx-4\" class=\"sx\">빨라지면 운동 방향, 느려지면 반대</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">5</span>자유 낙하</h3><p data-edit=\"p-5\">매초 속력이 약 <b>9.8 m/s</b> 늘어난다</p><p data-edit=\"sx-5\" class=\"sx\">중력 가속도 약 9.8 m/s²</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">6</span>질량과 낙하</h3><p data-edit=\"p-6\">무거워도 가벼워도 <b>동시에</b></p><p data-edit=\"sx-6\" class=\"sx\">깃털이 늦는 것은 공기 저항 때문</p></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 124~125쪽</b><span>카드를 누르면 뒤집힌다</span></div>\n</section>","css":"\n","js":"/* tongsci1.3-2-1.1.sum1 */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (m, root) => window.EthTrack.join(m, window.L1.frame(root));\n  part('tongsci1-3-2-1-1-sum1', (root) => window.RxT.sum(root));\n})();\n","needs":[],"media":{}}