{"id":"tongsci1.3-3-2.2.sum6","unit":"tongsci1.3-3-2","html":"<!-- 8. 정리 -->\n<section id=\"tongsci1-3-3-2-2-sum6\" data-state=\"sum6\" class=\"std l1t t-sumsec\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">정리 · 교과서 151~153쪽</div>\n        <h2 data-edit=\"h2\">삼투 한눈에 보기</h2>\n      </div>\n    </div>\n    <div class=\"t-body t-sum\">\n      <div class=\"sbox\"><h3><span class=\"sn\">1</span>삼투</h3><p data-edit=\"p-1\">물이 묽은 쪽에서 <b>진한 쪽</b>으로</p><p data-edit=\"sx-1\" class=\"sx\">선택적 투과성이 있는 막을 사이에 두고</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">2</span>저장액</h3><p data-edit=\"p-2\">세포 안보다 <b>묽은</b> 용액</p><p data-edit=\"sx-2\" class=\"sx\">물이 세포 안으로 더 많이 들어온다</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">3</span>등장액</h3><p data-edit=\"p-3\">세포 안과 농도가 <b>같은</b> 용액</p><p data-edit=\"sx-3\" class=\"sx\">드나드는 물의 양이 같다</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">4</span>고장액</h3><p data-edit=\"p-4\">세포 안보다 <b>진한</b> 용액</p><p data-edit=\"sx-4\" class=\"sx\">물이 세포 밖으로 더 많이 나간다</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">5</span>동물 세포</h3><p data-edit=\"p-5\">저장액에서 부풀다 <b>터지고</b> 고장액에서 쪼그라든다</p><p data-edit=\"sx-5\" class=\"sx\">적혈구</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">6</span>식물 세포</h3><p data-edit=\"p-6\">저장액에서 팽팽, 고장액에서 <b>원형질분리</b></p><p data-edit=\"sx-6\" class=\"sx\">세포벽이 있어 터지지 않는다</p></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 151~153쪽</b><span>카드를 누르면 뒤집힌다</span></div>\n</section>","css":"\n","js":"/* tongsci1.3-3-2.2.sum6 */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (m, root) => window.EthTrack.join(m, window.L1.frame(root));\n  part('tongsci1-3-3-2-2-sum6', (root) => window.RxT.sum(root));\n})();\n","needs":[],"media":{}}