{"id":"tongsci2.1-1-2.3.giraffe","unit":"tongsci2.1-1-2","html":"<!-- 5. 설명: 기린의 목, 두 설명 -->\n<section id=\"tongsci2-1-1-2-3-giraffe\" data-state=\"giraffe\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 자연선택설과 용불용설 견주기</div>\n        <h2 data-edit=\"h2\">기린의 목은 왜 길어졌을까?</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">세대 막대를 넘기며 두 설명을 견주자</p>\n    </div>\n    <div class=\"t-body t-gir\">\n      <div class=\"gf-fig\" data-prevent-swipe>\n        <svg class=\"gf-svg\" viewBox=\"0 0 1000 480\" role=\"img\" aria-label=\"왼쪽은 용불용설, 오른쪽은 자연선택설로 그린 기린 무리. 세대 막대를 넘기면 두 무리의 목 길이가 함께 바뀐다. 용불용설은 모두 짧은 목에서 늘여 길어지고, 자연선택설은 처음부터 목 길이가 여러 가지이고 짧은 목이 살아남지 못한다\"></svg>\n        <div class=\"st-ctl\"><span>세대</span><input type=\"range\" class=\"gf-range\" min=\"0\" max=\"3\" step=\"1\" value=\"0\" aria-label=\"세대 막대\"><span>→</span></div>\n        <div class=\"st-pills gf-pills\" style=\"--n:4\" role=\"group\" aria-label=\"세대 고르기\"><button type=\"button\">① 조상</button><button type=\"button\">② 먹이가 높은 곳에만</button><button type=\"button\">③ 자손 세대</button><button type=\"button\">④ 오늘날</button></div>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"tcard gf-card lam\"><span class=\"t-tag\">용불용설 · <span class=\"gf-gen\"></span></span><p class=\"gf-lam\" aria-live=\"polite\"></p></div>\n        <div class=\"tcard gf-card sel\"><span class=\"t-tag\">자연선택설 · <span class=\"gf-gen\"></span></span><p class=\"gf-sel\" aria-live=\"polite\"></p></div>\n        <div class=\"tcard gf-photo\"><img src=\"@@GI_GIRAFFE@@\" alt=\"아카시아 나무 아래에서 높은 잎을 뜯는 기린들\"><small class=\"cr\">Rasheedhrasheed · CC BY-SA 4.0</small></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 24쪽과 이어짐</b><span>목 길이·마릿수는 이해를 돕기 위한 그림</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-2.3.giraffe */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const K = window.EvKit;\n  part('tongsci2-1-1-2-3-giraffe', (root) => window.EvGiraffe.mount(root));\n})();\n","needs":["giraffe","stage"],"media":{"GI_GIRAFFE":"gi-giraffe.webp"}}