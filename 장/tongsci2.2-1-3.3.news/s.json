{"id":"tongsci2.2-1-3.3.news","unit":"tongsci2.2-1-3","html":"<section id=\"tongsci2-2-1-3-3-news\" data-state=\"news\" class=\"std evx\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 91쪽 탐구 과정 2 · 2100년에 방송될 뉴스 시나리오</div>\n        <h2 data-edit=\"h2\">2100년 뉴스를 만들자</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">카드를 끌어 인과 순서로 놓자</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"sim-col\" data-prevent-swipe>\n        <div class=\"stage nw-stage\"><div class=\"nw-picks\" role=\"group\" aria-label=\"상황 고르기\">\n          <button type=\"button\" class=\"btn nw-pick\" data-k=\"A\" aria-pressed=\"true\">상황 A</button>\n          <button type=\"button\" class=\"btn nw-pick\" data-k=\"B\" aria-pressed=\"false\">상황 B</button>\n          <button type=\"button\" class=\"btn nw-shuffle\">다시 섞기</button>\n        </div>\n          <div class=\"nw-tv A\">\n            <div class=\"nw-screen\">\n              <div class=\"nw-scene\" data-k=\"fac\"><svg viewBox=\"0 0 120 90\"><rect x=\"10\" y=\"40\" width=\"60\" height=\"40\" class=\"nw-f\"/><rect x=\"50\" y=\"15\" width=\"12\" height=\"30\" class=\"nw-f\"/><circle cx=\"60\" cy=\"10\" r=\"8\" class=\"nw-smoke\"/><rect x=\"74\" y=\"56\" width=\"40\" height=\"22\" class=\"nw-pv\"/></svg><span>원인</span></div>\n              <div class=\"nw-scene\" data-k=\"air\"><svg viewBox=\"0 0 120 90\"><circle cx=\"30\" cy=\"30\" r=\"7\" class=\"nw-c\"/><circle cx=\"18\" cy=\"30\" r=\"5\" class=\"nw-o\"/><circle cx=\"42\" cy=\"30\" r=\"5\" class=\"nw-o\"/><circle cx=\"80\" cy=\"55\" r=\"7\" class=\"nw-c\"/><circle cx=\"68\" cy=\"55\" r=\"5\" class=\"nw-o\"/><circle cx=\"92\" cy=\"55\" r=\"5\" class=\"nw-o\"/><path d=\"M10 80 q 50 -30 100 0\" class=\"nw-arc\"/></svg><span>대기</span></div>\n              <div class=\"nw-scene\" data-k=\"ice\"><svg viewBox=\"0 0 120 90\"><path d=\"M10 60 h 100 v 25 h -100 z\" class=\"nw-sea\"/><path d=\"M30 60 l 15 -30 l 15 30 z\" class=\"nw-ice\"/><path d=\"M70 60 l 10 -18 l 10 18 z\" class=\"nw-ice\"/></svg><span>지구계</span></div>\n              <div class=\"nw-scene\" data-k=\"eco\"><svg viewBox=\"0 0 120 90\"><path d=\"M20 45 q 15 -12 30 0 q -15 12 -30 0 m 30 0 l 10 -8 v 16 z\" class=\"nw-fish\"/><path d=\"M65 60 q 15 -12 30 0 q -15 12 -30 0 m 30 0 l 10 -8 v 16 z\" class=\"nw-fish w\"/></svg><span>생태계</span></div>\n              <div class=\"nw-scene\" data-k=\"life\"><svg viewBox=\"0 0 120 90\"><circle cx=\"40\" cy=\"35\" r=\"14\" class=\"nw-face\"/><rect x=\"30\" y=\"38\" width=\"20\" height=\"10\" rx=\"4\" class=\"nw-mask\"/><path d=\"M26 85 v -30 h 28 v 30\" class=\"nw-shirt\"/><path d=\"M75 80 v -20 l 8 -14 l 8 14 v 20 z\" class=\"nw-crop\"/></svg><span>생활</span></div>\n            </div>\n            <div class=\"nw-bar\"><span class=\"nw-live\">2100 뉴스</span><p class=\"nw-cap\"></p></div>\n          </div>\n          <p data-edit=\"now-chip\" class=\"now-chip nw-now\">카드를 인과 순서로 놓자</p>\n        </div>\n      </div>\n      <div class=\"panel nw-panel\"><ol class=\"u-steps\"><li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 조작 그림 위에서 A·B를 고른다</li><li data-edit=\"li-2\" data-s=\"2\"><b>②</b> 원인부터 생활까지 카드를 잇는다</li><li data-edit=\"li-3\" data-s=\"3\"><b>③</b> 조건과 근거를 넣어 한 줄 뉴스를 쓴다</li></ol>\n        \n        <div class=\"nw-wrap\"><ol class=\"nw-slots\" aria-hidden=\"true\"><li>1</li><li>2</li><li>3</li><li>4</li><li>5</li></ol><div class=\"nw-list\"></div></div>\n      <label class=\"news-draft\">내 뉴스 한 줄<textarea rows=\"2\" aria-label=\"조건과 근거를 담은 미래 뉴스\" placeholder=\"상황 A가 이어진다면, … 때문에 …할 수 있다.\"></textarea></label><div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p\">미래 뉴스에는 <b>조건·근거·인과</b>가 들어가야 한다.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 90~91쪽</b><span>기온·배출 값은 교과서 90쪽 그래프에서 읽음</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-1-3.3.news */\n(function () {\n  'use strict';\n  const {part}=window.Deck;\n  const join=(...m)=>RxT.join(...m);\n function cover(root,mod){ root.querySelectorAll('.share-opts button').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('.share-opts button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));}));return mod.mount(root); }\n function gal(root){root.querySelector('.gv').addEventListener('gv-pick',e=>root.querySelectorAll('.ab-row').forEach(x=>x.classList.toggle('on',x.dataset.k===e.detail.b.dataset.row)));return RxT.gallery(root);}\n function exp(root,mod){return ClimateUI.mount(root,mod);}\n  part('tongsci2-2-1-3-3-news',r=>exp(r,()=>window.News.mount(r)));\n})();\n","needs":["news"],"media":{}}