{"id":"tongsci2.1-1-1.1.form","unit":"tongsci2.1-1-1","html":"<!-- 3. 설명: 화석이 만들어지는 과정 -->\n<section id=\"tongsci2-1-1-1-1-form\" data-state=\"form\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 14쪽 그림 I-1</div>\n        <h2 data-edit=\"h2\">화석이 만들어지는 과정</h2>\n      </div>\n      <button type=\"button\" class=\"u-vbtn t-vbtn\" aria-expanded=\"false\">영상으로 한 번에 보기</button>\n    </div>\n    <div class=\"t-body t-form\">\n      <div class=\"fm-fig\" data-prevent-swipe>\n        <div class=\"fm-stage\">\n          <img class=\"fm-im\" src=\"@@STEP1@@\" alt=\"1단계: 바다 밑바닥에 죽은 조개 두 개가 놓여 있는 단면 그림\">\n          <img class=\"fm-im\" src=\"@@STEP2@@\" alt=\"2단계: 조개 위로 모래층 하나가 덮인 단면 그림\">\n          <img class=\"fm-im\" src=\"@@STEP3@@\" alt=\"3단계: 조개 위로 층이 네 겹 쌓이고 조개가 회색 돌처럼 바뀐 단면 그림\">\n          <img class=\"fm-im\" src=\"@@STEP4@@\" alt=\"4단계: 빨간 화살표 방향으로 지층이 밀려 올라와 물 밖으로 나온 단면 그림\">\n          <img class=\"fm-im\" src=\"@@STEP5@@\" alt=\"5단계: 위층이 깎여 땅 위로 드러난 조개 화석에 빨간 동그라미와 화석 발견 꼬리표\">\n        </div>\n        <div class=\"fm-ctl\">\n          <span>시간</span>\n          <input type=\"range\" class=\"fm-range\" min=\"0\" max=\"4\" step=\"0.01\" value=\"0\" aria-label=\"시간 막대: 오른쪽으로 끌면 화석이 만들어지는 다섯 단계가 차례로 바뀐다\">\n          <span>→</span>\n        </div>\n        <div class=\"fm-pills\" role=\"group\" aria-label=\"단계 고르기\">\n          <button type=\"button\" aria-pressed=\"true\">① 죽음</button><button type=\"button\" aria-pressed=\"false\">② 빨리 묻힘</button><button type=\"button\" aria-pressed=\"false\">③ 쌓여 굳음</button><button type=\"button\" aria-pressed=\"false\">④ 융기</button><button type=\"button\" aria-pressed=\"false\">⑤ 침식</button>\n        </div>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"tcard fm-now\" aria-live=\"polite\"><span data-edit=\"t-tag-1\" class=\"t-tag fm-tag\">1단계 / 5</span><h3 data-edit=\"fm-name\" class=\"fm-name\">죽음</h3><p class=\"fm-d\"></p></div>\n        <div class=\"t-col fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\">\n          <div class=\"tcard t-cond\">\n            <span data-edit=\"t-tag-2\" class=\"t-tag\">화석이 되기 쉬운 조건</span>\n            <ol class=\"cond3\">\n              <li><svg viewBox=\"0 0 150 86\" aria-hidden=\"true\"><g class=\"ci-shell\"><path d=\"M14 64 Q16 40 32 39 Q48 40 50 64 Z\"/><path d=\"M44 72 Q46 48 62 47 Q78 48 80 72 Z\"/><path d=\"M74 60 Q76 36 92 35 Q108 36 110 60 Z\"/><path d=\"M100 74 Q102 50 118 49 Q134 50 136 74 Z\"/><path d=\"M28 80 Q30 58 44 57 Q58 58 60 80 Z\"/><path d=\"M84 82 Q86 60 100 59 Q114 60 116 82 Z\"/></g></svg>\n                <p data-edit=\"p-1\">개체 수가 <b>많다</b> <small>많이 살수록 그중 몇은 남는다</small></p></li>\n              <li><svg viewBox=\"0 0 150 86\" aria-hidden=\"true\"><g class=\"ci-shell\"><path d=\"M10 70 Q12 26 40 24 Q68 26 70 70 Z\"/><path d=\"M40 70 L22 36 M40 70 L40 26 M40 70 L58 36\" class=\"rib\"/></g><g class=\"ci-bone\"><path d=\"M84 54 L130 38\"/><circle cx=\"82\" cy=\"48\" r=\"8\"/><circle cx=\"88\" cy=\"62\" r=\"8\"/><circle cx=\"126\" cy=\"30\" r=\"8\"/><circle cx=\"134\" cy=\"44\" r=\"8\"/></g></svg>\n                <p data-edit=\"p-2\"><b>단단한 부분</b>이 있다 <small>껍데기·뼈·이빨은 잘 썩지 않는다</small></p></li>\n              <li><svg viewBox=\"0 0 150 86\" aria-hidden=\"true\"><rect x=\"0\" y=\"58\" width=\"150\" height=\"28\" class=\"ci-mud\"/><g class=\"ci-fall\"><circle cx=\"30\" cy=\"14\" r=\"4\"/><circle cx=\"62\" cy=\"24\" r=\"4\"/><circle cx=\"96\" cy=\"10\" r=\"4\"/><circle cx=\"122\" cy=\"26\" r=\"4\"/><circle cx=\"46\" cy=\"38\" r=\"4\"/><circle cx=\"108\" cy=\"42\" r=\"4\"/></g><path d=\"M58 64 Q60 46 75 45 Q90 46 92 64 Z\" class=\"ci-buried\"/><rect x=\"0\" y=\"58\" width=\"150\" height=\"10\" class=\"ci-cover\"/></svg>\n                <p data-edit=\"p-3\">죽은 뒤 <b>빨리 묻힌다</b> <small>덮이기 전에 썩거나 먹히지 않는다</small></p></li>\n            </ol>\n          </div>\n          <div class=\"tcard t-note\">\n            <span data-edit=\"t-tag-3\" class=\"t-tag\">화석화 작용</span>\n            <div class=\"t-wood\"><img src=\"@@FS_WOOD@@\" alt=\"돌로 바뀐 나무줄기\"><p data-edit=\"p-4\">묻힌 몸의 성분이 오랜 세월 <b>다른 물질로 바뀌거나</b> 탄소만 남아 돌처럼 되는 일. 예) <b>규화목</b>: 나무 모양과 결은 그대로, 성분은 <b>이산화 규소</b>로 바뀌었다.</p></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"u-vid\" hidden>\n      <video muted playsinline preload=\"auto\" src=\"@@FOSSIL_VIDEO@@\" aria-label=\"화석이 만들어지는 다섯 단계 영상: 조개가 죽고, 진흙에 빨리 묻히고, 층이 쌓여 굳고, 땅이 솟아오르고, 위층이 깎여 화석이 드러난다\"></video>\n      <div class=\"u-vbar\"><button type=\"button\" class=\"u-vagain\">처음부터</button><button type=\"button\" class=\"u-vclose\">닫기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 14쪽 그림 I-1</b><span>층 수와 두께는 이해를 돕기 위한 그림</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.1.form */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 손전등으로 발자국 찾기(①) + 예측(②, 한 번 넘기면 답과 풀이)\n  part('tongsci2-1-1-1-1-form', (root) => window.T1.form(root));\n  part('tongsci2-1-1-1-1-form', (root) => window.L1.frame(root));   // «영상으로 한 번에 보기» 덮개(l1frame.js의 영상 단추)\n})();\n","needs":[],"media":{"STEP1":"step1.webp","STEP2":"step2.webp","STEP3":"step3.webp","STEP4":"step4.webp","STEP5":"step5.webp","FS_WOOD":"fs-wood.webp","FOSSIL_VIDEO":"FossilForm.mp4"}}