{"id":"tongsci2.1-1-1.1.kinds","unit":"tongsci2.1-1-1","html":"<!-- 5. 설명: 화석의 종류 -->\n<section id=\"tongsci2-1-1-1-1-kinds\" data-state=\"kinds\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 14~15쪽</div>\n        <h2 data-edit=\"h2\">화석의 종류: 시상 화석과 표준 화석</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">점을 옮겨 보며 조건을 찾자</p>\n    </div>\n    <div class=\"t-body t-kinds\">\n      <div class=\"kg-wrap\" data-prevent-swipe>\n        <svg class=\"kg\" viewBox=\"0 0 560 500\" role=\"group\" aria-label=\"가로축은 생물의 생존 기간(왼쪽 짧다, 오른쪽 길다), 세로축은 분포 면적(아래 좁다, 위 넓다). 점을 끌면 그 자리의 생물이 어떤 화석으로 쓰이는지 오른쪽에 나온다\">\n          <rect x=\"90\" y=\"20\" width=\"450\" height=\"400\" class=\"kg-bg kg-hit\"/>\n          <rect x=\"318\" y=\"223\" width=\"219\" height=\"194\" rx=\"10\" class=\"kg-q q-env\"/>\n          <rect x=\"93\" y=\"23\" width=\"219\" height=\"194\" rx=\"10\" class=\"kg-q q-std\"/>\n          <rect x=\"318\" y=\"23\" width=\"219\" height=\"194\" rx=\"10\" class=\"kg-q q-lw\"/>\n          <rect x=\"93\" y=\"223\" width=\"219\" height=\"194\" rx=\"10\" class=\"kg-q q-sn\"/>\n          <text x=\"427\" y=\"258\" class=\"kg-big env\">시상 화석</text>\n          <text x=\"202\" y=\"204\" class=\"kg-big std\">표준 화석</text>\n          <text x=\"427\" y=\"190\" class=\"kg-sm\">어느 쪽도 어려움</text>\n          <text x=\"202\" y=\"300\" class=\"kg-sm\">어느 쪽도 어려움</text>\n          <g class=\"kg-org\" data-k=\"fern\"><circle cx=\"352\" cy=\"388\" r=\"9\"/><text x=\"370\" y=\"395\">고사리</text></g>\n          <g class=\"kg-org\" data-k=\"coral\"><circle cx=\"352\" cy=\"340\" r=\"9\"/><text x=\"370\" y=\"347\">산호</text></g>\n          <g class=\"kg-org\" data-k=\"clam\"><circle cx=\"352\" cy=\"292\" r=\"9\"/><text x=\"370\" y=\"299\">조개</text></g>\n          <g class=\"kg-org\" data-k=\"tri\"><circle cx=\"132\" cy=\"62\" r=\"9\"/><text x=\"150\" y=\"69\">삼엽충</text></g>\n          <g class=\"kg-org\" data-k=\"amm\"><circle cx=\"132\" cy=\"112\" r=\"9\"/><text x=\"150\" y=\"119\">암모나이트</text></g>\n          <g class=\"kg-org\" data-k=\"num\"><circle cx=\"132\" cy=\"162\" r=\"9\"/><text x=\"150\" y=\"169\">화폐석</text></g>\n          <path d=\"M90 420 H 548 M540 412 L552 420 L540 428 M90 420 V 12 M82 22 L90 8 L98 22\" class=\"kg-ax\"/>\n          <text x=\"315\" y=\"470\" class=\"kg-at\">생존 기간 →</text>\n          <text x=\"104\" y=\"448\" class=\"kg-tick\" text-anchor=\"start\">짧다</text><text x=\"536\" y=\"448\" class=\"kg-tick\" text-anchor=\"end\">길다</text>\n          <text x=\"34\" y=\"140\" class=\"kg-at kg-vt\" writing-mode=\"tb\">분포 면적</text>\n          <text x=\"80\" y=\"412\" class=\"kg-tick\" text-anchor=\"end\">좁다</text><text x=\"80\" y=\"40\" class=\"kg-tick\" text-anchor=\"end\">넓다</text>\n          <g class=\"kg-pt\" tabindex=\"0\" role=\"slider\" aria-label=\"점: 끌거나 화살표 키로 옮긴다\"><circle r=\"22\" class=\"kg-pt-o\"/><circle r=\"8\" class=\"kg-pt-i\"/></g>\n        </svg>\n      </div>\n      <div class=\"t-col\">\n        <div class=\"kg-chips\" role=\"group\" aria-label=\"생물 고르기\"><span>생물 고르기</span>\n          <button type=\"button\" data-k=\"fern\">고사리</button><button type=\"button\" data-k=\"coral\">산호</button><button type=\"button\" data-k=\"clam\">조개</button>\n          <button type=\"button\" data-k=\"tri\">삼엽충</button><button type=\"button\" data-k=\"amm\">암모나이트</button><button type=\"button\" data-k=\"num\">화폐석</button>\n        </div>\n        <div class=\"tcard kres\" aria-live=\"polite\">\n          <figure><img class=\"kres-img\" alt=\"\"><small class=\"cr kres-cr\"></small></figure>\n          <div class=\"kres-txt\">\n            <span class=\"t-tag kres-tag\"></span>\n            <h3 class=\"kres-name\"></h3>\n            <p class=\"kres-org\"></p>\n            <p class=\"kres-why\"></p>\n            <p class=\"kres-tell\"></p>\n          </div>\n        </div>\n        <div class=\"kres-store\" hidden>\n          <img data-k=\"fern\" src=\"@@FS_FERN@@\" alt=\"검은 셰일에 남은 고사리 잎 화석\" data-cr=\"James St. John · CC BY 2.0\">\n          <img data-k=\"coral\" src=\"@@FS_CORAL@@\" alt=\"벌집처럼 작은 방이 모인 산호 화석\" data-cr=\"Wilson44691 · 퍼블릭 도메인\">\n          <img data-k=\"clam\" src=\"@@FS_SHELL@@\" alt=\"바위 판에 박힌 조개 화석\" data-cr=\"Yinan Chen · 퍼블릭 도메인\">\n          <img data-k=\"tri\" src=\"@@FS_TRI@@\" alt=\"몸이 세 갈래로 나뉜 삼엽충 화석\" data-cr=\"Wilson44691 · 퍼블릭 도메인\">\n          <img data-k=\"amm\" src=\"@@FS_AMM@@\" alt=\"나선 모양 껍데기에 주름이 있는 암모나이트 화석\" data-cr=\"Becks · CC BY 2.0\">\n          <img data-k=\"num\" src=\"@@FS_NUM@@\" alt=\"동전처럼 납작하고 둥근 화폐석 화석 여러 개\" data-cr=\"Wilson44691 · 퍼블릭 도메인\">\n        </div>\n      </div>\n      <div class=\"ktable fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\">\n        <table>\n          <thead><tr><th></th><th data-edit=\"th-1\">알려 주는 것</th><th data-edit=\"th-2\">생존 기간</th><th data-edit=\"th-3\">분포 면적</th><th data-edit=\"th-4\">예</th></tr></thead>\n          <tbody>\n            <tr class=\"env\"><th data-edit=\"th-5\">시상 화석</th><td data-edit=\"td-1\">쌓일 때의 <b>환경</b></td><td data-edit=\"td-2\"><b>길다</b></td><td data-edit=\"td-3\"><b>좁다</b>(특정한 환경)</td><td data-edit=\"td-4\">고사리 · 산호 · 조개</td></tr>\n            <tr class=\"std\"><th data-edit=\"th-6\">표준 화석</th><td data-edit=\"td-5\">쌓인 <b>시기</b></td><td data-edit=\"td-6\"><b>짧다</b></td><td data-edit=\"td-7\"><b>넓다</b></td><td data-edit=\"td-8\">삼엽충 · 암모나이트 · 화폐석</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 14~15쪽</b><span>그래프 위 생물의 자리는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.1.kinds */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 손전등으로 발자국 찾기(①) + 예측(②, 한 번 넘기면 답과 풀이)\n  part('tongsci2-1-1-1-1-kinds', (root) => window.T1.kinds(root));\n})();\n","needs":[],"media":{"FS_FERN":"fs-fern.webp","FS_CORAL":"fs-coral.webp","FS_SHELL":"fs-shell.webp","FS_TRI":"fs-tri.webp","FS_AMM":"fs-amm.webp","FS_NUM":"fs-num.webp"}}