{"id":"tongsci2.3-1.2.big","unit":"tongsci2.3-1","html":"<!-- 4. 이론: 빅데이터(Manim + 먼저 보고 놀라기) -->\n<section id=\"tongsci2-3-1-2-big\" data-state=\"big\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 134쪽 · 빅데이터</div>\n        <h2 data-edit=\"h2\">빅데이터란 무엇일까</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">모으기만 하면 쓸모가 생길까?</p>\n      <button type=\"button\" class=\"pk-open\" aria-expanded=\"false\">▶ 실제 영상</button>\n    </div>\n    <div class=\"t-body t-theo t-thm t-big\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def bg-def d1\"><span data-edit=\"t-tag-1\" class=\"t-tag\">빅데이터</span><p data-edit=\"p-1\">보통의 프로그램으로는 감당하기 힘들 만큼 <b>양이 많고</b>, 숫자·문자·영상·음성처럼 <b>형태가 다양</b>한 데이터</p></div>\n        <div class=\"tcard th-def bg-def d2\"><span data-edit=\"t-tag-2\" class=\"t-tag\">생겨나는 곳</span><p data-edit=\"p-2\"><b>센서</b>와 통신 기술 덕분에 스마트폰·인터넷·쇼핑·누리 소통망의 기록이 <b>디지털</b>로 쌓인다</p></div>\n        <div class=\"tcard th-def bg-def d3\"><span data-edit=\"t-tag-3\" class=\"t-tag\">빅데이터 기술</span><p data-edit=\"p-3\">분석해 <b>가치 있는 정보</b>를 찾아 쓴다 · 슈퍼컴퓨터와 <b>인공지능</b>이 돕는다</p></div>\n      </div>\n      <div class=\"st-fig\" data-prevent-swipe>\n        <div class=\"st-stage\">\n          <button type=\"button\" class=\"btn st-again\">다시 보기</button>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@BG1@@\" src=\"@@BG1_V@@\" aria-label=\"기상 위성, 관측소, 스마트폰, 스마트워치, 온라인 쇼핑에서 숫자·문자·영상·위치 데이터 조각이 쏟아져 나온다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@BG2@@\" src=\"@@BG2_V@@\" aria-label=\"흩어진 데이터 조각이 데이터 센터의 칸으로 빨려 들어가 0과 1로 쌓이고, 쌓인 양 막대가 가득 찬다\"></video>\n          <video class=\"st-im st-vid\" muted playsinline preload=\"auto\" poster=\"@@BG3@@\" src=\"@@BG3_V@@\" aria-label=\"바다 지도 위에 지난 태풍 기록 점들이 찍히고, 분석으로 찾은 패턴 선과 앞으로 갈 길 예측 범위가 그려진다\"></video>\n        </div>\n        <div class=\"st-ctl\"><span>①</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"2\" step=\"0.01\" value=\"0\" aria-label=\"단계 막대: 빅데이터가 생기고 쌓이고 분석되는 세 단계를 본다\"><span>③</span></div>\n        <div class=\"st-pills\" style=\"--n:3\" role=\"group\" aria-label=\"단계 고르기\"><button type=\"button\">① 생긴다</button><button type=\"button\">② 쌓인다</button><button type=\"button\">③ 분석한다</button></div>\n        <div class=\"tcard st-now st-cap\" aria-live=\"polite\"><span data-edit=\"t-tag-4\" class=\"t-tag st-tag\">1단계 / 3</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n      </div>\n      <ol class=\"st-text\" hidden>\n        <li><h4 data-edit=\"h4-1\">여러 곳에서 데이터가 생긴다</h4><p data-edit=\"p-4\">위성·관측소·스마트폰·시계·쇼핑 기록 — 모양도 여러 가지, 양도 <b>매우 많다</b>.</p></li>\n        <li><h4 data-edit=\"h4-2\">디지털로 모여 쌓인다</h4><p data-edit=\"p-5\">모은 데이터는 <b>디지털</b> 형태로 데이터 센터에 빠르게 쌓인다.</p></li>\n        <li><h4 data-edit=\"h4-3\">분석해 패턴을 찾는다</h4><p data-edit=\"p-6\">지난 태풍 기록에서 <b>패턴</b>을 찾아 앞으로 갈 길을 내다본다 → <b>가치 있는 정보</b>.</p></li>\n      </ol>\n    </div>\n    <div class=\"pk\" data-ans=\"data\" hidden>\n      <div class=\"pk-side\">\n        <span class=\"pk-kick\">먼저 보고 놀라기 · 예측 걸기</span>\n        <p data-edit=\"pk-q\" class=\"pk-q\">기상청은 태풍이 갈 길을 무엇으로 내다볼까?</p>\n        <div class=\"share-opts\" role=\"group\" aria-label=\"예측\"><button type=\"button\" data-k=\"sense\" aria-pressed=\"false\">예보관의 오랜 감</button><button type=\"button\" data-k=\"data\" aria-pressed=\"false\" data-why=\"위성이 짧은 간격으로 찍는 사진, 관측소·부이 기록까지 모두 데이터다. 이것을 분석해 길을 내다본다.\">위성·관측소에서 모은 많은 기록</button><button type=\"button\" data-k=\"one\" aria-pressed=\"false\">지난해 태풍 하나의 길</button></div>\n        <p class=\"pk-say\" aria-live=\"polite\"></p>\n        <div class=\"pk-row\"><button type=\"button\" class=\"btn pk-close\">이론 설명 보기 →</button><small class=\"cr\">영상: CSU/CIRA & JMA/JAXA(히마와리 위성) · 퍼블릭 도메인</small></div>\n      </div>\n      <div class=\"pk-vid\"><video muted playsinline preload=\"auto\" poster=\"@@STORM_P@@\" src=\"@@STORM_V@@\" aria-label=\"기상 위성이 적외선으로 찍은 태풍 힌남노: 붉은 구름 소용돌이 가운데 눈이 또렷하게 돈다\"></video><button type=\"button\" class=\"pk-play\">▶ 영상 보기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 134쪽</b><span>그림: Manim으로 그린 모형 · 점과 길은 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.2.big */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 가상 태풍의 예보 범위 + 예측(네 번째 단계에서 답 표시) · 사건 파일 2는 확인 장에서 푼다\n  part('tongsci2-3-1-2-big', (root) => {\n    const defs = [...root.querySelectorAll('.bg-def')];\n    root.addEventListener('st-step', (e) => defs.forEach((d, i) => d.classList.toggle('on', i === (e.detail === 0 ? 0 : e.detail === 1 ? 1 : 2))));\n    return window.RxT.join(window.RxT.stepper(root), window.RxPeek.mount(root));\n  });\n\n  // 5. 체험: 쌓인 데이터의 쓰임 — ① 카드 하나 ② 넷 다 ③ 친환경 운영\n})();\n","needs":[],"media":{"BG1":"bg1.webp","BG1_V":"bg1.mp4","BG2":"bg2.webp","BG2_V":"bg2.mp4","BG3":"bg3.webp","BG3_V":"bg3.mp4","STORM_P":"storm.webp","STORM_V":"storm.mp4"}}