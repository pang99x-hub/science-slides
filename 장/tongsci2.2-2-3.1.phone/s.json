{"id":"tongsci2.2-2-3.1.phone","unit":"tongsci2.2-2-3","html":"<!-- 4. 휴대 전화의 에너지 전환 -->\n<section id=\"tongsci2-2-2-3-1-phone\" data-state=\"phone\" class=\"std\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 110쪽 그림 Ⅱ-26 · 휴대 전화의 에너지 전환</div>\n        <h2 data-edit=\"h2\">휴대 전화 에너지 장부</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">재서 더하면 얼마일까?</p>\n    </div>\n    <div class=\"stage ph-stage\" data-prevent-swipe>\n      <svg class=\"ph-svg\" viewBox=\"0 0 1652 736\" role=\"img\" aria-label=\"충전기에서 들어온 전기 에너지가 전지에 화학 에너지로 저장되고, 휴대 전화를 쓰면 빛·소리·운동·열 에너지로 바뀌는 그림\">\n        <defs>\n          <radialGradient id=\"ph-scr\"><stop offset=\"0\" stop-color=\"#ffffff\"/><stop offset=\"1\" stop-color=\"#d7ecff\"/></radialGradient>\n          <radialGradient id=\"ph-warm\"><stop offset=\"0\" stop-color=\"#ff8a5c\" stop-opacity=\".75\"/><stop offset=\".6\" stop-color=\"#ff8a5c\" stop-opacity=\".25\"/><stop offset=\"1\" stop-color=\"#ff8a5c\" stop-opacity=\"0\"/></radialGradient>\n          <radialGradient id=\"ph-lightglow\"><stop offset=\"0\" stop-color=\"#fff6c4\" stop-opacity=\".9\"/><stop offset=\"1\" stop-color=\"#fff6c4\" stop-opacity=\"0\"/></radialGradient>\n        </defs>\n        <ellipse class=\"ph-floor\" cx=\"826\" cy=\"380\" rx=\"520\" ry=\"300\"/>\n        <!-- 흐름 띠: 휴대 전화 ↔ 에너지 거품 -->\n        <g class=\"ph-bands\">\n          <path class=\"ph-band\" data-e=\"chem\" style=\"--c: var(--e-chem)\" d=\"M700 470 C 640 470, 600 452, 556 450\"/>\n          <path class=\"ph-band\" data-e=\"kin\" style=\"--c: var(--e-kin)\" d=\"M704 250 C 640 240, 590 212, 536 200\"/>\n          <path class=\"ph-band\" data-e=\"light\" style=\"--c: var(--e-light-ink)\" d=\"M948 250 C 1010 240, 1060 196, 1114 186\"/>\n          <path class=\"ph-band\" data-e=\"heat\" style=\"--c: var(--e-heat)\" d=\"M952 400 C 1040 400, 1120 400, 1194 400\"/>\n          <path class=\"ph-band\" data-e=\"sound\" style=\"--c: var(--e-sound-ink)\" d=\"M948 596 C 1010 600, 1060 608, 1114 610\"/>\n        </g>\n        <!-- 콘센트·충전기 -->\n        <g class=\"ph-socket\" transform=\"translate(0 40)\">\n          <rect class=\"ph-wall\" x=\"40\" y=\"470\" width=\"110\" height=\"150\" rx=\"14\"/>\n          <rect class=\"ph-hole\" x=\"70\" y=\"500\" width=\"12\" height=\"30\" rx=\"4\"/><rect class=\"ph-hole\" x=\"108\" y=\"500\" width=\"12\" height=\"30\" rx=\"4\"/>\n          <rect class=\"ph-adapter\" x=\"62\" y=\"536\" width=\"70\" height=\"66\" rx=\"12\"/>\n          <path class=\"ph-bolt\" d=\"M100 546 l -12 24 h 12 l -6 22 l 18 -28 h -12 l 8 -18 z\"/>\n        </g>\n        <path class=\"ph-cable\" d=\"M132 610 C 300 630, 412 768, 612 718\"/>\n        <path class=\"ph-cflow\" d=\"M132 610 C 300 630, 412 768, 612 718\"/>\n        <g class=\"ph-plugend\"><rect class=\"ph-plughead\" x=\"806\" y=\"660\" width=\"40\" height=\"28\" rx=\"6\"/><rect class=\"ph-plugpin\" x=\"816\" y=\"650\" width=\"20\" height=\"12\" rx=\"2\"/></g>\n        <!-- 휴대 전화 -->\n        <g class=\"ph-phone\">\n          <ellipse class=\"ph-heatglow\" cx=\"826\" cy=\"400\" rx=\"230\" ry=\"300\" fill=\"url(#ph-warm)\"/>\n          <ellipse class=\"ph-lightg\" cx=\"826\" cy=\"380\" rx=\"200\" ry=\"260\" fill=\"url(#ph-lightglow)\"/>\n          <rect class=\"ph-body\" x=\"696\" y=\"120\" width=\"260\" height=\"530\" rx=\"40\"/>\n          <rect class=\"ph-screen\" x=\"712\" y=\"150\" width=\"228\" height=\"470\" rx=\"22\"/>\n          <rect class=\"ph-notch\" x=\"796\" y=\"158\" width=\"60\" height=\"14\" rx=\"7\"/>\n          <rect class=\"ph-port\" x=\"808\" y=\"640\" width=\"36\" height=\"8\" rx=\"3\"/>\n          <g class=\"ph-spk\"><circle cx=\"760\" cy=\"644\" r=\"3\"/><circle cx=\"772\" cy=\"644\" r=\"3\"/><circle cx=\"880\" cy=\"644\" r=\"3\"/><circle cx=\"892\" cy=\"644\" r=\"3\"/></g>\n          <g class=\"ph-vibl\"><path d=\"M676 300 l -16 14 l 16 14 l -16 14 l 16 14\"/><path d=\"M976 300 l 16 14 l -16 14 l 16 14 l -16 14\"/></g>\n        </g>\n        <g class=\"ph-sw\"><path d=\"M940 600 q 30 24 0 48\"/><path d=\"M970 584 q 46 40 0 80\"/></g>\n        <g class=\"ph-hw\"><path d=\"M790 100 c -12 -14 12 -22 0 -36\"/><path d=\"M826 96 c -12 -14 12 -22 0 -36\"/><path d=\"M862 100 c -12 -14 12 -22 0 -36\"/></g>\n        <!-- 에너지 거품 -->\n        <g class=\"ph-bub\" data-e=\"kin\" style=\"--c: var(--e-kin)\" transform=\"translate(450 200)\"><circle r=\"86\"/><g class=\"ph-tag\" transform=\"translate(-86 -108)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">운동 에너지</text></g><text class=\"ph-say\" y=\"10\">휴대 전화가</text><text class=\"ph-say\" y=\"40\">떨린다</text></g>\n        <g class=\"ph-bub\" data-e=\"chem\" style=\"--c: var(--e-chem)\" transform=\"translate(470 450)\"><circle r=\"86\"/><g class=\"ph-tag\" transform=\"translate(-86 -108)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">화학 에너지</text></g><text class=\"ph-say\" y=\"10\">전지에</text><text class=\"ph-say\" y=\"40\">저장된다</text></g>\n        <g class=\"ph-bub\" data-e=\"elec\" style=\"--c: var(--e-elec)\" transform=\"translate(96 700)\"><g class=\"ph-tag\" transform=\"translate(-86 -22)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">전기 에너지</text></g></g>\n        <g class=\"ph-bub\" data-e=\"light\" style=\"--c: var(--e-light)\" transform=\"translate(1200 186)\"><circle r=\"86\"/><g class=\"ph-tag\" transform=\"translate(-86 -108)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">빛에너지</text></g><text class=\"ph-say\" y=\"10\">화면이</text><text class=\"ph-say\" y=\"40\">빛난다</text></g>\n        <g class=\"ph-bub\" data-e=\"heat\" style=\"--c: var(--e-heat)\" transform=\"translate(1280 400)\"><circle r=\"86\"/><g class=\"ph-tag\" transform=\"translate(-86 -108)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">열에너지</text></g><text class=\"ph-say\" y=\"10\">휴대 전화가</text><text class=\"ph-say\" y=\"40\">따뜻해진다</text></g>\n        <g class=\"ph-bub\" data-e=\"sound\" style=\"--c: var(--e-sound)\" transform=\"translate(1200 610)\"><circle r=\"86\"/><g class=\"ph-tag\" transform=\"translate(-86 -108)\"><rect width=\"172\" height=\"44\" rx=\"22\"/><text x=\"86\" y=\"30\">소리 에너지</text></g><text class=\"ph-say\" y=\"10\">스피커에서</text><text class=\"ph-say\" y=\"40\">소리가 난다</text></g>\n      </svg>\n      <!-- 휴대 전화 화면(직접 누르는 곳) -->\n      <div class=\"ph-ui\">\n        <div class=\"ph-status\"><span class=\"ph-clock\">10:30</span><span class=\"ph-bat\"><i><b></b></i><em class=\"ph-pct\">60%</em></span></div>\n        <div class=\"ph-app\">\n          <p data-edit=\"ph-hello\" class=\"ph-hello\">무엇을 해 볼까?</p>\n          <label class=\"ph-bri\"><span>화면 밝기</span><input type=\"range\" id=\"ph-bright\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"화면 밝기\"></label>\n          <button type=\"button\" class=\"ph-key\" id=\"ph-music\" aria-pressed=\"false\"><span aria-hidden=\"true\">♪</span>음악</button>\n          <button type=\"button\" class=\"ph-key\" id=\"ph-vib\" aria-pressed=\"false\"><span aria-hidden=\"true\">〰</span>진동</button>\n          <p data-edit=\"ph-chg\" class=\"ph-chg\">충전기를 꽂아 보세요</p>\n        </div>\n      </div>\n      <div class=\"tools\"><button class=\"btn\" type=\"button\" id=\"ph-plug\" aria-pressed=\"false\">충전기 꽂기</button></div>\n      <p class=\"ph-sum\" aria-live=\"polite\"></p>\n      <div class=\"ph-ledger\" aria-live=\"polite\">\n        <span data-edit=\"tag\" class=\"tag\">에너지 장부</span>\n        <div class=\"lg-in\"><span>전지에서 나간 전기</span><em>100 J</em></div>\n        <div class=\"lg-rows\">\n          <div class=\"lg-row\" data-e=\"light\" style=\"--c: var(--e-light)\"><span>빛</span><em>?</em></div>\n          <div class=\"lg-row\" data-e=\"sound\" style=\"--c: var(--e-sound)\"><span>소리</span><em>?</em></div>\n          <div class=\"lg-row\" data-e=\"kin\" style=\"--c: var(--e-kin)\"><span>운동</span><em>?</em></div>\n          <div class=\"lg-row\" data-e=\"heat\" style=\"--c: var(--e-heat)\"><span>열</span><em>?</em></div>\n        </div>\n        <div class=\"lg-sum\"><span>잰 에너지의 합</span><em>0 J</em></div>\n        <p data-edit=\"lg-say\" class=\"lg-say\">측정기를 대고 «100 J 써 보기»</p>\n        <p data-edit=\"lg-law\" class=\"lg-law\"><b>에너지 보존 법칙</b> 바뀌기 전 총량 = 바뀐 뒤 총량</p>\n      </div>\n    </div>\n    <div class=\"ph-meters tray\" aria-label=\"측정기(끌어다 에너지 거품에 대기)\" data-prevent-swipe>\n      <span class=\"tray-tag\">측정기</span>\n      <button type=\"button\" class=\"ph-meter tray-item\" data-e=\"light\">☀ 빛 측정기</button>\n      <button type=\"button\" class=\"ph-meter tray-item\" data-e=\"sound\">♪ 소리 측정기</button>\n      <button type=\"button\" class=\"ph-meter tray-item\" data-e=\"kin\">〰 떨림 측정기</button>\n      <button type=\"button\" class=\"ph-meter tray-item\" data-e=\"heat\">🌡 온도계</button>\n      <div class=\"tray-end\"><p class=\"ph-runs\"></p><button class=\"btn play\" type=\"button\" id=\"ph-run\">100 J 써 보기</button></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 110쪽 그림 Ⅱ-26</b><span>에너지는 새로 생기거나 사라지지 않는다 · 값은 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-2-3.1.phone */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (...p) => window.RxT.join(...p);\n  // 한 묶음에서 하나만 누르게(다시 누르면 풀림)\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const dock = (root, cfg) => window.UDock.mount(root, cfg);\n  part('tongsci2-2-2-3-1-phone', (root) => J(window.PhoneLab.mount(root), dock(root, {\n    steps: ['충전기 꽂기', '측정기 대기', '100 J 써 보기'],\n    on: ['#ph-plug, .ph-chg', (r) => r.querySelector('.ph-bub.metered'), (r) => r.querySelector('.ph-ledger.done')],   // ②③은 실제로 대고 넷 다 재야 끝(먼저 눌러도 ✓가 붙지 않게)\n    learn: '넷을 모두 재면 합이 공급한 <b>100 J</b>과 같다 — 에너지 보존 법칙. 열은 0이 되지 않는다.',\n  })));\n})();\n","needs":["drag","phone"],"media":{}}