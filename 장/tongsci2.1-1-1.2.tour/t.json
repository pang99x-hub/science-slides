{"id":"tongsci2.1-1-1.2.tour","unit":"tongsci2.1-1-1","html":"<!-- 4. 설명: 시대 탐험기 -->\n<section id=\"tongsci2-1-1-1-2-tour\" data-state=\"tour\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 16~17쪽 그림 I-4~I-10 · 지질 시대의 환경과 생물</div>\n        <h2 data-edit=\"h2\">시대 탐험기: 환경과 생물</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">시대마다 땅·바다·생물은 어땠을까?</p>\n    </div>\n    <div class=\"t-body t-tour\">\n      <div class=\"tr-left\" data-prevent-swipe>\n        <div class=\"tr-eras\" role=\"group\" aria-label=\"시대 고르기\">\n          <button type=\"button\" data-k=\"pc\" data-name=\"선캄브리아시대\" aria-pressed=\"false\"><i style=\"--c:#c7b8a3\"></i>선캄브리아시대</button>\n          <button type=\"button\" data-k=\"pz\" data-name=\"고생대\" aria-pressed=\"false\"><i style=\"--c:#5b8fd0\"></i>고생대</button>\n          <button type=\"button\" data-k=\"mz\" data-name=\"중생대\" aria-pressed=\"false\"><i style=\"--c:#4fa36b\"></i>중생대</button>\n          <button type=\"button\" data-k=\"cz\" data-name=\"신생대\" aria-pressed=\"false\"><i style=\"--c:#e0a03a\"></i>신생대</button>\n        </div>\n        <div class=\"tr-scene\">\n          <svg class=\"tr-svg\" viewBox=\"0 0 1000 600\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"고른 시대의 바다와 뭍 풍경. 그 시대에 살던 대표 생물이 그려져 있다\"></svg>\n          <figure class=\"tr-map\">\n            <img data-k=\"pz\" src=\"@@MAP_PZ@@\" alt=\"고생대 말의 지구: 대륙이 한 덩어리로 모인 판게아\" hidden>\n            <img data-k=\"mz\" src=\"@@MAP_MZ@@\" alt=\"중생대 중기의 지구: 판게아가 갈라지며 대서양이 좁게 열림\" hidden>\n            <img data-k=\"cz\" src=\"@@MAP_CZ@@\" alt=\"신생대의 지구: 지금과 비슷한 대륙 배치\" hidden>\n            <span class=\"tr-nomap\" hidden>?</span>\n            <figcaption data-edit=\"figcaption\">수륙 분포</figcaption>\n          </figure>\n          <div class=\"tr-big\" hidden>\n            <img alt=\"\">\n            <div class=\"tr-bigtxt\"><b></b><p></p><small class=\"cr\"></small></div>\n            <button type=\"button\" class=\"btn tr-close\">닫기</button>\n          </div>\n        </div>\n        <div class=\"tr-thumbs\" role=\"group\" aria-label=\"이 시대의 화석 사진: 누르면 크게 보인다\"></div>\n      </div>\n      <div class=\"t-col tr-right\">\n        <div class=\"tr-head\"><span data-edit=\"t-tag\" class=\"t-tag tr-tag\">선캄브리아시대</span><span class=\"tr-span\"></span></div>\n        <dl class=\"tr-rows\">\n          <div><dt data-edit=\"dt-1\">기후</dt><dd></dd></div>\n          <div><dt data-edit=\"dt-2\">땅과 바다</dt><dd></dd></div>\n          <div><dt data-edit=\"dt-3\">바다 생물</dt><dd></dd></div>\n          <div><dt data-edit=\"dt-4\">육지 생물</dt><dd></dd></div>\n          <div class=\"tr-last\"><dt data-edit=\"tr-end\" class=\"tr-end\">끝날 때</dt><dd></dd></div>\n        </dl>\n      </div>\n    </div>\n    <div class=\"tr-store\" hidden>\n      <img data-era=\"pc\" src=\"@@ERA_STROM_FOS@@\" data-name=\"스트로마톨라이트\" data-d=\"남세균 막이 쌓여 생긴 얇은 층. 가장 오래된 생명의 흔적 가운데 하나.\" data-cr=\"James St. John · CC BY 2.0\" alt=\"얇은 층이 물결처럼 쌓인 돌의 단면\">\n      <img data-era=\"pc\" src=\"@@ERA_DICK@@\" data-name=\"에디아카라 생물군\" data-d=\"뼈와 껍데기가 없는 초기 다세포 생물의 자국(오스트레일리아).\" data-cr=\"Verisimilus · CC BY 2.5\" alt=\"가는 마디가 늘어선 타원형 생물 자국\">\n      <img data-era=\"pc\" src=\"@@ERA_STROM_LIVE@@\" data-name=\"지금의 스트로마톨라이트\" data-d=\"오스트레일리아 바닷가에서 지금도 자란다. 옛 바다를 짐작하는 단서.\" data-cr=\"Bryn Pinzgauer · CC BY 2.0\" alt=\"바닷가 얕은 물에 둥근 바위들이 솟은 모습\">\n      <img data-era=\"pz\" src=\"@@FS_TRI@@\" data-name=\"삼엽충\" data-d=\"몸이 세로로 세 갈래. 고생대 바다 바닥을 기어 다녔다(고생대 표준 화석).\" data-cr=\"Wilson44691 · 퍼블릭 도메인\" alt=\"몸이 세 갈래로 나뉜 삼엽충 화석\">\n      <img data-era=\"pz\" src=\"@@ERA_BRACH@@\" data-name=\"완족류\" data-d=\"껍데기 두 장을 가진 바다 동물. 조개와 닮았지만 다른 무리다.\" data-cr=\"Rynoceras · CC BY-SA 4.0\" alt=\"부채꼴 줄무늬 껍데기를 가진 완족류 화석\">\n      <img data-era=\"pz\" src=\"@@ERA_FISH@@\" data-name=\"갑주어(어류)\" data-d=\"머리가 단단한 뼈판으로 덮인 옛 물고기의 머리뼈를 되살린 모형.\" data-cr=\"LadyofHats · 퍼블릭 도메인\" alt=\"두꺼운 뼈판으로 덮인 커다란 물고기 머리뼈 모형\">\n      <img data-era=\"pz\" src=\"@@FS_FERN@@\" data-name=\"양치식물\" data-d=\"홀씨로 퍼지는 고사리 무리. 늪가 숲이 묻혀 석탄층이 되었다.\" data-cr=\"James St. John · CC BY 2.0\" alt=\"검은 돌에 남은 고사리 잎 화석\">\n      <img data-era=\"mz\" src=\"@@FS_AMM@@\" data-name=\"암모나이트\" data-d=\"돌돌 말린 껍데기 속에 방이 여럿. 중생대 표준 화석.\" data-cr=\"Becks · CC BY 2.0\" alt=\"나선 모양 껍데기의 암모나이트 화석\">\n      <img data-era=\"mz\" src=\"@@ERA_TARBO@@\" data-name=\"공룡(타르보사우루스)\" data-d=\"몽골에서 나온 육식 공룡의 뼈대. 중생대 뭍을 차지한 파충류.\" data-cr=\"Dudva · CC0\" alt=\"박물관에 세워진 큰 육식 공룡 뼈대\">\n      <img data-era=\"mz\" src=\"@@ERA_GINKGO@@\" data-name=\"은행나무 잎(겉씨식물)\" data-d=\"부채 모양 잎이 돌에 찍혔다. 씨가 겉으로 드러나는 식물.\" data-cr=\"Daderot · CC0\" alt=\"돌판에 찍힌 부채 모양 은행나무 잎 화석\">\n      <img data-era=\"mz\" src=\"@@ERA_ARCHAE@@\" data-name=\"시조새\" data-d=\"깃털·날개와 함께 이빨·긴 꼬리뼈가 있다. 새와 파충류의 특징을 함께 지녔다(본뜬 것).\" data-cr=\"HTO · 퍼블릭 도메인\" alt=\"돌판에 날개와 깃털 자국이 펼쳐진 시조새 화석을 본뜬 것\">\n      <img data-era=\"cz\" src=\"@@FS_NUM@@\" data-name=\"화폐석\" data-d=\"동전처럼 납작하고 둥근 껍데기. 신생대 표준 화석.\" data-cr=\"Wilson44691 · 퍼블릭 도메인\" alt=\"동전 모양 화폐석 화석 여러 개\">\n      <img data-era=\"cz\" src=\"@@ERA_MAMMOTH@@\" data-name=\"매머드(포유류)\" data-d=\"긴 엄니를 가진 코끼리 무리. 빙하기 들판에 살았다.\" data-cr=\"KKPCW · CC BY-SA 4.0\" alt=\"긴 엄니가 휜 매머드 뼈대\">\n      <img data-era=\"cz\" src=\"@@ERA_LEAF@@\" data-name=\"단풍나무 잎(속씨식물)\" data-d=\"꽃이 피고 열매를 맺는 식물의 잎 화석.\" data-cr=\"Daderot · CC0\" alt=\"돌에 찍힌 단풍잎 모양 화석\">\n      <img data-era=\"cz\" src=\"@@ERA_AUSTRA@@\" data-name=\"인류의 조상\" data-d=\"신생대 끝 무렵 나타난 인류 조상 무리의 머리뼈.\" data-cr=\"Daderot · CC0\" alt=\"박물관에 놓인 인류 조상의 머리뼈\">\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 16~17쪽 그림 I-4~I-10</b><span>풍경은 특징을 살려 간단히 그린 것 · 둥근 지구 그림은 3차시 3D 지구로 찍은 대략의 모습 · 사진: 위키미디어 공용</span></div>\n  <aside class=\"notes\">\n설명 «시대 탐험기» (10분) — 이 차시의 중심 장. 시대 단추를 차례로 누르며 다섯 칸을 함께 읽는다\n- 왼쪽 위 시대 단추 넷 → 풍경, 왼쪽 위 둥근 지구(수륙 분포), 오른쪽 다섯 칸(기후·땅과 바다·바다 생물·육지 생물·끝날 때), 아래 화석 사진 줄이 모두 바뀐다. 사진을 누르면 풍경 위에 크게, 다시 누르거나 «닫기»로 닫는다.\n- 시대마다 순서: ① 풍경에서 무엇이 보이나 → ② 기후 → ③ 땅과 바다(둥근 지구) → ④ 바다·육지 생물(사진) → ⑤ 끝날 때.\n  · 선캄브리아시대: 지구 그림 대신 «?» — 지층이 휘고 깨져 대륙 모습을 알기 어렵다. 앞 장의 산소 이야기와 잇는다.\n  · 고생대: 껍데기·뼈가 단단한 바다 생물(삼엽충·완족류) → 어류 → 오존층 뒤 뭍으로(양치식물·양서류·거대 곤충). 말기 판게아 + 한랭 → 가장 큰 대멸종.\n  · 중생대: 빙하 없이 온난(화산 → 이산화 탄소 → 온실 효과). 판게아가 갈라짐. 공룡·겉씨식물·시조새 / 암모나이트·해양 파충류. 말기 공룡·암모나이트 멸종.\n  · 신생대: 중기까지 온난 → 말기 빙하기·간빙기. 대서양 확대·히말라야. 화폐석, 매머드 같은 포유류, 속씨식물, 인류의 조상.\n- 학습지 B 표의 빈칸으로 둘 말(굵은 글씨): 남세균·스트로마톨라이트·판게아·오존층·삼엽충·암모나이트·공룡·겉씨식물·화폐석·속씨식물·빙하기.\n- 스스로 확인하기(17쪽) ➊ 삼엽충은 고생대(○) ➋ 신생대 말 간빙기와 되풀이 → 빙하기. 추가 정리 문제: 중생대 번성 생물 → 공룡·암모나이트.\n- 사진 설명: 갑주어는 머리뼈를 되살린 모형(둔클레오스테우스), 시조새는 베를린 표본을 본뜬 것, 공룡 뼈대는 몽골의 타르보사우루스.\n- 유의점: 둥근 지구 그림의 대륙 모양·자리는 대략이다(3차시에서 직접 돌려 본다).\n  </aside>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.2.tour */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n\n  // 1. 표지: 시대 풍경 순서 맞추기 + 예측(한 번 넘기면 답 표시)\n  const EVID = ['fold', 'coal', 'ash', 'glac'];\n  part('tongsci2-1-1-1-2-tour', (root) => window.T2.tour(root));\n  // 5. 설명: 대표 화석 3D\n})();\n","needs":["teach2","eralens"],"media":{"MAP_PZ":"map-pz.webp","MAP_MZ":"map-mz.webp","MAP_CZ":"map-cz.webp","ERA_STROM_FOS":"era-strom-fos.webp","ERA_DICK":"era-dick.webp","ERA_STROM_LIVE":"era-strom-live.webp","FS_TRI":"fs-tri.webp","ERA_BRACH":"era-brach.webp","ERA_FISH":"era-fish.webp","FS_FERN":"fs-fern.webp","FS_AMM":"fs-amm.webp","ERA_TARBO":"era-tarbo.webp","ERA_GINKGO":"era-ginkgo.webp","ERA_ARCHAE":"era-archae.webp","FS_NUM":"fs-num.webp","ERA_MAMMOTH":"era-mammoth.webp","ERA_LEAF":"era-leaf.webp","ERA_AUSTRA":"era-austra.webp"}}