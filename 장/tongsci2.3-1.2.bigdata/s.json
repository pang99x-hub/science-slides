{"id":"tongsci2.3-1.2.bigdata","unit":"tongsci2.3-1","html":"<!-- 5. 빅데이터의 축적과 활용 -->\n<section id=\"tongsci2-3-1-2-bigdata\" data-state=\"bigdata\" class=\"std evx\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 134~135쪽 그림 Ⅲ-2 · 138쪽 데이터 센터</div>\n        <h2 data-edit=\"h2\">쌓인 데이터는 어디에 쓰일까</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">쓰임에 맞는 데이터를 찾아 보자</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"sim-col\" data-prevent-swipe>\n        <div class=\"stage bd-stage\">\n          <svg class=\"bd-svg\" viewBox=\"0 0 1056 560\" role=\"img\" aria-label=\"네 가지 데이터(상품 구매 기록, 유전체 연구 자료, 과학 실험 결과, 언어 자료)가 데이터 센터로 모여 분석되고, 쓰임이 오른쪽에 나타난다\"></svg>\n        </div>\n        <div class=\"bd-tray tray\" aria-label=\"쓰임 카드와 친환경 운영 카드(끌어다 놓기)\">\n          <div class=\"tray-row\"><span class=\"tray-tag\">쓰임</span>\n            <button type=\"button\" class=\"bd-use tray-item\" data-k=\"shop\">운동화 추천</button>\n            <button type=\"button\" class=\"bd-use tray-item\" data-k=\"gene\">질병 예측·맞춤 치료</button>\n            <button type=\"button\" class=\"bd-use tray-item\" data-k=\"lab\">신약 후보 찾기</button>\n            <button type=\"button\" class=\"bd-use tray-item\" data-k=\"lang\">외국어 번역</button>\n            <div class=\"tray-end\"><button class=\"btn\" type=\"button\" id=\"bd-all\">정답 보기</button></div>\n          </div>\n          <div class=\"tray-row\"><span class=\"tray-tag\">친환경 운영</span>\n            <button type=\"button\" class=\"bd-eco tray-item\" data-k=\"ren\">재생 에너지로 전기 만들기</button>\n            <button type=\"button\" class=\"bd-eco tray-item\" data-k=\"sea\">찬 바닷속에 서버 두기</button>\n          </div>\n        </div>\n      </div>\n      <div class=\"panel bd-panel\">\n        <ol class=\"u-steps\"><li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 쓰임 카드를 그 일에 필요한 데이터 위에 놓는다</li><li data-edit=\"li-2\" data-s=\"2\"><b>②</b> 네 쓰임을 모두 찾고 전기·열 막대를 본다</li><li data-edit=\"li-3\" data-s=\"3\"><b>③</b> 친환경 운영 카드를 데이터 센터에 붙인다</li></ol>\n        <p data-edit=\"bd-msg\" class=\"bd-msg\" aria-live=\"polite\">쓰임 카드를 그 일에 필요한 데이터 위에 끌어 놓아 보자</p>\n        <div class=\"bd-meters\">\n          <div class=\"bd-m\" data-k=\"elec\"><span>데이터 센터가 쓰는 전기</span><b><i class=\"grid\"></i><i class=\"green\"></i></b></div>\n          <div class=\"bd-m\" data-k=\"heat\"><span>식혀야 할 열</span><b><i></i></b></div>\n          <p data-edit=\"kp-note\" class=\"kp-note\">막대는 비교를 위한 그림(값 없음)</p>\n        </div>\n        <div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p\">쌓인 데이터는 분석해야 <b>쓸모</b>가 생긴다. 분석이 늘수록 데이터 센터의 <b>전기</b>도 늘어 친환경 운영이 필요하다.</p></div>\n        <div class=\"def fragment custom\" data-anim=\"mark\" data-fragment-index=\"0\"><p><span data-edit=\"mark\" class=\"mark\"><b>빅데이터</b></span> 매우 많은 양의 데이터. 여러 분야의 기록이 디지털로 모이고, 분석하면 뜻있는 정보가 나온다. 쌓고 분석하는 일은 슈퍼컴퓨터·인공지능이 맡는다.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 134~135쪽 · 138쪽</b><span>데이터 센터는 쉬지 않고 돌아 같은 크기의 다른 건물보다 전기를 많이 쓴다</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-1.2.bigdata */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const { track, rows, single } = window.U31;\n\n  // 1. 표지: 가상 태풍의 예보 범위 + 예측(네 번째 단계에서 답 표시) · 사건 파일 2는 확인 장에서 푼다\n  part('tongsci2-3-1-2-bigdata', (root) => {\n    const m = window.BigData.mount(root);\n    track(root, () => {\n      const u = root.querySelectorAll('.bd-use.used').length, e = root.querySelectorAll('.bd-eco.used').length;\n      return u === 0 ? 1 : u < 4 ? 2 : e === 0 ? 3 : 0;\n    });\n    return m;\n  });\n\n  // 6. 이론: 활용과 장점·문제점 — 사진을 누르면 왼쪽 표의 같은 줄이 밝아진다\n})();\n","needs":["bigdata"],"media":{}}