{"id":"tongsci1.2-2-1.2.prtheory","unit":"tongsci1.2-2-1","html":"<!-- 이론: 아미노산에서 단백질까지 -->\n<section id=\"tongsci1-2-2-1-2-prtheory\" data-state=\"prtheory\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 82쪽 · 그림 Ⅱ-29 단백질의 형성</div>\n        <h2 data-edit=\"h2\">아미노산에서 단백질까지</h2>\n      </div>\n      <button type=\"button\" class=\"btn st-again\">영상 다시 보기</button>\n    </div>\n    <div class=\"t-body t-devel\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def\"><span data-edit=\"t-tag-1\" class=\"t-tag\">▣ 아미노산</span><p data-edit=\"p-1\">단백질의 <b>기본 단위체</b>, 약 <b>20</b>종</p><p data-edit=\"t-sub-1\" class=\"t-sub\">가운데 탄소에 아미노기·카복실기·수소·곁사슬 — 곁사슬만 서로 다르다</p></div>\n        <div class=\"tcard th-def\"><span data-edit=\"t-tag-2\" class=\"t-tag\">▣ 펩타이드 결합</span><p data-edit=\"p-2\">이웃한 아미노산 사이에서 <b>물 한 분자</b>가 빠지며 생기는 공유 결합</p><p data-edit=\"t-sub-2\" class=\"t-sub\">길게 이어진 사슬 = 폴리펩타이드 → 접혀 입체 구조의 단백질</p></div>\n        <div class=\"tcard st-now\" aria-live=\"polite\"><span data-edit=\"t-tag-3\" class=\"t-tag st-tag\">1단계 / 4</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n      </div>\n      <div class=\"st-fig\" data-prevent-swipe>\n        <div class=\"st-stage\">\n          <video class=\"st-im\" muted playsinline preload=\"auto\" src=\"@@PR1_V@@\" poster=\"@@PR1@@\" aria-label=\"가운데 C에 왼쪽 H₂N, 오른쪽 COOH, 위 H, 아래 초록 R이 붙은 아미노산\"></video>\n          <video class=\"st-im\" muted playsinline preload=\"auto\" src=\"@@PR2_V@@\" poster=\"@@PR2@@\" aria-label=\"두 아미노산 사이에서 OH와 H가 H₂O로 빠져나가고 노란 막대로 이어진다\"></video>\n          <video class=\"st-im\" muted playsinline preload=\"auto\" src=\"@@PR3_V@@\" poster=\"@@PR3@@\" aria-label=\"여러 색 구슬이 노란 선으로 길게 이어진 사슬\"></video>\n          <video class=\"st-im\" muted playsinline preload=\"auto\" src=\"@@PR4_V@@\" poster=\"@@PR4@@\" aria-label=\"길던 구슬 사슬이 꼬이며 한 덩어리로 접힌다\"></video>\n        </div>\n        <div class=\"st-ctl\"><span>아미노산</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0\" aria-label=\"단백질 형성 네 단계\"><span>단백질</span></div>\n        <div class=\"st-pills\" style=\"--n:4\" role=\"group\" aria-label=\"단계 고르기\"><button type=\"button\" aria-pressed=\"true\">① 아미노산</button><button type=\"button\" aria-pressed=\"false\">② 펩타이드 결합</button><button type=\"button\" aria-pressed=\"false\">③ 폴리펩타이드</button><button type=\"button\" aria-pressed=\"false\">④ 단백질</button></div>\n      </div>\n      <ol class=\"st-text\" hidden>\n        <li><h4 data-edit=\"h4-1\">아미노산</h4><p data-edit=\"p-3\">단백질의 <b>기본 단위체</b>. 곁사슬(R)이 달라 약 20종류.</p></li>\n        <li><h4 data-edit=\"h4-2\">펩타이드 결합</h4><p data-edit=\"p-4\">카복실기의 OH와 아미노기의 H가 <b>물</b>로 빠지며 두 아미노산이 이어진다.</p></li>\n        <li><h4 data-edit=\"h4-3\">폴리펩타이드</h4><p data-edit=\"p-5\">여러 아미노산이 정해진 <b>순서</b>로 길게 이어진 사슬.</p></li>\n        <li><h4 data-edit=\"h4-4\">단백질</h4><p data-edit=\"p-6\">사슬이 꺾이고 꼬여 고유한 <b>입체 구조</b> → 그 모양에 맞는 일을 한다.</p></li>\n      </ol>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 82쪽</b><span>그림: Manim으로 그린 설명 그림</span></div>\n</section>","css":"\n","js":"/* tongsci1.2-2-1.2.prtheory */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  part('tongsci1-2-2-1-2-prtheory', (root) => window.RxT.stepper(root));\n})();\n","needs":[],"media":{"PR1_V":"pr1.mp4","PR1":"pr1.webp","PR2_V":"pr2.mp4","PR2":"pr2.webp","PR3_V":"pr3.mp4","PR3":"pr3.webp","PR4_V":"pr4.mp4","PR4":"pr4.webp"}}