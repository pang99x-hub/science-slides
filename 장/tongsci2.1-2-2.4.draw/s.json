{"id":"tongsci2.1-2-2.4.draw","unit":"tongsci2.1-2-2","html":"<!-- 3. 이온 수 그래프 -->\n<section id=\"tongsci2-1-2-2-4-draw\" data-state=\"draw\" class=\"std evx\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">체험 · 교과서 52쪽 · 중화점 앞뒤의 입자 수</div>\n        <h2 data-edit=\"h2\">이온 수, 먼저 그려 보기</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">내가 그린 선은 맞을까?</p>\n    </div>\n    <div class=\"body sim\">\n      <div class=\"ab-col\" data-prevent-swipe>\n        <div class=\"ab-stage\">\n          <svg class=\"ab-svg ab-dr-svg\" viewBox=\"0 0 1000 620\" role=\"img\" aria-label=\"빈 그래프: 가로는 넣은 NaOH 수용액 0~20 mL, 세로는 고른 입자의 수. 손가락으로 예상 선을 그린 뒤 모형 선과 맞춰 본다\"></svg>\n          <p data-edit=\"ab-now\" class=\"ab-now ab-dr-now\">H⁺: 예상 선을 손가락으로 그리자</p>\n        </div>\n        <div class=\"ab-tray\">\n          <span class=\"ab-seg ab-dr-tab\" role=\"group\" aria-label=\"그릴 입자\">\n            <button type=\"button\" data-k=\"H\" aria-pressed=\"true\">H<sup>+</sup></button><button type=\"button\" data-k=\"Cl\" aria-pressed=\"false\">Cl<sup>−</sup></button><button type=\"button\" data-k=\"Na\" aria-pressed=\"false\">Na<sup>+</sup></button><button type=\"button\" data-k=\"OH\" aria-pressed=\"false\">OH<sup>−</sup></button><button type=\"button\" data-k=\"I\" aria-pressed=\"false\">전체 이온</button><button type=\"button\" data-k=\"W\" aria-pressed=\"false\">물 분자</button>\n          </span>\n          <span class=\"ab-end\"><button type=\"button\" class=\"btn ab-dr-clear\">지우기</button><button type=\"button\" class=\"btn play ab-dr-go\">넣어 보며 맞추기</button></span>\n        </div>\n      </div>\n      <div class=\"panel ab-panel\">\n        <ol class=\"u-steps\"><li data-edit=\"li-1\" data-s=\"1\"><b>①</b> 입자를 골라 예상 선을 그린다</li><li data-edit=\"li-2\" data-s=\"2\"><b>②</b> «넣어 보며 맞추기»로 확인한다</li><li data-edit=\"li-3\" data-s=\"3\"><b>③</b> 네 가지 입자를 맞춰 본다</li></ol>\n        <p class=\"ab-msg ab-dr-msg\" aria-live=\"polite\"></p>\n        <div class=\"ab-dr-legend\"><span><i class=\"mine\"></i>내가 그린 선</span><span><i class=\"real\"></i>모형으로 넣어 본 선</span></div>\n        <div class=\"def soft ref fragment custom\" data-anim=\"abrow\" data-fragment-index=\"0\"><p data-edit=\"p-1\">앞 장 영상의 그래프와 맞춰 보자 — 선이 꺾이는 곳이 <b>중화점</b>.</p></div>\n        <div class=\"u-learn\"><b>알게 된 것</b><p data-edit=\"p-2\">H<sup>+</sup>이 0이 되고 OH<sup>−</sup>이 늘기 시작하는 곳, 물 분자 수가 더 늘지 않는 곳이 <b>중화점</b>이다.</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 52쪽</b><span>염산 속 H⁺ 10개는 이해를 돕기 위한 예</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-2-2.4.draw */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const ev = (root, mod, sel, map) => { root._mod = mod; window.ABWatch(root, sel, map); return mod; };\n  part('tongsci2-1-2-2-4-draw', (root) => ev(root, window.ABDraw.mount(root), '.ab-dr-now', (t) => (t.includes('예상 선') ? 1 : t.startsWith('다른') ? 3 : null)));\n})();\n","needs":["abdraw"],"media":{}}