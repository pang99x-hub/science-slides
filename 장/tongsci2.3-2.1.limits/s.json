{"id":"tongsci2.3-2.1.limits","unit":"tongsci2.3-2","html":"<!-- 6. 이론: 유용성과 한계(사진) -->\n<section id=\"tongsci2-3-2-1-limits\" data-state=\"limits\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 148~149쪽 · 과학기술의 유용성과 한계</div>\n        <h2 data-edit=\"h2\">쓸모와 새 문제, 함께 온다</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">좋아지기만 할까?</p>\n    </div>\n    <div class=\"t-body t-hist t-lvl\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def lv-row\" data-k=\"good\"><span data-edit=\"t-tag-1\" class=\"t-tag\">유용성</span><p data-edit=\"p-1\">사람의 삶과 환경을 <b>더 낫게</b> 바꾸는 과학기술의 쓸모</p><p data-edit=\"t-sub-1\" class=\"t-sub\">환경 · 의료 · 교통 · 우주 · 교육에서</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"bad\"><span data-edit=\"t-tag-2\" class=\"t-tag\">한계</span><p data-edit=\"p-2\">기술이 발전하면서 함께 생기는 <b>새 문제</b></p><p data-edit=\"t-sub-2\" class=\"t-sub\">틀린 결과·일자리 · 개인 정보·해킹 · 디지털 격차 · 폐기물 · 생명 윤리</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"two\"><span data-edit=\"t-tag-3\" class=\"t-tag\">양면성</span><p data-edit=\"p-3\">쓸모와 문제를 <b>함께</b> 지닌 과학기술의 성질</p><p data-edit=\"t-sub-3\" class=\"t-sub\">한계를 알고 현명하게 쓰기 · 법·규제·<b>윤리</b>로 함께 살피기 · 새 일자리 찾기</p></div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs\" role=\"group\" aria-label=\"사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"good\" data-name=\"핵융합 연구 장치 KSTAR\" data-chip=\"유용성 · 환경\" data-kind=\"k-good\" data-d=\"태양처럼 가벼운 원자핵을 합쳐 에너지를 얻으려는 우리나라 연구 장치. 성공하면 온실 기체 걱정이 적은 전기를 얻는다.\" data-cr=\"Michel Maccagnan · CC BY-SA 3.0\"><img src=\"@@P_KSTAR@@\" alt=\"태극기가 걸린 큰 실험실 가운데 놓인 둥근 금속 원통 장치\"><span>핵융합</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"good\" data-name=\"화성 탐사 로봇\" data-chip=\"유용성 · 우주\" data-kind=\"k-good\" data-d=\"사람이 갈 수 없는 화성에서 바위를 살피고 시료를 모은다. 로봇이 우주 탐사와 자원 찾기를 맡는다.\" data-cr=\"NASA/JPL-Caltech/MSSS · 퍼블릭 도메인\"><img src=\"@@P_MARS@@\" alt=\"붉은 화성 땅 위에 선 여섯 바퀴 탐사 로봇\"><span>우주 탐사</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"good\" data-name=\"가상 현실로 하는 수업\" data-chip=\"유용성 · 교육\" data-kind=\"k-good\" data-d=\"머리에 쓰는 화면으로 갈 수 없는 곳을 둘러보며 배운다. 인공지능과 함께 한 사람 한 사람에게 맞춘 수업도 가능해진다.\" data-cr=\"Shixart1985 · CC BY 2.0\"><img src=\"@@P_VR@@\" alt=\"교실에서 가상 현실 안경을 손에 든 학생\"><span>가상 현실</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"bad\" data-name=\"개인 정보가 모이는 데이터 센터\" data-chip=\"한계 · 정보\" data-kind=\"k-bad\" data-d=\"편리한 서비스 뒤에는 내 정보가 쌓인 서버가 있다. 함부로 쓰이거나 <b>해킹</b>으로 새면 피해가 크다.\" data-cr=\"BalticServers.com · CC BY-SA 3.0\"><img src=\"@@P_DATA@@\" alt=\"파란 불빛이 켜진 서버 장치가 빽빽하게 늘어선 데이터 센터\"><span>개인 정보</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"bad\" data-name=\"새 기기가 낯선 사람들\" data-chip=\"한계 · 부적응\" data-kind=\"k-bad\" data-d=\"키오스크·앱에 서툰 사람은 서비스에서 밀려난다(<b>디지털 격차</b>). 기술에 너무 기대면 스스로 하는 힘이 약해지기도 한다.\" data-cr=\"Shixart1985 · CC BY 2.0\"><img src=\"@@P_ELDER@@\" alt=\"창가에 서서 휴대 전화 화면을 바라보는 어른\"><span>디지털 격차</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"bad\" data-name=\"버려진 전자 기기\" data-chip=\"한계 · 환경\" data-kind=\"k-bad\" data-d=\"기기를 자주 바꿀수록 버려지는 전자 <b>폐기물</b>이 쌓인다. 함부로 뜯으면 해로운 물질이 땅과 물로 스민다.\" data-cr=\"Scotted400 · CC0\"><img src=\"@@P_EWASTE@@\" alt=\"모니터 틀과 금속 조각이 수북이 쌓인 전자 폐기물 더미\"><span>전자 폐기물</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 148~149쪽</b><span>사진: 위키미디어 공용(사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.3-2.1.limits */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  const { track, join, txt, pressed } = window.EthTrack;\n\n  // 1. 표지: 3D 네발 로봇 + 예측(한 번 넘기면 답 표시, 사건은 확인 장에서 푼다)\n  part('tongsci2-3-2-1-limits', window.EthTrack.theory);\n\n  // 7. 체험: 좋아지는 만큼 생기는 문제 — ① 발전 막대 ② 장소 ③ 대비 막대\n})();\n","needs":[],"media":{"P_KSTAR":"p-kstar.webp","P_MARS":"p-mars.webp","P_VR":"p-vr.webp","P_DATA":"p-data.webp","P_ELDER":"p-elder.webp","P_EWASTE":"p-ewaste.webp"}}