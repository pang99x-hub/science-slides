{"id":"tongsci1.3-3-3.1.sum4","unit":"tongsci1.3-3-3","html":"<!-- 5. 정리 -->\n<section id=\"tongsci1-3-3-3-1-sum4\" data-state=\"sum4\" class=\"std l1t t-sumsec\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">정리 · 교과서 154~155쪽</div>\n        <h2 data-edit=\"h2\">유전자와 단백질 한눈에 보기</h2>\n      </div>\n    </div>\n    <div class=\"t-body t-sum\">\n      <div class=\"sbox\"><h3><span class=\"sn\">1</span>유전자</h3><p data-edit=\"p-1\">유전정보가 담긴 DNA의 <b>특정 부위</b></p><p data-edit=\"sx-1\" class=\"sx\">DNA 한 분자에 유전자가 여럿</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">2</span>단백질</h3><p data-edit=\"p-2\">유전자의 정보로 <b>단백질</b>이 만들어진다</p><p data-edit=\"sx-2\" class=\"sx\">효소도 인슐린도 단백질</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">3</span>형질</h3><p data-edit=\"p-3\">단백질이 작용해 <b>형질</b>이 나타난다</p><p data-edit=\"sx-3\" class=\"sx\">꽃 색 · 털색</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">4</span>꽃 색의 예</h3><p data-edit=\"p-4\">효소 유전자 → 효소 → <b>붉은 색소</b> → 붉은 꽃</p><p data-edit=\"sx-4\" class=\"sx\">155쪽 해 보기</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">5</span>유전자 이상</h3><p data-edit=\"p-5\">염기 하나가 바뀌어도 단백질이 <b>달라진다</b></p><p data-edit=\"sx-5\" class=\"sx\">낫 모양 적혈구 빈혈증</p></div>\n      <div class=\"sbox\"><h3><span class=\"sn\">6</span>남은 질문</h3><p data-edit=\"p-6\">DNA는 핵 안, 단백질은 <b>라이보솜</b>에서</p><p data-edit=\"sx-6\" class=\"sx\">정보는 어떻게 전해질까? — 다음 차시</p></div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 154~155쪽</b><span>카드를 누르면 뒤집힌다</span></div>\n</section>","css":"\n","js":"/* tongsci1.3-3-3.1.sum4 */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const J = (m, root) => window.EthTrack.join(m, window.L1.frame(root));\n  part('tongsci1-3-3-3-1-sum4', (root) => window.RxT.sum(root));\n})();\n","needs":[],"media":{}}