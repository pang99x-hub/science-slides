{"id":"tongsci2.1-1-1.4.hyp","unit":"tongsci2.1-1-1","html":"<!-- 3. 설명: 대멸종의 원인 가설 셋 -->\n<section id=\"tongsci2-1-1-1-4-hyp\" data-state=\"hyp\" class=\"std l1t\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">설명 · 교과서 18쪽 탐구 · 대멸종 원인 가설</div>\n        <h2 data-edit=\"h2\">대멸종의 원인 가설 셋</h2>\n      </div>\n      <div class=\"seg hy-tabs\" role=\"group\" aria-label=\"가설 고르기\">\n        <button type=\"button\" data-h=\"rock\" aria-pressed=\"true\">운석(소행성) 충돌설</button>\n        <button type=\"button\" data-h=\"volc\" aria-pressed=\"false\">화산 폭발설</button>\n        <button type=\"button\" data-h=\"land\" aria-pressed=\"false\">수륙 분포 변화설</button>\n      </div>\n    </div>\n    <div class=\"hy-panes\">\n      <div class=\"t-body t-steps hy-pane\" data-h=\"rock\">\n        <div class=\"st-fig\" data-out=\".hy-pane[data-h='rock']\">\n          <div class=\"st-stage\">\n            <img class=\"st-im\" src=\"@@HY_ROCK_1@@\" alt=\"큰 운석이 불꼬리를 끌며 공룡과 나무가 있는 땅으로 떨어지는 그림\">\n            <img class=\"st-im\" src=\"@@HY_ROCK_2@@\" alt=\"검은 먼지구름이 하늘을 덮어 해가 흐려지고 해안에 큰 해일이 덮치는 그림\">\n            <img class=\"st-im\" src=\"@@HY_ROCK_3@@\" alt=\"나무가 시들고 공룡과 암모나이트에 빨간 가위표가 쳐진 그림\">\n          </div>\n          <div class=\"fm-ctl st-ctl\"><span>시간</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"2\" step=\"0.01\" value=\"0\" aria-label=\"운석 충돌설의 단계: 오른쪽으로 끌면 원인에서 결과로 넘어간다\"><span>→</span></div>\n          <div class=\"fm-pills st-pills hy-pills\" role=\"group\" aria-label=\"단계 고르기\">\n            <button type=\"button\" data-n=\"큰 운석이 떨어진다\" data-d=\"지름 수 km(이해를 돕기 위한 예)의 운석(소행성)이 지구에 부딪친다.\">① 충돌</button>\n            <button type=\"button\" data-n=\"햇빛이 가려지고 해일이 인다\" data-d=\"충돌로 솟은 <b>먼지</b>가 하늘을 덮어 <b>햇빛을 가린다</b>. 바닷가에는 큰 <b>해일</b>이 덮친다.\">② 먼지·해일</button>\n            <button type=\"button\" data-n=\"먹이 사슬이 끊긴다\" data-d=\"기온이 떨어지고 광합성이 줄어 식물이 시든다. 먹이가 끊겨 <b>공룡·암모나이트</b> 등이 사라진다(중생대 말).\">③ 멸종</button>\n          </div>\n        </div>\n        <div class=\"t-col\">\n          <div class=\"tcard st-now\"><span data-edit=\"t-tag-1\" class=\"t-tag st-tag\">1단계 / 3</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n          <div class=\"tcard hy-ev\"><span data-edit=\"t-tag-2\" class=\"t-tag\">증거 · 중생대 말</span>\n            <div class=\"hy-ph\"><figure><img src=\"@@EX_KPG@@\" alt=\"절벽의 두 지층 사이에 낀 얇은 점토층을 손가락으로 가리키는 사진\"><figcaption data-edit=\"figcaption-1\">중생대·신생대 경계의 얇은 층 — <b>이리듐</b>이 많다<small class=\"cr\">Wilson44691 · CC0</small></figcaption></figure>\n              <figure><img src=\"@@EX_CHICX@@\" alt=\"멕시코 유카탄반도 땅속을 중력으로 측정해 색으로 나타낸 그림, 둥근 고리 모양이 보인다\"><figcaption data-edit=\"figcaption-2\">멕시코 땅속의 <b>큰 운석 구덩이</b>(중력 측정)<small class=\"cr\">NASA · 퍼블릭 도메인</small></figcaption></figure></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"t-body t-steps hy-pane\" data-h=\"volc\" hidden>\n        <div class=\"st-fig\" data-out=\".hy-pane[data-h='volc']\">\n          <div class=\"st-stage\">\n            <img class=\"st-im\" src=\"@@HY_VOLC_1@@\" alt=\"화산 여러 개가 연기를 뿜고 붉은 용암이 땅을 겹겹이 덮는 그림\">\n            <img class=\"st-im\" src=\"@@HY_VOLC_2@@\" alt=\"화산 가스 구름에서 산성비가 내리고 온도계가 높이 오른 그림\">\n            <img class=\"st-im\" src=\"@@HY_VOLC_3@@\" alt=\"바다 밑 삼엽충에 빨간 가위표가 쳐지고 나무가 말라 죽은 그림\">\n          </div>\n          <div class=\"fm-ctl st-ctl\"><span>시간</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"2\" step=\"0.01\" value=\"0\" aria-label=\"화산 폭발설의 단계\"><span>→</span></div>\n          <div class=\"fm-pills st-pills hy-pills\" role=\"group\" aria-label=\"단계 고르기\">\n            <button type=\"button\" data-n=\"큰 화산 활동이 이어진다\" data-d=\"땅 틈에서 용암이 오랫동안 흘러나와 넓은 땅을 겹겹이 덮는다.\">① 화산</button>\n            <button type=\"button\" data-n=\"산성비와 온난화\" data-d=\"많은 <b>화산 가스</b>가 나와 <b>산성비</b>가 내리고 온실 효과로 <b>지구가 더워진다</b>. 특히 바닷물 온도가 크게 오른다.\">② 가스</button>\n            <button type=\"button\" data-n=\"바다 생물이 사라진다\" data-d=\"뜨거워진 바다에서 견디지 못한 생물이 사라진다. 고생대 말에는 <b>삼엽충</b>을 비롯한 바다 생물 대부분이 사라졌다.\">③ 멸종</button>\n          </div>\n        </div>\n        <div class=\"t-col\">\n          <div class=\"tcard st-now\"><span data-edit=\"t-tag-3\" class=\"t-tag st-tag\">1단계 / 3</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n          <div class=\"tcard hy-ev\"><span data-edit=\"t-tag-4\" class=\"t-tag\">증거 · 고생대 말</span>\n            <div class=\"hy-ph one\"><figure><img src=\"@@EX_TRAP@@\" alt=\"높은 하늘에서 내려다본 넓고 평평한 계단 모양 대지, 가장자리가 가파른 절벽\"><figcaption data-edit=\"figcaption-3\">시베리아의 넓은 <b>용암층</b>(계단 모양 대지) — 약 <b>100만 년</b>에 걸친 화산 활동으로 본다<small class=\"cr\">jxandreani · CC BY 2.0</small></figcaption></figure></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"t-body t-steps hy-pane\" data-h=\"land\" hidden>\n        <div class=\"st-fig\" data-out=\".hy-pane[data-h='land']\">\n          <div class=\"st-stage\">\n            <img class=\"st-im\" src=\"@@HY_LAND_1@@\" alt=\"위에서 본 바다에 대륙 다섯이 흩어져 있고 둘레에 하늘색 얕은 바다가 넓은 그림\">\n            <img class=\"st-im\" src=\"@@HY_LAND_2@@\" alt=\"대륙이 한 덩어리로 모이고 얕은 바다가 줄었으며 안쪽은 메마른 땅인 그림\">\n            <img class=\"st-im\" src=\"@@HY_LAND_3@@\" alt=\"한 덩어리 대륙 바깥의 바다 생물에 빨간 가위표가 쳐진 그림\">\n          </div>\n          <div class=\"fm-ctl st-ctl\"><span>시간</span><input type=\"range\" class=\"st-range\" min=\"0\" max=\"2\" step=\"0.01\" value=\"0\" aria-label=\"수륙 분포 변화설의 단계\"><span>→</span></div>\n          <div class=\"fm-pills st-pills hy-pills\" role=\"group\" aria-label=\"단계 고르기\">\n            <button type=\"button\" data-n=\"흩어진 대륙\" data-d=\"대륙이 흩어져 있으면 해안선이 길고 둘레의 <b>얕은 바다</b>가 넓어 바다 생물이 많이 산다.\">① 흩어짐</button>\n            <button type=\"button\" data-n=\"초대륙이 생긴다\" data-d=\"대륙이 모여 <b>초대륙</b>이 되면 얕은 바다가 줄고, <b>해류</b>와 기후가 바뀐다. 안쪽은 메마른다.\">② 모임</button>\n            <button type=\"button\" data-n=\"서식지가 줄어든다\" data-d=\"살 곳이 줄고 환경이 바뀌어 많은 바다 생물이 사라진다. 갈라질 때도 해안과 해류가 바뀌어 서식지가 바뀐다.\">③ 멸종</button>\n          </div>\n        </div>\n        <div class=\"t-col\">\n          <div class=\"tcard st-now\"><span data-edit=\"t-tag-5\" class=\"t-tag st-tag\">1단계 / 3</span><h3 class=\"st-name\"></h3><p class=\"st-d\"></p></div>\n          <div class=\"tcard hy-ev\"><span data-edit=\"t-tag-6\" class=\"t-tag\">증거 · 고생대 말</span>\n            <div class=\"hy-ph one map\"><figure><img src=\"@@MAP_PZ@@\" alt=\"대륙이 한 덩어리로 모인 판게아 지구 그림\"><figcaption data-edit=\"figcaption-4\">고생대 말 대륙이 모인 <b>판게아</b>(3차시 3D 지구) — 같은 무렵 얕은 바다 생물이 크게 줄었다</figcaption></figure></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"tcard hy-sum fragment custom\" data-anim=\"mrow\" data-fragment-index=\"0\">\n      <table>\n        <colgroup><col class=\"c1\"><col class=\"c2\"><col class=\"c3\"></colgroup>\n        <thead><tr><th data-edit=\"th-1\">가설</th><th data-edit=\"th-2\">어떻게 멸종을 일으켰나</th><th data-edit=\"th-3\">증거</th></tr></thead>\n        <tbody>\n          <tr><th data-edit=\"th-4\">운석(소행성) 충돌설</th><td data-edit=\"td-1\">먼지가 <b>햇빛을 가림</b> · 해일<br>→ 추위, 먹이 사슬 붕괴</td><td data-edit=\"td-2\">중생대 말: 경계 지층의 <b>이리듐</b>,<br>멕시코의 <b>운석 구덩이</b></td></tr>\n          <tr><th data-edit=\"th-5\">화산 폭발설</th><td data-edit=\"td-3\">화산 가스 → <b>산성비</b> · <b>온난화</b><br>· 바닷물 온도 상승</td><td data-edit=\"td-4\">고생대 말: <b>시베리아</b>의 대규모 용암층<br>(약 100만 년 동안 분출)</td></tr>\n          <tr><th data-edit=\"th-6\">수륙 분포 변화설</th><td data-edit=\"td-5\">초대륙이 생기거나 갈라져<br>해안·<b>해류</b>·서식지가 바뀜</td><td data-edit=\"td-6\">고생대 말: <b>판게아</b> 형성</td></tr>\n        </tbody>\n      </table>\n      <div class=\"hy-crit\"><b>가설을 따져 보는 기준</b>\n        <span><i>①</i> 그 일이 정말 많은 생물을 사라지게 할 만한가?</span>\n        <span><i>②</i> 믿을 만한 과학적 증거가 정확하게 있는가?</span>\n        <span><i>③</i> 그때 지구 환경이 어떻게 바뀌었는지 설명하는가?</span>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 18쪽 탐구</b><span>그림 속 크기·개수는 이해를 돕기 위한 예 · 사진: 위키미디어 공용</span></div>\n</section>","css":"\n","js":"/* tongsci2.1-1-1.4.hyp */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  part('tongsci2-1-1-1-4-hyp', (root) => {\n    const tabs = [...root.querySelectorAll('.hy-tabs button')], panes = [...root.querySelectorAll('.hy-pane')];\n    panes.forEach((p) => window.T2.steps(root, `.hy-pane[data-h=\"${p.dataset.h}\"] .st-fig`));\n    const show = (h) => { tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.h === h))); panes.forEach((p) => { p.hidden = p.dataset.h !== h; }); };\n    tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.h)));\n    root._hy = { show, step: (h, k) => { show(h); root._sts[`.hy-pane[data-h=\"${h}\"] .st-fig`].set(k); } };\n    const sum = (on) => root.classList.toggle('hy-summing', on);\n    return {\n      fragment(f, on) { if (f.dataset.anim === 'mrow') sum(on); },\n      sync(slide) { const f = slide.querySelector('.hy-sum'); sum(!!f && f.classList.contains('visible')); },\n    };\n  });\n  // 4. 체험: 증거 카드 → ①카드 하나 ②기준 셋 ③다른 시기도\n})();\n","needs":["teach2","eralens"],"media":{"HY_ROCK_1":"hy-rock-1.webp","HY_ROCK_2":"hy-rock-2.webp","HY_ROCK_3":"hy-rock-3.webp","EX_KPG":"ex-kpg.webp","EX_CHICX":"ex-chicx.webp","HY_VOLC_1":"hy-volc-1.webp","HY_VOLC_2":"hy-volc-2.webp","HY_VOLC_3":"hy-volc-3.webp","EX_TRAP":"ex-trap.webp","HY_LAND_1":"hy-land-1.webp","HY_LAND_2":"hy-land-2.webp","HY_LAND_3":"hy-land-3.webp","MAP_PZ":"map-pz.webp"}}