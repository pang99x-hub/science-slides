{"id":"tongsci2.2-1-1.1.lvl","unit":"tongsci2.2-1-1","html":"<!-- 2. 이론: 개체에서 생태계까지(사진) -->\n<section id=\"tongsci2-2-1-1-1-lvl\" data-state=\"lvl\" class=\"std l1t\" data-word=\"우리 동네에서 찾은 개체군 하나\">\n  <div class=\"sheet\"></div>\n  <div class=\"frame\">\n    <div class=\"head split\">\n      <div class=\"titles\">\n        <div data-edit=\"eyebrow\" class=\"eyebrow\">이론 · 교과서 72쪽 그림 Ⅱ-1 · 개체, 개체군, 군집의 관계</div>\n        <h2 data-edit=\"h2\">개체에서 생태계까지</h2>\n      </div>\n      <p data-edit=\"pen\" class=\"pen\">한 마리에서 지구까지, 어떻게 묶을까?</p>\n    </div>\n    <div class=\"t-body t-hist t-lvl\">\n      <div class=\"t-col\">\n        <div class=\"tcard th-def lv-row\" data-k=\"pop\"><span data-edit=\"t-tag-1\" class=\"t-tag\">개체군</span><p data-edit=\"p-1\">한 지역에 함께 사는 <b>같은 종</b> 개체들의 무리</p><p data-edit=\"t-sub\" class=\"t-sub\">개체 = 생물 한 마리(한 그루)</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"com\"><span data-edit=\"t-tag-2\" class=\"t-tag\">군집</span><p data-edit=\"p-2\">한 지역에 사는 <b>모든 개체군</b>을 합친 것 — 여러 종</p></div>\n        <div class=\"tcard th-def lv-row\" data-k=\"eco\"><span data-edit=\"t-tag-3\" class=\"t-tag\">생태계</span><p data-edit=\"p-3\">군집의 생물이 <b>둘레 환경</b>과 영향을 주고받으며 이루는 하나의 체계</p></div>\n        <div class=\"tcard lv-nest\">\n          <svg viewBox=\"0 0 560 150\" role=\"img\" aria-label=\"안에서 밖으로 개체, 개체군, 군집, 생태계 순서로 감싸는 동그라미 넷\">\n            <ellipse cx=\"280\" cy=\"78\" rx=\"272\" ry=\"70\" class=\"nest n4\"/><ellipse cx=\"236\" cy=\"80\" rx=\"190\" ry=\"54\" class=\"nest n3\"/>\n            <ellipse cx=\"190\" cy=\"82\" rx=\"114\" ry=\"38\" class=\"nest n2\"/><ellipse cx=\"148\" cy=\"84\" rx=\"46\" ry=\"22\" class=\"nest n1\"/>\n            <text x=\"148\" y=\"92\">개체</text><text x=\"250\" y=\"92\">개체군</text><text x=\"368\" y=\"92\">군집</text><text x=\"490\" y=\"92\">생태계</text>\n          </svg>\n        </div>\n      </div>\n      <div class=\"gv\" data-prevent-swipe>\n        <figure class=\"gv-big\">\n          <img class=\"gv-img\" alt=\"\">\n          <figcaption><div class=\"gv-h\"><b class=\"gv-name\"></b><span class=\"chip gv-kind\"></span></div><p class=\"gv-d\" aria-live=\"polite\"></p><small class=\"cr gv-cr\"></small></figcaption>\n        </figure>\n        <div class=\"gv-thumbs g6\" role=\"group\" aria-label=\"사진 고르기: 누르면 위에 크게 보인다\">\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"pop\" data-name=\"고라니 한 마리\" data-chip=\"개체\" data-kind=\"k-ind\" data-d=\"스스로 먹고 숨 쉬며 살아가는 생물 하나가 <b>개체</b>다.\" data-cr=\"Kim, Hyun-tae · CC BY 4.0\"><img src=\"@@ECO_IND@@\" alt=\"마른 풀밭에 서 있는 고라니 한 마리\"><span>개체</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"pop\" data-name=\"흰기러기 떼\" data-chip=\"개체군\" data-kind=\"k-pop\" data-d=\"한곳에 모인 같은 종의 무리 — 모두 흰기러기이므로 <b>개체군</b> 하나다.\" data-cr=\"Mike Boylan(미국 어류·야생동물국) · 퍼블릭 도메인\"><img src=\"@@ECO_POP@@\" alt=\"물가에 빽빽이 모인 흰기러기 떼\"><span>개체군</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"com\" data-name=\"물웅덩이의 얼룩말과 가젤\" data-chip=\"군집\" data-kind=\"k-com\" data-d=\"얼룩말 무리, 가젤 무리, 풀… 종이 다른 개체군 여럿이 한곳에 → <b>군집</b>.\" data-cr=\"Alastair Rae · CC BY-SA 2.0\"><img src=\"@@ECO_COM@@\" alt=\"물웅덩이에서 함께 물을 마시는 얼룩말과 가젤\"><span>군집</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"eco\" data-name=\"작은 연못\" data-chip=\"생태계\" data-kind=\"k-eco\" data-d=\"수련과 물새가 사는 작은 연못도 생물과 물·흙·빛이 이어진 <b>생태계</b>다.\" data-cr=\"Toby Hudson · CC BY-SA 3.0\"><img src=\"@@ECO_POND@@\" alt=\"수련 잎 사이를 헤엄치는 물새가 있는 작은 연못\"><span>작은 연못</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"eco\" data-name=\"경남 창녕 우포늪\" data-chip=\"생태계\" data-kind=\"k-eco\" data-d=\"우리나라에서 가장 큰 내륙 습지. 물풀·새·물고기와 물·흙이 함께 이룬 큰 <b>생태계</b>다.\" data-cr=\"Seong Gyu Eok Men · CC BY-SA 3.0\"><img src=\"@@ECO_WET@@\" alt=\"나무가 물에 비치는 넓은 우포늪\"><span>우포늪</span></button>\n          <button type=\"button\" aria-pressed=\"false\" data-row=\"eco\" data-name=\"지구 전체\" data-chip=\"생태계\" data-kind=\"k-eco\" data-d=\"가장 큰 생태계는 지구 전체다. 생태계의 크기는 연못부터 지구까지 여러 가지다.\" data-cr=\"NASA · 퍼블릭 도메인\"><img src=\"@@ECO_EARTH@@\" alt=\"우주에서 본 푸른 지구\"><span>지구</span></button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\"><b>교과서 72쪽 그림 Ⅱ-1</b><span>사진: 위키미디어 공용(사진 아래에 작성자와 라이선스)</span></div>\n</section>","css":"\n","js":"/* tongsci2.2-1-1.1.lvl */\n(function () {\n  'use strict';\n  const { part } = window.Deck;\n  const L1 = window.L1;\n  const single = (btns) => btns.forEach((b) => b.addEventListener('click', () => {\n    const on = b.getAttribute('aria-pressed') !== 'true';\n    btns.forEach((x) => x.setAttribute('aria-pressed', String(on && x === b)));\n  }));\n  // 체험 장 해 볼 일: 지금 단계 번호(0 = 끝)\n  const mark = (root, n, max = 3) => { const ok = []; for (let k = 1; k <= max; k++) if (n === 0 || k < n) ok.push(k); L1.steps(root, n, ok); L1.done(root, n === 0); };\n  window.EcoMark = mark;\n  // 1. 표지: 두 밭 타임랩스 + 예측(답은 확인 장의 «사건 파일 1 풀기»에서)\n  part('tongsci2-2-1-1-1-lvl', (root) => {\n    const rows = [...root.querySelectorAll('.lv-row')];\n    root.querySelector('.gv').addEventListener('gv-pick', (e) => rows.forEach((x) => x.classList.toggle('on', x.dataset.k === e.detail.b.dataset.row)));\n    return window.RxT.gallery(root);\n  });\n\n  // 3. 체험: 고리 넓히기 — ① 개체군에서 멈춤 ② 군집 ③ 생태계\n})();\n","needs":[],"media":{"ECO_IND":"eco-ind.webp","ECO_POP":"eco-pop.webp","ECO_COM":"eco-com.webp","ECO_POND":"eco-pond.webp","ECO_WET":"eco-wet.webp","ECO_EARTH":"eco-earth.webp"}}